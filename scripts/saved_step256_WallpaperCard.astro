---
import type { Wallpaper } from '../data/wallpapers';

interface Props {
  wallpaper: Wallpaper;
  priority?: boolean;
}

const { wallpaper, priority = false } = Astro.props;
---

<div
  class="group relative rounded-2xl overflow-hidden bg-obsidian-850 border border-white/5 hover:border-neon-lime/40 transition-all duration-300 hover:shadow-glow-lime hover:-translate-y-1 flex flex-col wallpaper-card"
  data-title={wallpaper.title.toLowerCase()}
  data-category={wallpaper.category?.toLowerCase() || ''}
  data-tags={(wallpaper.tags || []).join(' ').toLowerCase()}
>
  <!-- Card Image Container -->
  <a
    href={`/wallpapers/${wallpaper.slug}`}
    class="relative aspect-[16/10] sm:aspect-[16/9] w-full overflow-hidden block bg-obsidian-900"
  >
    <!-- Shimmer Skeleton -->
    <div class="absolute inset-0 shimmer-bg -z-0"></div>

    <!-- Image with no-referrer for bypassing hotlink restrictions -->
    <img
      src={wallpaper.sourceCdn}
      alt={wallpaper.title}
      loading={priority ? 'eager' : 'lazy'}
      decoding="async"
      referrerpolicy="no-referrer"
      class="w-full h-full object-cover transform transition-transform duration-500 ease-out group-hover:scale-105 relative z-10"
      onload="this.previousElementSibling?.remove()"
      onerror="this.src='https://images.unsplash.com/photo-1618005182384-a83a8bd57fbe?w=800&q=80'"
    />

    <!-- Top Overlay Badges -->
    <div class="absolute top-3 left-3 right-3 flex items-center justify-between z-20 pointer-events-none">
      <!-- Resolution Pill -->
      <span class="px-2.5 py-1 rounded-full bg-obsidian-950/80 backdrop-blur-md border border-white/10 text-[11px] font-bold text-neon-lime tracking-wide">
        {wallpaper.resolution || '4K UHD'}
      </span>

      <!-- Aspect Ratio Badge -->
      <span class="px-2 py-0.5 rounded-full bg-black/60 backdrop-blur-md text-[10px] font-mono text-gray-300">
        {wallpaper.aspectRatio || '16:9'}
      </span>
    </div>

    <!-- Hover Gradient Overlay -->
    <div class="absolute inset-0 bg-gradient-to-t from-obsidian-950 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300 z-15"></div>
  </a>

  <!-- Card Details / Actions -->
  <div class="p-4 flex flex-col justify-between flex-grow gap-3 z-20">
    <div class="flex items-start justify-between gap-2">
      <a href={`/wallpapers/${wallpaper.slug}`} class="group-hover:text-neon-lime transition-colors">
        <h3 class="text-sm font-semibold text-white line-clamp-1">
          {wallpaper.title}
        </h3>
        <p class="text-xs text-gray-400 line-clamp-1 mt-0.5">
          {wallpaper.category || '4K Wallpapers'}
        </p>
      </a>

      <!-- Color Dot Indicator -->
      {wallpaper.colorHex && (
        <span
          class="w-3.5 h-3.5 rounded-full shrink-0 border border-white/20 shadow-sm mt-1"
          style={`background-color: ${wallpaper.colorHex};`}
          title={`Color tone: ${wallpaper.colorName}`}
        ></span>
      )}
    </div>

    <!-- Quick Action Bar -->
    <div class="flex items-center justify-between pt-2 border-t border-white/5 text-xs">
      <div class="flex items-center gap-3 text-gray-400 text-[11px]">
        <span class="flex items-center gap-1">
          <svg class="w-3.5 h-3.5 text-gray-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
          </svg>
          {wallpaper.views?.toLocaleString() || '1.2k'}
        </span>
        <span class="flex items-center gap-1">
          <svg class="w-3.5 h-3.5 text-gray-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
          </svg>
          {wallpaper.downloads?.toLocaleString() || '450'}
        </span>
      </div>

      <!-- Direct Download / Crop Button -->
      <a
        href={`/wallpapers/${wallpaper.slug}`}
        class="flex items-center gap-1.5 px-3 py-1 rounded-lg bg-white/5 hover:bg-neon-lime hover:text-obsidian-950 text-gray-300 font-semibold text-[11px] transition-all"
      >
        <span>Download</span>
        <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
        </svg>
      </a>
    </div>
  </div>
</div>
