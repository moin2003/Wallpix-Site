---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import ColorPaletteFilter from '../components/ColorPaletteFilter.astro';
import WallpaperGrid from '../components/WallpaperGrid.astro';
import AdSenseSlot from '../components/AdSenseSlot.astro';
import Footer from '../components/Footer.astro';
import { wallpapers } from '../data/wallpapers';

const schema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'Lumina 4K Wallpapers',
  url: 'https://lumina-wallpapers.com',
  description: 'Download free ultra HD 4K, 2K and AMOLED wallpapers for desktop and mobile with instant live canvas cropper.',
  potentialAction: {
    '@type': 'SearchAction',
    target: 'https://lumina-wallpapers.com/?search={search_term_string}',
    'query-input': 'required name=search_term_string',
  },
};
---

<Layout
  title="Lumina 4K - Ultra HD, AMOLED & Anime Wallpapers"
  description="Explore and download 50,000+ curated 4K UHD, AMOLED Black, Anime, and Cyberpunk wallpapers. Fast, free and customizable with instant client-side canvas crop."
  schema={schema}
>
  <Header />
  
  <main>
    <!-- Hero Banner -->
    <Hero activeCategory="all" totalWallpapers={wallpapers.length} />

    <!-- Color Explorer Chips (From User's Neon & Luxury Palettes) -->
    <ColorPaletteFilter />

    <!-- Leaderboard Ad Slot -->
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <AdSenseSlot format="leaderboard" slotId="home-leaderboard-top" />
    </div>

    <!-- Main Dynamic Wallpaper Grid -->
    <WallpaperGrid wallpapers={wallpapers} title="Trending 4K Wallpapers" />

    <!-- Interactive Canvas Cropper Promo Banner -->
    <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 my-12">
      <div class="relative rounded-3xl overflow-hidden glass-panel border border-neon-lime/30 p-8 sm:p-12 text-center bg-gradient-to-b from-obsidian-850 to-obsidian-950">
        <!-- Glow accent -->
        <div class="absolute -top-24 left-1/2 -translate-x-1/2 w-96 h-96 bg-neon-lime/15 rounded-full blur-[100px] pointer-events-none"></div>
        
        <div class="relative z-10 max-w-2xl mx-auto space-y-4">
          <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-neon-lime/10 text-neon-lime text-xs font-bold font-mono">
            ⚡ BUILT-IN TOOL
          </div>
          <h2 class="text-3xl sm:text-4xl font-display font-black text-white">
            Need a Custom Screen Size?
          </h2>
          <p class="text-gray-400 text-sm sm:text-base">
            Use our client-side Canvas Cropper to cut any wallpaper to your exact smartphone, tablet, or ultrawide monitor dimensions with zero blurriness.
          </p>
          <div class="pt-2">
            <a
              href="/tool/cropper"
              class="inline-flex items-center gap-2 px-6 py-3.5 rounded-2xl bg-neon-lime text-obsidian-950 font-display font-extrabold text-sm hover:scale-105 transition-all shadow-glow-lime"
            >
              <span>Launch Canvas Cropper</span>
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
              </svg>
            </a>
          </div>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>
