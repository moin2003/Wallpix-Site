---
---

<div class="lumina-ad p-3 sm:p-4 flex flex-col justify-between group cursor-pointer">
  
  <!-- Ad Header -->
  <div class="flex items-center justify-between text-[10px] uppercase font-mono tracking-wider text-gray-400">
    <span class="px-2 py-0.5 rounded-full bg-white/[0.06] text-gray-300 font-bold">
      ADVERTISEMENT
    </span>
    <div class="flex items-center gap-1.5 text-white font-semibold text-xs">
      <span class="w-3.5 h-3.5 rounded-full bg-[#E5004F] flex items-center justify-center text-[8px] font-bold text-white">LG</span>
      <span>LG UltraGear™</span>
      <span class="text-gray-500 text-[10px]">ⓘ</span>
    </div>
  </div>

  <!-- Ad Main Content Area -->
  <div class="grid grid-cols-12 gap-3 items-center my-auto">
    <!-- Monitor Product Visual -->
    <div class="col-span-5 relative aspect-[16/10] rounded-lg overflow-hidden bg-black/80 border border-white/10 shadow-lg flex items-center justify-center p-1">
      <img
        src="https://images.unsplash.com/photo-1527443224154-c4a3942d3acf?w=300&q=80"
        alt="LG UltraGear 4K Gaming Monitor"
        class="w-full h-full object-cover rounded"
      />
    </div>

    <!-- Copy & Specs -->
    <div class="col-span-7 space-y-1">
      <h4 class="text-[13px] sm:text-sm font-display font-bold text-white leading-tight">
        Elevate <br class="hidden sm:inline" />Your Visual World
      </h4>
      <p class="text-[10px] text-gray-400 leading-tight line-clamp-1">
        LG UltraGear 4K OLED Gaming Monitor
      </p>

      <!-- Key Specs Pill Row -->
      <div class="flex items-center gap-2 pt-1 text-[10px] font-mono text-gray-300">
        <div class="px-1.5 py-0.5 rounded bg-white/5 border border-white/10">4K UHD</div>
        <div class="px-1.5 py-0.5 rounded bg-white/5 border border-white/10">144Hz</div>
        <div class="px-1.5 py-0.5 rounded bg-white/5 border border-white/10">1ms</div>
      </div>
    </div>
  </div>

  <!-- Ad Footer CTA Button -->
  <div class="flex justify-center">
    <a
      href="https://www.google.com/search?q=LG+UltraGear+4K+Gaming+Monitor"
      target="_blank"
      rel="noopener noreferrer"
      class="lumina-cta w-full max-w-[200px] text-[11px] sm:text-xs"
    >
      <span>Learn More</span>
      <svg class="w-3.5 h-3.5 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3" />
      </svg>
    </a>
  </div>

</div>
