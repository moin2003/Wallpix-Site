---
import { CATEGORIES } from '../data/wallpapers';

interface Props {
  activeCategory?: string;
  totalWallpapers?: number;
}

const { activeCategory = 'all', totalWallpapers = 58 } = Astro.props;
---

<section class="relative pt-12 pb-8 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto overflow-hidden">
  
  <!-- Subtle Background Radial Glow -->
  <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[300px] bg-gradient-to-r from-neon-lime/10 via-neon-cyan/5 to-neon-pink/10 rounded-full blur-[100px] pointer-events-none -z-10"></div>

  <div class="text-center max-w-3xl mx-auto space-y-4">
    
    <!-- Badge -->
    <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-obsidian-800/90 border border-white/10 text-xs font-semibold backdrop-blur-md">
      <span class="w-2 h-2 rounded-full bg-neon-lime animate-ping"></span>
      <span class="text-neon-lime font-mono uppercase tracking-wider">Zero-Compression Engine</span>
      <span class="text-gray-500">•</span>
      <span class="text-gray-300">Live 4K Ultra HD</span>
    </div>

    <!-- Main Headline -->
    <h1 class="text-4xl sm:text-5xl lg:text-6xl font-display font-black tracking-tight text-white leading-tight">
      Unleash Pure <span class="bg-gradient-to-r from-neon-lime via-neon-cyan to-neon-pink bg-clip-text text-transparent">Visual Power</span> On Your Screen
    </h1>

    <!-- Subtitle -->
    <p class="text-gray-400 text-base sm:text-lg max-w-2xl mx-auto font-normal">
      High-resolution 4K & AMOLED wallpapers curated for desktop, ultrawide, iPhone, and Android. Instant live crop with zero quality loss.
    </p>

    <!-- Quick Stats -->
    <div class="flex items-center justify-center gap-6 pt-2 text-xs sm:text-sm font-medium text-gray-400">
      <div class="flex items-center gap-1.5">
        <span class="text-neon-lime font-bold">50,000+</span>
        <span>Curated Wallpapers</span>
      </div>
      <span class="text-gray-700">|</span>
      <div class="flex items-center gap-1.5">
        <span class="text-neon-cyan font-bold">100% Free</span>
        <span>High-Speed Direct</span>
      </div>
      <span class="text-gray-700">|</span>
      <div class="flex items-center gap-1.5">
        <span class="text-neon-pink font-bold">4K UHD</span>
        <span>Lossless Canvas</span>
      </div>
    </div>
  </div>

  <!-- Horizontal Scrollable Category Pills -->
  <div class="mt-8 relative">
    <div class="flex items-center gap-2.5 overflow-x-auto pb-4 pt-1 scrollbar-none no-scrollbar justify-start sm:justify-center">
      {CATEGORIES.map((cat) => {
        const isActive = activeCategory === cat.slug;
        return (
          <a
            href={cat.slug === 'all' ? '/' : `/category/${cat.slug}`}
            class={`px-4 py-2 rounded-2xl text-xs sm:text-sm font-semibold whitespace-nowrap transition-all duration-200 border flex items-center gap-2 ${
              isActive
                ? 'bg-neon-lime text-obsidian-950 border-neon-lime shadow-glow-lime scale-105 font-bold'
                : 'glass-pill text-gray-300 hover:text-white border-white/10 hover:border-neon-lime/40'
            }`}
          >
            {cat.name}
          </a>
        );
      })}
    </div>
  </div>
</section>
