---
interface Props {
  currentCategory?: string;
}

const { currentCategory = 'all' } = Astro.props;

const isWallpapers = currentCategory === 'wallpapers' || Astro.url.pathname.includes('/wallpapers');
const isHome = !isWallpapers && (currentCategory === 'all' || Astro.url.pathname === '/');

const navLinks = [
  { name: 'Home', href: '/', active: isHome },
  { name: 'Wallpapers', href: '/wallpapers', active: isWallpapers },
  { name: 'Categories', href: '/#categories', active: false },
  { name: 'Collections', href: '/#color-explorer', active: false },
  { name: 'Community', href: '/tool/cropper', active: false },
];
---

<div class="w-full pt-2 sm:pt-3 pb-1 sm:pb-2 px-4 sm:px-6 lg:px-[38px] sticky top-0 z-50">
  <header class="max-w-[1530px] mx-auto h-[58px] rounded-[18px] lumina-glass px-4 sm:px-5 flex items-center justify-between shadow-header transition-all duration-300">
    
    <!-- Left: Logo & Nav Links -->
    <div class="flex items-center gap-6 lg:gap-8">
      <!-- Brand Logo -->
      <a href="/" class="flex items-center gap-2 group shrink-0">
        <div class="w-7 h-7 rounded-lg bg-lumina-lime/10 border border-lumina-lime/30 flex items-center justify-center transition-transform duration-300 group-hover:scale-105 shadow-lime-sm">
          <span class="text-lumina-lime font-black text-sm leading-none">⚡</span>
        </div>
        <div class="flex items-baseline gap-1 font-display font-black text-lg tracking-tight">
          <span class="text-white">LUMINA</span>
          <span class="text-lumina-lime font-black">4K</span>
        </div>
      </a>

      <!-- Desktop Navigation Links -->
      <nav class="hidden lg:flex items-center gap-6">
        {navLinks.map((link) => (
          <a
            href={link.href}
            class={`relative text-[13px] font-medium transition-colors py-1 ${
              link.active ? 'text-white font-semibold' : 'text-[#AEB4BC] hover:text-white'
            }`}
          >
            {link.name}
            {link.active && (
              <span class="absolute -bottom-2 left-1/2 -translate-x-1/2 w-7 h-[2px] bg-lumina-lime rounded-full shadow-[0_0_8px_#C2FF06]"></span>
            )}
          </a>
        ))}
      </nav>
    </div>

    <!-- Center/Right: Compact 460px Search Bar -->
    <div class="relative hidden md:block w-64 lg:w-[420px] xl:w-[460px] shrink">
      <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-gray-400">
        <svg class="w-4 h-4 text-[#A3A9B1]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
        </svg>
      </div>
      <input
        id="global-search-input"
        type="text"
        placeholder="Search 4K wallpapers, anime, nature, cyberpunk..."
        class="w-full h-[38px] pl-10 pr-12 bg-[#0D1116]/90 border border-white/16 rounded-full text-xs text-white placeholder-[#A3A9B1] focus:outline-none focus:border-lumina-lime/50 focus:ring-1 focus:ring-lumina-lime/50 transition-all backdrop-blur-md"
      />
      <div class="absolute inset-y-0 right-0 pr-2.5 flex items-center pointer-events-none">
        <span class="text-[10px] font-medium bg-white/[0.08] border border-white/10 text-gray-300 px-1.5 py-0.5 rounded-md">
          ⌘K
        </span>
      </div>
    </div>

    <!-- Right Controls: Icons & CTA Button -->
    <div class="flex items-center gap-2 sm:gap-2.5 shrink-0">
      <!-- Theme Switcher Icon -->
      <button
        aria-label="Toggle theme"
        class="hidden sm:flex w-8 h-8 rounded-full bg-white/[0.04] border border-white/10 items-center justify-center text-gray-300 hover:text-white hover:bg-white/[0.08] transition"
      >
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z" />
        </svg>
      </button>

      <!-- Notification Bell -->
      <button
        aria-label="Notifications"
        class="hidden sm:flex w-8 h-8 rounded-full bg-white/[0.04] border border-white/10 items-center justify-center text-gray-300 hover:text-white hover:bg-white/[0.08] transition relative"
      >
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9" />
        </svg>
        <span class="absolute top-1.5 right-1.5 w-1.5 h-1.5 bg-lumina-lime rounded-full"></span>
      </button>

      <!-- Profile Avatar -->
      <button
        aria-label="User profile"
        class="w-8 h-8 rounded-full bg-white/[0.04] border border-white/10 flex items-center justify-center text-gray-300 hover:text-white hover:bg-white/[0.08] transition"
      >
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
        </svg>
      </button>

      <!-- Primary Action CTA: Live Canvas Resizer -->
      <a
        href="/tool/cropper"
        class="h-9 px-3.5 rounded-[12px] bg-[#C2F600] hover:bg-[#C8FF00] text-[#050605] font-bold text-xs transition-all flex items-center gap-1.5 shadow-[0_0_14px_rgba(194,246,0,0.30)] hover:-translate-y-0.5 shrink-0 z-30"
      >
        <svg class="w-3.5 h-3.5 text-[#050605]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
        </svg>
        <span class="whitespace-nowrap font-bold">Live Canvas Resizer</span>
      </a>
    </div>

  </header>
</div>

<script>
  window.addEventListener('keydown', (e) => {
    if ((e.metaKey || e.ctrlKey) && e.key === 'k') {
      e.preventDefault();
      const searchInput = document.getElementById('global-search-input') as HTMLInputElement;
      if (searchInput) searchInput.focus();
    }
  });
</script>
