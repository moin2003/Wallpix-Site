---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import DeviceMockup from '../../components/DeviceMockup.astro';
import AdSenseSlot from '../../components/AdSenseSlot.astro';
import WallpaperGrid from '../../components/WallpaperGrid.astro';
import Footer from '../../components/Footer.astro';
import { wallpapers, type Wallpaper } from '../../data/wallpapers';

export async function getStaticPaths() {
  return wallpapers.map((wp) => ({
    params: { slug: wp.slug },
    props: { wallpaper: wp },
  }));
}

interface Props {
  wallpaper: Wallpaper;
}

const { wallpaper } = Astro.props;

// Related wallpapers
const relatedWallpapers = wallpapers
  .filter((w) => w.id !== wallpaper.id)
  .slice(0, 8);

const schema = {
  '@context': 'https://schema.org',
  '@type': 'ImageObject',
  name: wallpaper.title,
  caption: `${wallpaper.title} in 4K Ultra HD resolution`,
  contentUrl: wallpaper.sourceCdn,
  thumbnailUrl: wallpaper.sourceCdn,
  encodingFormat: 'image/jpeg',
  width: '3840',
  height: '2160',
  license: 'https://lumina-wallpapers.com/terms',
  acquireLicensePage: 'https://lumina-wallpapers.com/terms',
  author: {
    '@type': 'Organization',
    name: 'Lumina Wallpapers',
  },
};
---

<Layout
  title={`${wallpaper.title} (4K UHD Wallpaper)`}
  description={`Download ${wallpaper.title} 4K Ultra HD wallpaper. High-resolution background for desktop, iPhone, Android, and ultrawide monitors.`}
  image={wallpaper.sourceCdn}
  schema={schema}
>
  <Header />

  <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    
    <!-- Breadcrumb Navigation -->
    <nav class="flex items-center gap-2 text-xs text-gray-400 mb-6" aria-label="Breadcrumb">
      <a href="/" class="hover:text-neon-lime">Home</a>
      <span>/</span>
      <a href={`/category/${wallpaper.category?.toLowerCase().replace(/\s+/g, '-') || 'all'}`} class="hover:text-neon-lime">
        {wallpaper.category || 'Wallpapers'}
      </a>
      <span>/</span>
      <span class="text-white truncate max-w-xs">{wallpaper.title}</span>
    </nav>

    <!-- Main Wallpaper Detail Layout -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
      
      <!-- Left Column: Main Image View & Interactive Simulation (7 Cols) -->
      <div class="lg:col-span-7 space-y-6">
        
        <!-- Main High-Res Image Viewport -->
        <div class="relative rounded-2xl overflow-hidden glass-panel border border-white/10 group shadow-2xl bg-obsidian-950">
          <img
            id="main-wallpaper-img"
            src={wallpaper.sourceCdn}
            alt={wallpaper.title}
            referrerpolicy="no-referrer"
            class="w-full h-auto object-contain max-h-[560px] mx-auto transition-transform duration-300"
          />

          <!-- Fullscreen View Trigger -->
          <div class="absolute bottom-4 right-4 z-20">
            <a
              href={wallpaper.sourceCdn}
              target="_blank"
              rel="noopener noreferrer"
              class="flex items-center gap-1.5 px-3 py-1.5 rounded-xl bg-obsidian-950/80 backdrop-blur-md border border-white/10 text-xs font-semibold text-gray-200 hover:text-white hover:border-neon-lime/50 transition shadow-lg"
            >
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
              </svg>
              <span>View Full CDN Raw</span>
            </a>
          </div>
        </div>

        <!-- Interactive Screen Simulation (MacBook & iPhone) -->
        <DeviceMockup imageUrl={wallpaper.sourceCdn} title={wallpaper.title} />

        <!-- Color Palette Tone Information -->
        {wallpaper.colorHex && (
          <div class="glass-panel rounded-2xl p-5 border border-white/5 flex items-center justify-between">
            <div class="flex items-center gap-3">
              <span
                class="w-8 h-8 rounded-xl border border-white/20 shadow-md shrink-0"
                style={`background-color: ${wallpaper.colorHex};`}
              ></span>
              <div>
                <h4 class="text-xs font-bold text-white uppercase tracking-wider">Dominant Color Tone</h4>
                <p class="text-xs text-gray-400">{wallpaper.colorName} • <span class="font-mono text-neon-lime">{wallpaper.colorHex}</span></p>
              </div>
            </div>
            <a
              href={`/color/${wallpaper.tags?.find(t => t.includes('-')) || 'deep-teal'}`}
              class="text-xs text-gray-400 hover:text-neon-lime transition font-medium"
            >
              Browse similar colors →
            </a>
          </div>
        )}

      </div>

      <!-- Right Column: Download Options, Resizer Engine & AdSense (5 Cols) -->
      <div class="lg:col-span-5 space-y-6">
        
        <!-- Wallpaper Meta & Action Card -->
        <div class="glass-panel rounded-2xl p-6 border border-white/10 space-y-6">
          <div>
            <div class="flex items-center gap-2 mb-2">
              <span class="px-2.5 py-0.5 rounded-full bg-neon-lime/10 border border-neon-lime/30 text-neon-lime text-xs font-bold font-mono">
                {wallpaper.resolution || '4K ULTRA HD'}
              </span>
              <span class="text-xs text-gray-400 font-mono">
                {wallpaper.aspectRatio || '16:9'}
              </span>
            </div>
            <h1 class="text-2xl sm:text-3xl font-display font-extrabold text-white tracking-tight">
              {wallpaper.title}
            </h1>
          </div>

          <!-- Download Action Buttons -->
          <div class="space-y-3">
            <!-- Main Direct 4K Download -->
            <button
              id="instant-download-btn"
              data-url={wallpaper.sourceCdn}
              data-filename={`${wallpaper.slug}-4k.jpg`}
              class="w-full py-4 rounded-2xl bg-gradient-to-r from-neon-lime to-neon-cyan text-obsidian-950 font-display font-black text-base hover:opacity-95 transition-all shadow-glow-lime flex items-center justify-center gap-2 hover:scale-[1.02] active:scale-[0.98]"
            >
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
              </svg>
              <span>Download Original 4K</span>
            </button>

            <!-- Custom Crop Tool Link -->
            <a
              href={`/tool/cropper?url=${encodeURIComponent(wallpaper.sourceCdn)}`}
              class="w-full py-3 rounded-2xl bg-obsidian-800 hover:bg-obsidian-750 text-white border border-white/10 font-bold text-sm transition flex items-center justify-center gap-2"
            >
              <span>✂️ Custom Crop & Resize for Phone</span>
            </a>
          </div>

          <!-- Instant Multi-Resolution Fast Downloads -->
          <div class="pt-2 border-t border-white/5 space-y-2">
            <h4 class="text-xs font-bold uppercase tracking-wider text-gray-400 mb-2">
              Preset Resolutions
            </h4>
            <div class="grid grid-cols-2 gap-2">
              <button data-w="3840" data-h="2160" class="res-preset-btn px-3 py-2 rounded-xl bg-obsidian-850 hover:bg-obsidian-800 border border-white/5 text-xs text-left transition flex items-center justify-between">
                <span class="text-gray-200 font-medium">Desktop 4K</span>
                <span class="text-[10px] text-gray-500 font-mono">3840×2160</span>
              </button>
              <button data-w="2560" data-h="1440" class="res-preset-btn px-3 py-2 rounded-xl bg-obsidian-850 hover:bg-obsidian-800 border border-white/5 text-xs text-left transition flex items-center justify-between">
                <span class="text-gray-200 font-medium">2K QHD</span>
                <span class="text-[10px] text-gray-500 font-mono">2560×1440</span>
              </button>
              <button data-w="1920" data-h="1080" class="res-preset-btn px-3 py-2 rounded-xl bg-obsidian-850 hover:bg-obsidian-800 border border-white/5 text-xs text-left transition flex items-center justify-between">
                <span class="text-gray-200 font-medium">1080p FHD</span>
                <span class="text-[10px] text-gray-500 font-mono">1920×1080</span>
              </button>
              <button data-w="1080" data-h="2400" class="res-preset-btn px-3 py-2 rounded-xl bg-obsidian-850 hover:bg-obsidian-800 border border-white/5 text-xs text-left transition flex items-center justify-between">
                <span class="text-gray-200 font-medium">Mobile 9:20</span>
                <span class="text-[10px] text-gray-500 font-mono">1080×2400</span>
              </button>
            </div>
          </div>

          <!-- Technical Specs Table -->
          <div class="pt-4 border-t border-white/5 space-y-2 text-xs">
            <div class="flex justify-between py-1 text-gray-400">
              <span>Category</span>
              <span class="text-white font-medium">{wallpaper.category || '4K & Anime'}</span>
            </div>
            <div class="flex justify-between py-1 text-gray-400">
              <span>License</span>
              <span class="text-neon-lime font-medium">Free for Personal Use</span>
            </div>
            <div class="flex justify-between py-1 text-gray-400">
              <span>Views</span>
              <span class="text-white font-mono">{wallpaper.views?.toLocaleString()}</span>
            </div>
            <div class="flex justify-between py-1 text-gray-400">
              <span>Total Downloads</span>
              <span class="text-white font-mono">{wallpaper.downloads?.toLocaleString()}</span>
            </div>
          </div>

        </div>

        <!-- High-RPM Display Ad Container -->
        <AdSenseSlot format="rectangle" slotId="single-page-sidebar-ad" />

      </div>

    </div>

    <!-- Related Wallpapers Section -->
    <div class="mt-16 pt-12 border-t border-white/5">
      <WallpaperGrid wallpapers={relatedWallpapers} title="Similar 4K Wallpapers You May Like" />
    </div>

  </main>

  <Footer />
</Layout>

<script>
  // Instant Download Helper (Fetches image blob to trigger true download without opening in new tab)
  const downloadBtn = document.getElementById('instant-download-btn');
  if (downloadBtn) {
    downloadBtn.addEventListener('click', async () => {
      const url = downloadBtn.getAttribute('data-url');
      const filename = downloadBtn.getAttribute('data-filename') || 'wallpaper.jpg';
      if (!url) return;

      downloadBtn.innerHTML = '<span>⚡ Preparing Download...</span>';

      try {
        const res = await fetch(url, { referrerPolicy: 'no-referrer' });
        const blob = await res.blob();
        const blobUrl = window.URL.createObjectURL(blob);
        const a = document.createElement('a');
        a.href = blobUrl;
        a.download = filename;
        document.body.appendChild(a);
        a.click();
        document.body.removeChild(a);
        window.URL.revokeObjectURL(blobUrl);
      } catch (err) {
        // Fallback
        window.open(url, '_blank');
      } finally {
        downloadBtn.innerHTML = `
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
          </svg>
          <span>Downloaded! Click again</span>
        `;
      }
    });
  }

  // Preset Resolution Client-Side Cropping & Download
  const presetBtns = document.querySelectorAll('.res-preset-btn');
  presetBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      const w = btn.getAttribute('data-w') || '3840';
      const h = btn.getAttribute('data-h') || '2160';
      const img = document.getElementById('main-wallpaper-img') as HTMLImageElement;
      if (!img) return;

      const canvas = document.createElement('canvas');
      canvas.width = parseInt(w);
      canvas.height = parseInt(h);
      const ctx = canvas.getContext('2d');
      if (ctx) {
        ctx.drawImage(img, 0, 0, canvas.width, canvas.height);
        const dataUrl = canvas.toDataURL('image/jpeg', 0.95);
        const a = document.createElement('a');
        a.href = dataUrl;
        a.download = `lumina-wallpaper-${w}x${h}.jpg`;
        a.click();
      }
    });
  });
</script>
