---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import ColorPaletteFilter from '../../components/ColorPaletteFilter.astro';
import WallpaperGrid from '../../components/WallpaperGrid.astro';
import Footer from '../../components/Footer.astro';
import { LUXURY_COLORS, wallpapers } from '../../data/wallpapers';

export async function getStaticPaths() {
  return LUXURY_COLORS.map((c) => ({
    params: { color: c.slug },
    props: { colorInfo: c },
  }));
}

interface Props {
  colorInfo: typeof LUXURY_COLORS[0];
}

const { colorInfo } = Astro.props;

const filteredWallpapers = wallpapers.filter((w) =>
  w.colorName?.toLowerCase().includes(colorInfo.name.toLowerCase()) ||
  w.colorHex === colorInfo.hexAccent ||
  (w.tags || []).includes(colorInfo.slug)
);

const displayWallpapers = filteredWallpapers.length > 0 ? filteredWallpapers : wallpapers.slice(0, 12);
---

<Layout
  title={`${colorInfo.name} Aesthetic Wallpapers (4K UHD)`}
  description={`Browse curated ${colorInfo.name} (${colorInfo.hexAccent}) wallpapers in 4K, AMOLED and 1080p resolution.`}
>
  <Header />

  <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
    <!-- Color Tone Hero Header -->
    <div class="glass-panel rounded-3xl p-8 mb-8 border border-white/10 flex flex-col md:flex-row items-center justify-between gap-6 bg-gradient-to-r from-obsidian-850 to-obsidian-950">
      <div class="space-y-2 text-center md:text-left">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-white/5 border border-white/10 text-xs font-mono">
          <span class="w-2.5 h-2.5 rounded-full" style={`background-color: ${colorInfo.hexAccent};`}></span>
          <span>HEX {colorInfo.hexAccent}</span>
        </div>
        <h1 class="text-3xl sm:text-4xl font-display font-black text-white">
          {colorInfo.name} Wallpapers
        </h1>
        <p class="text-gray-400 text-sm max-w-xl">
          High-definition wallpapers styled around the luxurious {colorInfo.name} color palette.
        </p>
      </div>

      <!-- Color Swatch Pill -->
      <div class="flex items-center gap-2 p-3 rounded-2xl bg-obsidian-950 border border-white/10">
        <div class="w-12 h-12 rounded-xl shadow-lg border border-white/10" style={`background-color: ${colorInfo.hexPrimary};`}></div>
        <div class="w-12 h-12 rounded-xl shadow-lg border border-white/10" style={`background-color: ${colorInfo.hexAccent};`}></div>
      </div>
    </div>

    <ColorPaletteFilter activeColor={colorInfo.slug} />

    <WallpaperGrid wallpapers={displayWallpapers} title={`${colorInfo.name} Collection`} />
  </main>

  <Footer />
</Layout>
