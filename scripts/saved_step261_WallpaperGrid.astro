---
import type { Wallpaper } from '../data/wallpapers';
import WallpaperCard from './WallpaperCard.astro';
import AdSenseSlot from './AdSenseSlot.astro';

interface Props {
  wallpapers: Wallpaper[];
  title?: string;
}

const { wallpapers, title = 'Trending 4K Wallpapers' } = Astro.props;
---

<section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
  <div class="flex items-center justify-between mb-6">
    <div class="flex items-center gap-3">
      <div class="w-2.5 h-6 rounded-full bg-neon-lime"></div>
      <h2 id="gallery-heading" class="text-xl sm:text-2xl font-display font-bold text-white tracking-tight">
        {title}
      </h2>
      <span class="text-xs px-2.5 py-1 rounded-full bg-obsidian-800 border border-white/10 text-gray-400 font-mono">
        <span id="wallpaper-count">{wallpapers.length}</span> Items
      </span>
    </div>

    <!-- Quick Sorting & Resolution Filters -->
    <div class="flex items-center gap-2">
      <select
        id="sort-select"
        class="px-3 py-1.5 bg-obsidian-850 border border-white/10 rounded-xl text-xs text-gray-300 focus:outline-none focus:border-neon-lime cursor-pointer"
      >
        <option value="popular">🔥 Most Popular</option>
        <option value="recent">⚡ Newest First</option>
        <option value="downloads">📥 Most Downloaded</option>
      </select>
    </div>
  </div>

  <!-- Responsive Masonry Grid -->
  <div id="wallpapers-grid-container" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-5">
    {wallpapers.map((wp, index) => {
      // In-feed native ad placement after every 9 cards
      const showAd = (index + 1) % 9 === 0 && index !== wallpapers.length - 1;
      return (
        <>
          <WallpaperCard wallpaper={wp} priority={index < 4} />
          {showAd && (
            <div class="col-span-1 sm:col-span-2 lg:col-span-1 flex items-center">
              <AdSenseSlot format="in-feed" slotId={`in-feed-slot-${index}`} />
            </div>
          )}
        </>
      );
    })}
  </div>

  <!-- Empty Search Results State -->
  <div id="no-results-state" class="hidden text-center py-16 space-y-3">
    <div class="w-16 h-16 rounded-2xl bg-obsidian-850 border border-white/10 flex items-center justify-center mx-auto text-2xl">
      🔍
    </div>
    <h3 class="text-lg font-bold text-white">No wallpapers found</h3>
    <p class="text-sm text-gray-400 max-w-sm mx-auto">
      We couldn't find any wallpapers matching your search. Try searching for "Anime", "AMOLED", "Cyberpunk" or clear your filter.
    </p>
    <button
      id="reset-search-btn"
      class="px-4 py-2 rounded-xl bg-neon-lime text-obsidian-950 font-bold text-xs hover:bg-neon-lime/90 transition shadow-glow-lime"
    >
      Reset Search
    </button>
  </div>
</section>

<script>
  // Client-Side Instant Real-Time Search and Filter
  const searchInput = document.getElementById('global-search-input') as HTMLInputElement;
  const mobileSearchInput = document.getElementById('mobile-search-input') as HTMLInputElement;
  const gridContainer = document.getElementById('wallpapers-grid-container');
  const noResultsState = document.getElementById('no-results-state');
  const countBadge = document.getElementById('wallpaper-count');
  const resetBtn = document.getElementById('reset-search-btn');

  function filterCards(query: string) {
    const q = query.trim().toLowerCase();
    const cards = document.querySelectorAll('.wallpaper-card');
    let visibleCount = 0;

    cards.forEach((card) => {
      const title = card.getAttribute('data-title') || '';
      const category = card.getAttribute('data-category') || '';
      const tags = card.getAttribute('data-tags') || '';

      const matches = !q || title.includes(q) || category.includes(q) || tags.includes(q);

      if (matches) {
        (card as HTMLElement).style.display = 'flex';
        visibleCount++;
      } else {
        (card as HTMLElement).style.display = 'none';
      }
    });

    if (countBadge) countBadge.textContent = visibleCount.toString();

    if (visibleCount === 0 && noResultsState && gridContainer) {
      gridContainer.classList.add('hidden');
      noResultsState.classList.remove('hidden');
    } else if (noResultsState && gridContainer) {
      gridContainer.classList.remove('hidden');
      noResultsState.classList.add('hidden');
    }
  }

  if (searchInput) {
    searchInput.addEventListener('input', (e) => {
      filterCards((e.target as HTMLInputElement).value);
    });
  }

  if (mobileSearchInput) {
    mobileSearchInput.addEventListener('input', (e) => {
      filterCards((e.target as HTMLInputElement).value);
    });
  }

  if (resetBtn) {
    resetBtn.addEventListener('click', () => {
      if (searchInput) searchInput.value = '';
      if (mobileSearchInput) mobileSearchInput.value = '';
      filterCards('');
    });
  }
</script>
