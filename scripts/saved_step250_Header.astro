---
interface Props {
  currentCategory?: string;
}

const { currentCategory = 'all' } = Astro.props;

const navLinks = [
  { name: '4K Ultra HD', href: '/category/4k-ultra-hd' },
  { name: 'Anime & Gaming', href: '/category/anime-gaming' },
  { name: 'AMOLED Black', href: '/category/amoled-black' },
  { name: 'Cyberpunk', href: '/category/cyberpunk-neon' },
  { name: 'Color Explorer', href: '#color-explorer' },
];
---

<header class="sticky top-0 z-50 w-full backdrop-blur-xl bg-obsidian-950/80 border-b border-white/5 transition-all duration-300">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-20">
      
      <!-- Brand Logo -->
      <div class="flex items-center gap-8">
        <a href="/" class="flex items-center gap-3 group">
          <div class="w-10 h-10 rounded-xl bg-gradient-to-tr from-neon-lime to-neon-cyan p-0.5 shadow-glow-lime transition-transform duration-300 group-hover:scale-105">
            <div class="w-full h-full bg-obsidian-950 rounded-[10px] flex items-center justify-center">
              <span class="text-neon-lime font-black text-xl leading-none">⚡</span>
            </div>
          </div>
          <div class="flex flex-col">
            <span class="font-display font-extrabold text-2xl tracking-tight text-white flex items-center gap-1">
              LUMINA <span class="text-xs px-1.5 py-0.5 rounded-full bg-neon-lime/10 text-neon-lime border border-neon-lime/20 font-bold uppercase tracking-wider">4K</span>
            </span>
            <span class="text-[10px] text-gray-400 font-medium tracking-widest uppercase">Obsidian Wallpapers</span>
          </div>
        </a>

        <!-- Desktop Navigation Links -->
        <nav class="hidden md:flex items-center gap-1">
          {navLinks.map((link) => (
            <a
              href={link.href}
              class="px-3.5 py-2 rounded-lg text-sm font-medium text-gray-300 hover:text-white hover:bg-white/5 transition-colors"
            >
              {link.name}
            </a>
          ))}
        </nav>
      </div>

      <!-- Search Bar & Instant Resizer CTA -->
      <div class="flex items-center gap-4">
        <!-- Live Search Bar -->
        <div class="relative hidden sm:block w-64 lg:w-80">
          <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-gray-400">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
            </svg>
          </div>
          <input
            id="global-search-input"
            type="text"
            placeholder="Search 4K, AMOLED, Anime..."
            class="w-full pl-10 pr-12 py-2 bg-obsidian-850 border border-white/10 rounded-xl text-sm text-ice placeholder-gray-500 focus:outline-none focus:border-neon-lime focus:ring-1 focus:ring-neon-lime transition-all"
          />
          <div class="absolute inset-y-0 right-0 pr-3 flex items-center pointer-events-none">
            <span class="text-[10px] font-semibold bg-white/5 border border-white/10 text-gray-400 px-1.5 py-0.5 rounded">/</span>
          </div>
        </div>

        <!-- Custom Canvas Crop Tool Link -->
        <a
          href="/tool/cropper"
          class="hidden lg:flex items-center gap-2 px-4 py-2 rounded-xl bg-neon-lime text-obsidian-950 font-semibold text-sm hover:bg-neon-lime/90 transition-all shadow-glow-lime hover:scale-[1.02] active:scale-[0.98]"
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
          </svg>
          <span>Live Canvas Resizer</span>
        </a>

        <!-- Mobile Menu Button -->
        <button
          id="mobile-menu-btn"
          aria-label="Open navigation menu"
          class="md:hidden p-2 rounded-xl bg-obsidian-850 border border-white/10 text-gray-300 hover:text-white"
        >
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16m-7 6h7" />
          </svg>
        </button>
      </div>

    </div>
  </div>

  <!-- Mobile Dropdown Menu -->
  <div id="mobile-menu" class="hidden md:hidden border-t border-white/5 bg-obsidian-950/95 px-4 pt-3 pb-6 space-y-2 backdrop-blur-2xl">
    <div class="mb-3">
      <input
        id="mobile-search-input"
        type="text"
        placeholder="Search wallpapers..."
        class="w-full px-4 py-2.5 bg-obsidian-850 border border-white/10 rounded-xl text-sm text-ice placeholder-gray-500 focus:outline-none focus:border-neon-lime"
      />
    </div>
    {navLinks.map((link) => (
      <a
        href={link.href}
        class="block px-4 py-2.5 rounded-xl text-base font-medium text-gray-300 hover:text-neon-lime hover:bg-white/5"
      >
        {link.name}
      </a>
    ))}
    <a
      href="/tool/cropper"
      class="block text-center mt-2 px-4 py-2.5 rounded-xl bg-neon-lime text-obsidian-950 font-bold text-sm"
    >
      ✂️ Live Canvas Resizer
    </a>
  </div>
</header>

<script>
  // Mobile menu toggle
  const menuBtn = document.getElementById('mobile-menu-btn');
  const mobileMenu = document.getElementById('mobile-menu');
  if (menuBtn && mobileMenu) {
    menuBtn.addEventListener('click', () => {
      mobileMenu.classList.toggle('hidden');
    });
  }

  // Keyboard shortcut for search
  window.addEventListener('keydown', (e) => {
    if (e.key === '/' && document.activeElement?.tagName !== 'INPUT') {
      e.preventDefault();
      const searchInput = document.getElementById('global-search-input') as HTMLInputElement;
      if (searchInput) searchInput.focus();
    }
  });
</script>
