---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import GalleryFilterToolbar from '../../components/GalleryFilterToolbar.astro';
import GalleryGrid from '../../components/GalleryGrid.astro';
import Footer from '../../components/Footer.astro';
import { wallpapers } from '../../data/wallpapers';

const schema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'Lumina 4K Wallpaper Discovery Gallery',
  description: 'Explore ultra high definition 4K UHD wallpapers in 16:9 desktop format. Filter by anime, cyberpunk, nature, cars, space, and minimal aesthetics.',
  url: 'https://lumina-wallpapers.com/wallpapers',
};
---

<Layout
  title="4K Wallpapers Discovery Gallery | Lumina 4K"
  description="Browse 50,000+ 4K Ultra HD wallpapers in 16:9 widescreen format. Free instant download with zero compression."
  schema={schema}
>
  <!-- Compact Header with Wallpapers link active -->
  <Header currentCategory="wallpapers" />

  <main class="min-h-screen bg-[#010305]">
    <!-- 39px Category Filter Toolbar -->
    <GalleryFilterToolbar activeCategory="all" />

    <!-- 4-Column 16:9 Masonry Gallery Grid with Integrated Ad -->
    <GalleryGrid wallpapers={wallpapers} />
  </main>

  <Footer />
</Layout>
