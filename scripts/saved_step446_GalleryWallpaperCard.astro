---
import type { Wallpaper } from '../data/wallpapers';

interface Props {
  wallpaper: Wallpaper;
  priority?: boolean;
}

const { wallpaper, priority = false } = Astro.props;

// Realistic view count
const viewsCount = ((wallpaper.views || 1200) / 10).toFixed(1) + 'K';

// Generate 3 harmonious color swatches
const swatchColors = [
  wallpaper.colorHex || '#FF1493',
  '#22D3EE',
  '#C2F600',
];
---

<div
  class="relative w-full aspect-[16/9] rounded-[15px] overflow-hidden border border-white/16 bg-[#070A0D] lumina-gallery-card-item group cursor-pointer transition-all duration-300 hover:-translate-y-1 hover:border-lumina-lime/40 hover:shadow-card-hover"
  data-title={wallpaper.title.toLowerCase()}
  data-category={wallpaper.category?.toLowerCase() || ''}
  data-tags={(wallpaper.tags || []).join(' ').toLowerCase()}
>
  <!-- Full-bleed 16:9 Image -->
  <img
    src={wallpaper.sourceCdn}
    alt={wallpaper.title}
    loading={priority ? 'eager' : 'lazy'}
    decoding="async"
    referrerpolicy="no-referrer"
    class="w-full h-full object-cover block select-none transition-transform duration-500 ease-out group-hover:scale-105"
    onerror="this.src='https://images.unsplash.com/photo-1618005182384-a83a8bd57fbe?w=800&q=80'"
  />

  <!-- Top Badges Overlay -->
  <div class="absolute top-2.5 inset-x-3 flex items-center justify-between z-20 pointer-events-none">
    <!-- Top Left: 4K UHD Badge -->
    <span class="inline-flex items-center h-[26px] px-2.5 rounded-full bg-[#040708]/80 border border-lumina-lime text-lumina-lime text-[11px] font-bold shadow-[0_0_7px_rgba(194,246,0,0.28)] backdrop-blur-md">
      4K UHD
    </span>

    <!-- Top Right: 16:9 Badge -->
    <span class="inline-flex items-center justify-center w-11 h-[26px] rounded-full bg-[#030507]/70 border border-white/28 text-[#F4F5F6] text-[10px] font-semibold backdrop-blur-md">
      16:9
    </span>
  </div>

  <!-- Strong Bottom Cinematic Gradient Overlay -->
  <div class="absolute inset-0 bg-gradient-to-t from-black via-black/60 to-transparent pointer-events-none"></div>

  <!-- Bottom Card Content Area -->
  <div class="absolute bottom-0 inset-x-0 p-3 z-20 space-y-1.5 pointer-events-none">
    
    <!-- Wallpaper Title -->
    <h3 class="text-xs sm:text-[13px] font-semibold text-white truncate leading-tight group-hover:text-lumina-lime transition-colors">
      {wallpaper.title}
    </h3>

    <!-- Bottom Action Row: Swatches | Views | Download CTA -->
    <div class="flex items-center justify-between gap-2 pt-0.5 pointer-events-auto">
      
      <!-- 3 Color Swatch Dots -->
      <div class="flex items-center gap-1 shrink-0">
        {swatchColors.map((color) => (
          <span
            class="w-3 h-3 rounded-full border border-white/60 shadow-sm transition-transform hover:scale-125"
            style={`background-color: ${color};`}
          ></span>
        ))}
      </div>

      <!-- Center: View Count with SVG Eye -->
      <div class="flex items-center gap-1 text-[11px] font-medium text-[#E3E6E9] shrink-0">
        <svg class="w-3.5 h-3.5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
        </svg>
        <span>{viewsCount}</span>
      </div>

      <!-- Right: Translucent Glass Download Button -->
      <a
        href={`/wallpapers/${wallpaper.slug}`}
        class="h-8 px-3 rounded-full bg-[rgba(15,19,23,0.75)] hover:bg-[rgba(194,246,0,0.12)] border border-white/60 hover:border-lumina-lime text-white text-[11px] font-semibold inline-flex items-center gap-1.5 backdrop-blur-md transition-all shadow-sm shrink-0"
        title={`Download ${wallpaper.title}`}
      >
        <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
        </svg>
        <span>Download 4K</span>
      </a>

    </div>

  </div>
</div>
