name: WALPIX 4K Autonomous Daily Pipeline

on:
  schedule:
    # Runs daily at 00:00 UTC (06:00 AM BD Time)
    - cron: '0 0 * * *'
  workflow_dispatch:
    inputs:
      source:
        description: 'Ingestion Source Track'
        required: true
        default: 'apis'
        type: choice
        options:
          - apis
          - all
          - competitors
      limit:
        description: 'Wallpapers per feed/category'
        required: true
        default: '15'
        type: string

jobs:
  autonomous-pipeline:
    runs-on: ubuntu-latest
    permissions:
      contents: write

    steps:
      - name: 📥 Checkout Repository
        uses: actions/checkout@v4
        with:
          fetch-depth: 0

      - name: 🐍 Set up Python 3.11
        uses: actions/setup-python@v5
        with:
          python-version: '3.11'
          cache: 'pip'

      - name: 📦 Install Python Dependencies
        run: |
          python -m pip install --upgrade pip
          pip install requests playwright

      - name: ⚡ Set up Node.js 20
        uses: actions/setup-node@v4
        with:
          node-version: 20
          cache: 'npm'

      - name: 📦 Install NPM Dependencies
        run: npm install

      - name: 🚀 Run Autonomous Master Orchestrator
        run: |
          SOURCE_PARAM="${{ github.event.inputs.source || 'apis' }}"
          LIMIT_PARAM="${{ github.event.inputs.limit || '15' }}"
          python .agent/scripts/daily_automation_orchestrator.py --source $SOURCE_PARAM --limit $LIMIT_PARAM --skip-build

      - name: 📤 Commit & Push Updated Catalog and Sitemaps
        run: |
          git config --local user.email "bot@walpix.site"
          git config --local user.name "WALPIX Ingestion Bot"
          git add public/data/catalog.json public/sitemap*.xml public/*.txt src/data/blogPosts.ts .agent/data/
          git diff --quiet && git diff --staged --quiet || (git commit -m "chore(auto): daily 4K ingestion & SEO sitemap update [skip ci]" && git push)
