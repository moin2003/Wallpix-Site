---
import { ADSENSE_CONFIG } from '../config/adsense';

interface Props {
  adSlot?: string;
  className?: string;
}

const {
  adSlot = '1234567890',
  className = '',
} = Astro.props;

const isLiveAdSense = ADSENSE_CONFIG.isLive;
---

{isLiveAdSense && (
  <div class={`relative w-full aspect-[16/10] rounded-[15px] bg-[#070A0D] border border-white/[0.08] p-3 flex flex-col justify-between overflow-hidden shadow-lg ${className}`}>
    <div class="flex items-center justify-between text-[9px] font-mono text-gray-400">
      <span class="px-1.5 py-0.5 rounded bg-white/5 border border-white/10 uppercase">
        Advertisement
      </span>
      <span>Sponsored</span>
    </div>
    
    <div class="w-full h-full flex items-center justify-center overflow-hidden my-auto">
      <ins
        class="adsbygoogle"
        style="display:block; width:100%; height:100%;"
        data-ad-client={ADSENSE_CONFIG.publisherId}
        data-ad-slot={adSlot}
        data-ad-format="fluid"
        data-ad-layout-key="-fb+5w+4e-db+86"
      ></ins>
      <script is:inline>
        (adsbygoogle = window.adsbygoogle || []).push({});
      </script>
    </div>
  </div>
)}

