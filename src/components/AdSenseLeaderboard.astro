---
import { ADSENSE_CONFIG } from '../config/adsense';

interface Props {
  adClient?: string;
  adSlot?: string;
  className?: string;
  variant?: 'top' | 'bottom';
}

const {
  adClient = ADSENSE_CONFIG.publisherId,
  adSlot = '1234567890',
  className = '',
  variant = 'top',
} = Astro.props;

// Only render if live publisher ID is active
const isLiveAdSense = ADSENSE_CONFIG.isLive || (adClient && adClient.startsWith('ca-pub-') && !adClient.includes('0000000000000000'));
---

{isLiveAdSense && (
  <div class={`w-full px-4 sm:px-8 lg:px-12 py-3 ${className}`}>
    <!-- Live Google AdSense Container (Zero CLS Pre-reserved Container) -->
    <div class="relative w-full rounded-2xl bg-[#090c10]/90 border border-white/10 p-3 sm:p-4 overflow-hidden backdrop-blur-md shadow-2xl">
      <div class="flex items-center justify-between mb-2">
        <span class="text-[9px] sm:text-[10px] uppercase font-mono tracking-wider px-2 py-0.5 rounded bg-white/5 border border-white/10 text-gray-400 font-semibold">
          ADVERTISEMENT
        </span>
        <span class="text-[9px] sm:text-[10px] text-gray-500 font-mono">
          SPONSORED
        </span>
      </div>
      <div class="w-full min-h-[90px] flex items-center justify-center overflow-hidden">
        <ins
          class="adsbygoogle"
          style="display:block; width:100%; min-height:90px;"
          data-ad-client={adClient}
          data-ad-slot={adSlot}
          data-ad-format="auto"
          data-full-width-responsive="true"
        ></ins>
        <script is:inline>
          (adsbygoogle = window.adsbygoogle || []).push({});
        </script>
      </div>
    </div>
  </div>
)}
