---
import type { Wallpaper } from '../data/wallpapers';
import { getOptimizedThumbUrl } from '../utils/imageOptimizer';

interface Props {
  wallpaper: Wallpaper;
  priority?: boolean;
  index?: number;
}

const { wallpaper, priority = false, index = 0 } = Astro.props;

// Realistic view count
const viewsCount = ((wallpaper.views || 1200) / 10).toFixed(1) + 'K';

const isAnime = (wallpaper.category || '').toLowerCase().includes('anime') || (wallpaper.tags || []).some(t => t.toLowerCase() === 'anime');
const cardFallback = isAnime
  ? 'https://wallpapercat.com/w/full/f/9/6/1302353-3840x2160-desktop-4k-anime-background-image.jpg'
  : (wallpaper.sourceCdn?.startsWith('http') ? wallpaper.sourceCdn : 'https://images.unsplash.com/photo-1579783902614-a3fb3927b675?auto=format&fit=crop&w=1200&q=80');

const thumbSrc = getOptimizedThumbUrl(wallpaper.sourceCdn, priority ? 640 : 480, 80) || '/images/placeholder-wallpaper.webp';
const tier2Fallback = `https://wsrv.nl/?url=${encodeURIComponent(wallpaper.sourceCdn)}&w=480&q=80&output=webp`;

// Generate 3 harmonious color swatches
const swatchColors = [
  wallpaper.colorHex || '#FF1493',
  '#22D3EE',
  '#C2F600',
];
---

<div
  class="relative w-full aspect-[16/9] rounded-[15px] overflow-hidden border border-white/[0.08] bg-[#070A0D] wallpaper-card walpix-gallery-card-item group cursor-pointer transition-all duration-300 hover:-translate-y-1 hover:border-walpix-lime/40 hover:shadow-card-hover select-none"
  data-title={wallpaper.title.toLowerCase()}
  data-category={wallpaper.category?.toLowerCase() || ''}
  data-tags={(wallpaper.tags || []).join(' ').toLowerCase()}
  data-views={wallpaper.views || 0}
  data-downloads={wallpaper.downloads || 0}
  data-index={index}
  data-screen-types={(wallpaper.screenTypes || ['desktop-4k']).join(' ')}
  data-aspect={wallpaper.aspectRatio || '16:9'}
>
  <!-- Full-card clickable link -->
  <a
    href={`/wallpapers/${wallpaper.slug}`}
    class="absolute inset-0 w-full h-full block z-10 overflow-hidden"
    aria-label={`View and download ${wallpaper.title}`}
  >
    <!-- Full-bleed Image -->
    <img
      src={thumbSrc}
      alt={wallpaper.title}
      width="480"
      height="270"
      loading={priority ? 'eager' : 'lazy'}
      fetchpriority={priority ? 'high' : 'low'}
      decoding="async"
      referrerpolicy="no-referrer"
      class="w-full h-full object-cover block select-none transition-transform duration-500 ease-out group-hover:scale-105"
      onerror={`if(!this.dataset.triedFallback){this.dataset.triedFallback='1';this.src='${tier2Fallback}';}else{this.src='/images/placeholder-wallpaper.webp';}`}
    />

    <!-- Top Badges Overlay (Frosted Glass Minimalist Style - Zero Harsh Neon) -->
    <div class="absolute top-2.5 inset-x-2.5 sm:inset-x-3 flex items-center justify-between z-20 pointer-events-none">
      <!-- Top Left: Resolution Badge -->
      <span class="card-badge-res inline-flex items-center h-[22px] sm:h-[24px] px-2 sm:px-2.5 rounded-full bg-black/45 border border-white/20 text-white/90 text-[10px] sm:text-[11px] font-medium shadow-sm backdrop-blur-md">
        4K UHD
      </span>

      <!-- Top Right: Aspect Ratio Badge -->
      <span class="card-badge-aspect inline-flex items-center justify-center min-w-[32px] sm:w-10 h-[22px] sm:h-[24px] px-1.5 rounded-full bg-black/40 border border-white/20 text-white/80 text-[9px] sm:text-[10px] font-medium shadow-sm backdrop-blur-md">
        16:9
      </span>
    </div>

    <!-- Soft Bottom Cinematic Gradient Overlay (Preserves Wallpaper Visibility) -->
    <div class="absolute inset-x-0 bottom-0 h-32 sm:h-28 bg-gradient-to-t from-black/90 via-black/40 to-transparent pointer-events-none"></div>

    <!-- Bottom Card Content Area -->
    <div class="absolute bottom-0 inset-x-0 p-2.5 sm:p-3 z-20 space-y-1.5 pointer-events-none card-meta-box">
      
      <!-- Wallpaper Title -->
      <h3 class="text-xs sm:text-[13px] font-semibold text-white truncate leading-tight group-hover:text-walpix-lime transition-colors">
        {wallpaper.title}
      </h3>

      <!-- Bottom Action Row: Swatches | Views | Download CTA -->
      <div class="flex items-center justify-between gap-1.5 pt-0.5 pointer-events-none card-action-row">
        
        <!-- 3 Color Swatch Dots -->
        <div class="flex items-center gap-1 shrink-0 card-swatches">
          {swatchColors.map((color) => (
            <span
              class="w-2.5 h-2.5 sm:w-3 sm:h-3 rounded-full border border-white/60 shadow-sm"
              style={`background-color: ${color};`}
            ></span>
          ))}
        </div>

        <!-- Center: View Count with SVG Eye -->
        <div class="flex items-center gap-1 text-[10px] sm:text-[11px] font-medium text-[#E3E6E9] shrink-0 card-views">
          <svg class="w-3 h-3 sm:w-3.5 sm:h-3.5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
          </svg>
          <span>{viewsCount}</span>
        </div>

        <!-- Right: Translucent Glass Download Button Indicator -->
        <div
          class="card-download-btn h-7 sm:h-8 px-2.5 sm:px-3 rounded-full bg-[rgba(15,19,23,0.85)] group-hover:bg-walpix-lime group-hover:text-black border border-white/40 group-hover:border-walpix-lime text-white text-[10px] sm:text-[11px] font-semibold inline-flex items-center gap-1 sm:gap-1.5 backdrop-blur-md transition-all shadow-sm shrink-0"
        >
          <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
          </svg>
          <span class="btn-text">Download</span>
        </div>

      </div>

    </div>
  </a>
</div>

<style>
  .walpix-gallery-card-item {
    content-visibility: auto;
    contain-intrinsic-size: 320px 180px;
  }
</style>
