---
import CategoryStrip from './CategoryStrip.astro';

// Mobile Exclusive Slideshow Data
const mobileSlides = [
  {
    id: 0,
    slideId: 'hero-slide-astronaut',
    slideKey: 'slide-astronaut',
    image: '/images/hero-astronaut-master.webp',
    alt: 'WALPIX 4K Cosmic Astronaut Master Hero',
    eyebrow: '4K ULTRA HD WALLPAPERS',
    titleLine1: 'Unleash Pure',
    titleHighlight: 'Visual Power',
    titleLine3: 'On Your Screen',
    subtitle: 'Optimized for iPhone, Android, PC & Mac',
    highlightColor: '#C2FF06',
    highlightGlow: 'rgba(194, 255, 6, 0.45)',
    ctaLabel: 'Explore 50K+ Wallpapers',
    ctaHref: '#trending-gallery',
  },
  {
    id: 1,
    slideId: 'hero-slide-supercar',
    slideKey: 'slide-supercar',
    image: '/images/slideshow/image_20261012_202353.jpg',
    alt: 'Midnight Stealth Supercar 8K',
    eyebrow: 'HYPERCARS & SPEED 8K',
    titleLine1: 'Pure Adrenaline',
    titleHighlight: 'Midnight Hypercar',
    titleLine3: 'Built For Velocity',
    subtitle: 'Dark aerodynamic beast on rain-slicked midnight asphalt',
    highlightColor: '#FF2E54', // Electric Crimson Red matching supercar taillights
    highlightGlow: 'rgba(255, 46, 84, 0.55)',
    ctaLabel: 'Explore Supercars 8K',
    ctaHref: '/category/cars-supercars',
  },
  {
    id: 2,
    slideId: 'hero-slide-nature',
    slideKey: 'slide-nature',
    image: '/images/slideshow/image_20261012_202530.jpg',
    alt: 'Dark Nordic Mountain Wilderness 4K',
    eyebrow: 'DARK NATURE & LANDSCAPES 4K',
    titleLine1: 'Majestic Peaks',
    titleHighlight: 'Nordic Wilderness',
    titleLine3: 'Untamed & Serene',
    subtitle: 'Atmospheric mountain fog and dramatic obsidian landscapes',
    highlightColor: '#00FF88', // Vibrant Emerald Nature Green
    highlightGlow: 'rgba(0, 255, 136, 0.55)',
    ctaLabel: 'Explore Nature 4K',
    ctaHref: '/category/nature-scenery',
  },
  {
    id: 3,
    slideId: 'hero-slide-scifi',
    slideKey: 'slide-scifi',
    image: '/images/slideshow/image_20261012_202652.jpg',
    alt: 'Sci-Fi Cyberpunk Megacity 4K',
    eyebrow: 'SCI-FI & CYBERPUNK 4K',
    titleLine1: 'Future Horizons',
    titleHighlight: 'Sci-Fi Metropolis',
    titleLine3: 'Beyond The Sky',
    subtitle: 'Monolithic futuristic towers shrouded in atmospheric mist',
    highlightColor: '#00E5FF', // Cyber Neon Blue/Cyan matching skyscrapers
    highlightGlow: 'rgba(0, 229, 255, 0.55)',
    ctaLabel: 'Explore Sci-Fi 4K',
    ctaHref: '/category/cyberpunk-neon',
  },
  {
    id: 4,
    slideId: 'hero-slide-amoled',
    slideKey: 'slide-amoled',
    image: '/images/slideshow/image_20261012_202750.jpg',
    alt: 'Cosmic Singularity AMOLED Black Hole 8K',
    eyebrow: 'MINIMALIST AMOLED & COSMOS 8K',
    titleLine1: 'Infinite Abyss',
    titleHighlight: 'Cosmic Singularity',
    titleLine3: 'True Pure Black',
    subtitle: 'Pure obsidian AMOLED depth with vibrant glowing accretion ring',
    highlightColor: '#FFB800', // Radiant Solar Amber / Gold matching black hole
    highlightGlow: 'rgba(255, 184, 0, 0.60)',
    ctaLabel: 'Explore AMOLED 8K',
    ctaHref: '/category/amoled-black',
  },
];
---

<section id="hero-section" class="hero-section relative w-full overflow-hidden -mt-[96px] pt-24 sm:pt-28 lg:pt-36 pb-4 min-h-[720px] sm:min-h-[760px] lg:min-h-[840px] flex flex-col justify-between bg-[#030405]">
  
  <!-- ========================================================
       DESKTOP BACKGROUND: Synchronized 4K Hero Slideshow (sm:block hidden)
       Cycles smoothly through 4K wallpapers matching desktop widescreen
       ======================================================== -->
  <div id="desktop-hero-slider" class="hidden sm:block absolute inset-0 w-full h-full overflow-hidden select-none pointer-events-none">
    {mobileSlides.map((slide, idx) => (
      <img
        id={`desktop-${slide.slideId}`}
        src={slide.image}
        alt={slide.alt}
        width="1920"
        height="1080"
        class={`desktop-hero-bg-slide desktop-${slide.slideKey} ${idx === 0 ? 'active' : ''} absolute inset-0 w-full h-full object-cover select-none pointer-events-none`}
        data-desktop-slide-index={idx}
        loading={idx === 0 ? 'eager' : 'lazy'}
        fetchpriority={idx === 0 ? 'high' : 'low'}
        decoding="async"
      />
    ))}
  </div>

  <!-- ========================================================
       MOBILE SLIDESHOW BACKGROUND: Controlled directly via mobile-480.css
       (Each slide has its unique ID and class for 100% CSS control)
       ======================================================== -->
  <div id="mobile-hero-slider" class="sm:hidden absolute inset-0 w-full h-full overflow-hidden select-none pointer-events-none">
    {mobileSlides.map((slide, idx) => (
      <img
        id={slide.slideId}
        src={slide.image}
        alt={slide.alt}
        width="800"
        height="1200"
        class={`mobile-hero-bg-slide ${slide.slideKey} ${idx === 0 ? 'hero-bg-img active' : ''} absolute inset-0 w-full h-full object-cover select-none pointer-events-none`}
        data-slide-index={idx}
        loading={idx === 0 ? 'eager' : 'lazy'}
        fetchpriority={idx === 0 ? 'high' : 'low'}
        decoding="async"
      />
    ))}
  </div>

  <!-- Layer 1: Typography Contrast Overlay (Vertical gradient on mobile, Left-to-Right on desktop) -->
  <div class="absolute inset-0 hidden sm:block hero-overlay pointer-events-none"></div>
  <div class="hero-mobile-overlay absolute inset-0 sm:hidden bg-gradient-to-t from-[#030405] via-[#030405]/60 via-50% to-transparent pointer-events-none"></div>

  <!-- Layer 2: Seamless Bottom Fade to #030405 (Desktop only) -->
  <div class="absolute inset-0 hidden sm:block hero-bottom-fade pointer-events-none"></div>

  <!-- Smooth Mobile Edge Blend up to Instant Access button (110px soft blend, zero hard shape) -->
  <div class="hero-mobile-edge-dark absolute bottom-0 inset-x-0 h-28 sm:hidden pointer-events-none z-[1]"></div>

  <!-- Layer 3: Top Ambient Vignette behind Header -->
  <div class="absolute top-0 inset-x-0 h-24 bg-gradient-to-b from-[#030405]/80 via-[#030405]/20 to-transparent pointer-events-none"></div>

  <!-- ========================================================
       TOP ZONE: Fixed Height Text Slot (Independent Control)
       Changing text here will NOT shift the bottom elements!
       ======================================================== -->
  <div id="hero-text-block" class="relative z-10 w-full px-4 sm:px-8 lg:px-12 pt-2 lg:pt-4">
    
    <!-- DESKTOP TEXT: Dynamic Synchronized Slideshow for Desktop (sm:block hidden) -->
    <div class="hero-text-inner hidden sm:block relative max-w-5xl lg:max-w-6xl lg:pl-2 min-h-[290px] sm:min-h-[340px] lg:min-h-[420px]">
      {mobileSlides.map((slide, idx) => (
        <div
          class={`desktop-hero-text-slide absolute inset-0 flex flex-col justify-start transition-opacity duration-500 ${
            idx === 0
              ? 'active opacity-100 pointer-events-auto'
              : 'opacity-0 pointer-events-none'
          }`}
          data-desktop-text-slide={idx}
        >
          <!-- Eyebrow -->
          <p class="desktop-hero-eyebrow text-xs sm:text-sm lg:text-[15px] font-extrabold tracking-[0.2em] uppercase text-white/90 mb-1 sm:mb-2">
            {slide.eyebrow}
          </p>

          <!-- Headline with 3-line clean typography matching mobile -->
          <h1 class="desktop-hero-headline my-1 sm:my-2">
            <span class="desktop-title-top">{slide.titleLine1}</span> <br />
            <span
              class="desktop-hero-highlight transition-colors duration-500 inline-block"
              style={`color: ${slide.highlightColor}; filter: drop-shadow(0 0 24px ${slide.highlightGlow});`}
            >
              <span class="desktop-highlight-text inline-block">{slide.titleHighlight}</span>
            </span> <br />
            <span class="desktop-title-bottom">{slide.titleLine3}</span>
          </h1>

          <!-- Subtitle -->
          <p class="desktop-hero-subtitle text-white/80 text-sm sm:text-base lg:text-lg font-medium leading-relaxed max-w-[660px] pt-1">
            {slide.subtitle}
          </p>
        </div>
      ))}
    </div>

    <!-- MOBILE SLIDESHOW TEXT: Synchronized Slide-by-Slide Text (sm:hidden) -->
    <div class="sm:hidden relative w-full h-[180px] max-w-md" id="mobile-hero-text-container">
      {mobileSlides.map((slide, idx) => (
        <div
          class={`mobile-hero-text-slide absolute inset-0 flex flex-col justify-start transition-all duration-500 ease-out ${
            idx === 0
              ? 'active opacity-100 translate-y-0 pointer-events-auto'
              : 'opacity-0 translate-y-2 pointer-events-none'
          }`}
          data-text-slide={idx}
        >
          <!-- Eyebrow -->
          <p class="hero-eyebrow text-[10px] font-extrabold tracking-[0.14em] uppercase text-white/90 mb-1">
            {slide.eyebrow}
          </p>

          <!-- Huge Headline -->
          <h1 class="hero-headline text-[30px] font-extrabold tracking-[-0.04em] leading-[1.12] text-white my-1">
            <span class="hero-title-top">{slide.titleLine1}</span> <br />
            <span
              class={`hero-title-highlight slide-highlight-${slide.slideKey} transition-colors duration-500`}
              style={`color: ${slide.highlightColor}; filter: drop-shadow(0 0 18px ${slide.highlightGlow});`}
            >
              <span class="hero-highlight-text inline-block">{slide.titleHighlight}</span>
            </span> <br />
            <span class="hero-title-bottom">{slide.titleLine3}</span>
          </h1>

          <!-- Subtitle -->
          <p class="hero-subtitle text-white/80 text-[11px] font-medium leading-relaxed pt-1">
            {slide.subtitle}
          </p>
        </div>
      ))}
    </div>

  </div>

  <!-- ========================================================
       BOTTOM ZONE: Anchored Bottom Unit (Stats + CTA + Categories)
       Firmly anchored at the bottom of the Hero section.
       ======================================================== -->
  <div id="hero-bottom-zone" class="relative z-10 w-full mt-auto">
    
    <!-- Stats Glass Panel & Circular Explore Button Row -->
    <div class="w-full px-4 sm:px-8 lg:px-12 flex flex-col md:flex-row md:items-end justify-between gap-6 pb-6 lg:pl-14 lg:pr-14">
      
      <!-- Stats Glass Panel with distinct subtle border stroke -->
      <div class="hero-stats-panel glass-container max-w-[580px] w-full">
        
        <!-- Stat 1: 50,000+ Wallpapers (Electric Lime) -->
        <div class="flex items-center gap-3">
          <div class="w-9 h-9 rounded-xl bg-[#C2FF06]/10 border border-[#C2FF06]/50 flex items-center justify-center shrink-0 shadow-[0_0_12px_rgba(194,255,6,0.2)]">
            <svg class="w-4 h-4 text-[#C2FF06]" fill="currentColor" viewBox="0 0 24 24">
              <path d="M4 4h4v4H4V4zm6 0h4v4h-4V4zm6 0h4v4h-4V4zM4 10h4v4H4v-4zm6 0h4v4h-4v-4zm6 0h4v4h-4v-4zM4 16h4v4H4v-4zm6 0h4v4h-4v-4zm6 0h4v4h-4v-4z" />
            </svg>
          </div>
          <div>
            <div class="font-bold text-sm sm:text-base text-white leading-tight">50,000+</div>
            <div class="text-[10px] sm:text-[11px] text-[#92979E] font-medium">Wallpapers</div>
          </div>
        </div>

        <div class="h-8 w-[1px] bg-white/[0.12] hidden sm:block"></div>

        <!-- Stat 2: 100% Free Forever (Soft Magenta) -->
        <div class="flex items-center gap-3">
          <div class="w-9 h-9 rounded-xl bg-[#F91ACF]/10 border border-[#F91ACF]/50 flex items-center justify-center shrink-0 shadow-[0_0_12px_rgba(249,26,207,0.2)]">
            <svg class="w-4 h-4 text-[#F91ACF]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v13m0-13V6a2 2 0 112 2h-2zm0 0V6a2 2 0 10-2 2h2zm0 0H4a2 2 0 00-2 2v3a2 2 0 002 2h16a2 2 0 002-2V10a2 2 0 00-2-2h-8z" />
            </svg>
          </div>
          <div>
            <div class="font-bold text-sm sm:text-base text-white leading-tight">100%</div>
            <div class="text-[10px] sm:text-[11px] text-[#92979E] font-medium">Free Forever</div>
          </div>
        </div>

        <div class="h-8 w-[1px] bg-white/[0.12] hidden sm:block"></div>

        <!-- Stat 3: 4K UHD Ultra Quality (Amber Gold) -->
        <div class="flex items-center gap-3">
          <div class="w-9 h-9 rounded-xl bg-amber-500/10 border border-amber-500/50 flex items-center justify-center shrink-0 shadow-[0_0_12px_rgba(245,158,11,0.2)]">
            <svg class="w-4 h-4 text-amber-400" fill="currentColor" viewBox="0 0 24 24">
              <path d="M5 16L3 5l5.5 5L12 4l3.5 6L21 5l-2 11H5zm14 3c0 .6-.4 1-1 1H6c-.6 0-1-.4-1-1v-1h14v1z" />
            </svg>
          </div>
          <div>
            <div class="font-bold text-sm sm:text-base text-white leading-tight">4K UHD</div>
            <div class="text-[10px] sm:text-[11px] text-[#92979E] font-medium">Ultra Quality</div>
          </div>
        </div>

      </div>

      <!-- Explore Button: Luxury Glowing CTA Capsule -->
      <a
        id="hero-explore-cta-btn"
        href="#trending-gallery"
        class="hero-explore-cta group relative inline-flex items-center gap-3 px-5 sm:px-6 py-3 sm:py-3.5 rounded-full bg-[#070a0e]/95 hover:bg-[#0c1117] border border-[#C2FF06]/40 hover:border-[#C2FF06] text-white transition-all duration-300 shadow-[0_0_20px_rgba(194,255,6,0.18)] hover:shadow-[0_0_28px_rgba(194,255,6,0.4)] backdrop-blur-xl hover:scale-[1.02] cursor-pointer select-none shrink-0"
      >
        <div class="hero-cta-icon-badge w-8 h-8 rounded-full bg-[#C2FF06] flex items-center justify-center text-[#050608] shadow-[0_0_14px_rgba(194,255,6,0.6)] group-hover:scale-110 transition-all duration-300">
          <svg class="w-4 h-4 text-[#050608]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 14l-7 7m0 0l-7-7m7 7V3" />
          </svg>
        </div>
        <div class="text-left pr-1">
          <div class="text-[10px] sm:text-[11px] uppercase tracking-wider text-[#92979E] font-medium leading-tight hero-cta-sub">Instant Access</div>
          <div class="text-xs sm:text-sm font-extrabold text-white group-hover:text-[#C2FF06] transition-colors leading-tight hero-cta-label">Explore 50K+ Wallpapers</div>
        </div>
        <svg class="hero-cta-arrow w-4 h-4 text-[#C2FF06] transition-all duration-300 group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7" />
        </svg>
      </a>

    </div>

    <!-- Category Carousel Anchored at the Bottom of Hero (Desktop only, Mobile uses dedicated Browse by Category section) -->
    <div class="w-full pb-2 hidden sm:block">
      <CategoryStrip activeSlug="all" />
    </div>

  </div>

</section>

<style>
  /* ========================================================
     DESKTOP HERO SLIDESHOW: Crossfade & Framing
     Scoped cleanly to desktop only - zero mobile effect
     ======================================================== */
  @media (min-width: 640px) {
    .desktop-hero-bg-slide {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      object-fit: cover;
      opacity: 0;
      transform: scale(1.02);
      transition: opacity 1.4s cubic-bezier(0.4, 0, 0.2, 1), transform 8s cubic-bezier(0.25, 1, 0.5, 1);
      pointer-events: none;
      will-change: opacity, transform;
    }

    .desktop-hero-bg-slide.active {
      opacity: 1;
      transform: scale(1);
    }

    /* Desktop Object Positioning for Optimal 16:9 / 21:9 Framing */
    .desktop-slide-astronaut {
      object-position: 80% 25%;
    }

    .desktop-slide-supercar {
      object-position: center 60%;
    }

    .desktop-slide-nature {
      object-position: center 48%;
    }

    .desktop-slide-scifi {
      object-position: center 42%;
    }

    .desktop-slide-amoled {
      object-position: center 45%;
    }

    /* ========================================================
       DESKTOP HERO TEXT TYPOGRAPHY (Clean, Modern, Elegant like Mobile)
       ======================================================== */
    .desktop-hero-headline {
      margin: 0;
      padding: 0;
    }

    /* [১] উপরের লাইন (Line 1 - e.g. "Unleash Pure", "Pure Adrenaline") */
    .desktop-title-top {
      font-family: 'Outfit', sans-serif;
      font-weight: 800;
      font-size: clamp(54px, 5.5vw, 88px);
      line-height: 1.02;
      letter-spacing: -0.04em;
      color: #ffffff;
      display: inline-block;
    }

    /* [২] মাঝখানের কালার লাইন (Line 2 - e.g. "Visual Power", "Midnight Hypercar") */
    .desktop-hero-highlight,
    .desktop-highlight-text {
      font-family: "Moon Dance", cursive;
      font-style: italic;
      font-weight: 600;
      font-size: clamp(74px, 7.5vw, 122px);
      line-height: 1.06;
      letter-spacing: 0.01em;
      display: inline-block;
    }

    /* [৩] নিচের লাইন (Line 3 - e.g. "On Your Screen", "Built For Velocity") */
    .desktop-title-bottom {
      font-family: 'Outfit', sans-serif;
      font-weight: 800;
      font-size: clamp(48px, 4.8vw, 78px);
      line-height: 1.02;
      letter-spacing: -0.04em;
      color: #ffffff;
      display: inline-block;
    }

    /* ========================================================
       DESKTOP STAGGERED SEQUENTIAL ANIMATIONS (Exact Mobile Parity)
       - Eyebrow: subtle reveal
       - Line 1: smooth slide-up
       - Line 2: Moon Dance cursive blur-to-sharp glow reveal
       - Line 3: smooth slide-up sequential
       - Subtitle: soft fade-in finish
       ======================================================== */
    .desktop-hero-text-slide.active .desktop-hero-eyebrow {
      animation: desktopSeqEyebrow 0.40s cubic-bezier(0.16, 1, 0.3, 1) 0.02s both;
    }

    .desktop-hero-text-slide.active .desktop-title-top {
      animation: desktopSeqLineOne 0.48s cubic-bezier(0.16, 1, 0.3, 1) 0.08s both;
    }

    .desktop-hero-text-slide.active .desktop-highlight-text,
    .desktop-hero-text-slide.active .desktop-hero-highlight {
      animation: desktopSeqHighlightBlur 0.60s cubic-bezier(0.16, 1, 0.3, 1) 0.28s both;
    }

    .desktop-hero-text-slide.active .desktop-title-bottom {
      animation: desktopSeqLineThree 0.50s cubic-bezier(0.16, 1, 0.3, 1) 0.48s both;
    }

    .desktop-hero-text-slide.active .desktop-hero-subtitle {
      animation: desktopSeqSubtitle 0.52s ease-out 0.68s both;
    }

    @keyframes desktopSeqEyebrow {
      0% {
        opacity: 0;
        transform: translateY(-5px);
      }
      100% {
        opacity: 0.9;
        transform: translateY(0);
      }
    }

    @keyframes desktopSeqLineOne {
      0% {
        opacity: 0;
        transform: translateY(16px);
      }
      100% {
        opacity: 1;
        transform: translateY(0);
      }
    }

    @keyframes desktopSeqHighlightBlur {
      0% {
        opacity: 0;
        filter: blur(14px);
        transform: translateY(10px) scale(0.96);
      }
      60% {
        opacity: 0.9;
        filter: blur(3px);
      }
      100% {
        opacity: 1;
        filter: blur(0px);
        transform: translateY(0) scale(1);
      }
    }

    @keyframes desktopSeqLineThree {
      0% {
        opacity: 0;
        transform: translateY(16px);
      }
      100% {
        opacity: 1;
        transform: translateY(0);
      }
    }

    @keyframes desktopSeqSubtitle {
      0% {
        opacity: 0;
        transform: translateY(8px);
      }
      100% {
        opacity: 0.8;
        transform: translateY(0);
      }
    }
  }
</style>

<script>
  function initHeroSlideshow() {
    const heroSection = document.getElementById('hero-section');
    const mobileBgSlides = document.querySelectorAll<HTMLElement>('.mobile-hero-bg-slide');
    const desktopBgSlides = document.querySelectorAll<HTMLElement>('.desktop-hero-bg-slide');
    const mobileTextSlides = document.querySelectorAll<HTMLElement>('.mobile-hero-text-slide');
    const desktopTextSlides = document.querySelectorAll<HTMLElement>('.desktop-hero-text-slide');
    const ctaBtn = document.getElementById('hero-explore-cta-btn') as HTMLAnchorElement | null;
    const ctaLabel = ctaBtn?.querySelector('.hero-cta-label');

    const totalSlides = Math.max(mobileBgSlides.length, desktopBgSlides.length);
    if (!totalSlides || totalSlides <= 1) return;

    let currentIndex = 0;
    let timer: number | null = null;
    const SLIDE_DURATION = 8000; // 8 seconds per slide for relaxed viewing & reading
 
    const slideData = [
      { ctaHref: '#trending-gallery', ctaLabel: 'Explore 50K+ Wallpapers', accentColor: '#C2FF06' },
      { ctaHref: '/category/cars-supercars', ctaLabel: 'Explore Supercars 8K', accentColor: '#FF2E54' },
      { ctaHref: '/category/nature-scenery', ctaLabel: 'Explore Nature 4K', accentColor: '#00FF88' },
      { ctaHref: '/category/cyberpunk-neon', ctaLabel: 'Explore Sci-Fi 4K', accentColor: '#00E5FF' },
      { ctaHref: '/category/amoled-black', ctaLabel: 'Explore AMOLED 8K', accentColor: '#FFB800' }
    ];

    function goToSlide(targetIndex: number) {
      if (targetIndex === currentIndex) return;

      // 1. Mobile Background Slide
      const prevMobileBg = mobileBgSlides[currentIndex];
      if (prevMobileBg) {
        prevMobileBg.classList.remove('active');
      }
      const nextMobileBg = mobileBgSlides[targetIndex];
      if (nextMobileBg) {
        nextMobileBg.classList.remove('active');
        void nextMobileBg.offsetWidth; // Force CSS animation restart
        nextMobileBg.classList.add('active');
      }

      // 2. Desktop Background Slide
      const prevDesktopBg = desktopBgSlides[currentIndex];
      if (prevDesktopBg) {
        prevDesktopBg.classList.remove('active');
      }
      const nextDesktopBg = desktopBgSlides[targetIndex];
      if (nextDesktopBg) {
        nextDesktopBg.classList.remove('active');
        void nextDesktopBg.offsetWidth; // Force CSS animation restart
        nextDesktopBg.classList.add('active');
      }

      // 3. Mobile Text Slides
      mobileTextSlides.forEach((ts, idx) => {
        if (idx === targetIndex) {
          ts.classList.remove('active', 'opacity-0', 'translate-y-2', 'pointer-events-none');
          void ts.offsetWidth;
          ts.classList.add('active', 'opacity-100', 'translate-y-0', 'pointer-events-auto');
        } else {
          ts.classList.remove('active', 'opacity-100', 'translate-y-0', 'pointer-events-auto');
          ts.classList.add('opacity-0', 'translate-y-2', 'pointer-events-none');
        }
      });

      // 4. Desktop Text Slides (staggered keyframe re-trigger)
      desktopTextSlides.forEach((ts, idx) => {
        if (idx === targetIndex) {
          ts.classList.remove('active', 'opacity-0', 'pointer-events-none');
          void ts.offsetWidth; // Force reflow to replay sequential animations
          ts.classList.add('active', 'opacity-100', 'pointer-events-auto');
        } else {
          ts.classList.remove('active', 'opacity-100', 'pointer-events-auto');
          ts.classList.add('opacity-0', 'pointer-events-none');
        }
      });

      // 5. Update CTA Button (href, label & glowing accent) for both Mobile & Desktop
      if (ctaBtn && ctaLabel && slideData[targetIndex]) {
        ctaBtn.href = slideData[targetIndex].ctaHref;
        ctaLabel.textContent = slideData[targetIndex].ctaLabel;
        const iconBadge = ctaBtn.querySelector<HTMLElement>('.hero-cta-icon-badge');
        if (iconBadge && slideData[targetIndex].accentColor) {
          iconBadge.style.backgroundColor = slideData[targetIndex].accentColor;
          iconBadge.style.boxShadow = `0 0 14px ${slideData[targetIndex].accentColor}80`;
        }
        const arrow = ctaBtn.querySelector<SVGElement>('.hero-cta-arrow');
        if (arrow && slideData[targetIndex].accentColor) {
          arrow.style.color = slideData[targetIndex].accentColor;
        }
      }

      currentIndex = targetIndex;
    }

    function nextSlide() {
      const nextIdx = (currentIndex + 1) % totalSlides;
      goToSlide(nextIdx);
    }

    function prevSlide() {
      const prevIdx = (currentIndex - 1 + totalSlides) % totalSlides;
      goToSlide(prevIdx);
    }

    function startTimer() {
      stopTimer();
      timer = window.setInterval(nextSlide, SLIDE_DURATION);
    }

    function stopTimer() {
      if (timer !== null) {
        clearInterval(timer);
        timer = null;
      }
    }

    // Touch swipe gestures on mobile
    let touchStartX = 0;
    let touchStartY = 0;

    heroSection?.addEventListener('touchstart', (e) => {
      touchStartX = e.changedTouches[0].screenX;
      touchStartY = e.changedTouches[0].screenY;
      stopTimer();
    }, { passive: true });

    heroSection?.addEventListener('touchend', (e) => {
      const touchEndX = e.changedTouches[0].screenX;
      const touchEndY = e.changedTouches[0].screenY;
      const diffX = touchEndX - touchStartX;
      const diffY = touchEndY - touchStartY;

      if (Math.abs(diffX) > 40 && Math.abs(diffX) > Math.abs(diffY)) {
        if (diffX < 0) {
          nextSlide();
        } else {
          prevSlide();
        }
      }
      startTimer();
    }, { passive: true });

    // Desktop hover pause/resume
    heroSection?.addEventListener('mouseenter', () => {
      if (window.innerWidth >= 640) stopTimer();
    });
    heroSection?.addEventListener('mouseleave', () => {
      if (window.innerWidth >= 640) startTimer();
    });

    // Start auto-advance
    startTimer();

    // Pause on tab hidden / resume when visible
    document.addEventListener('visibilitychange', () => {
      if (document.hidden) {
        stopTimer();
      } else {
        startTimer();
      }
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initHeroSlideshow);
  } else {
    initHeroSlideshow();
  }
  document.addEventListener('astro:page-load', initHeroSlideshow);
</script>
