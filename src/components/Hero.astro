---
import CategoryStrip from './CategoryStrip.astro';
---

<section class="relative w-full overflow-hidden pt-24 lg:pt-28 pb-4 min-h-[640px] lg:min-h-[680px] flex flex-col justify-between bg-[#030405]">
  
  <!-- Full-bleed Master Cosmic Astronaut Wallpaper Background -->
  <img
    src="/images/hero-astronaut-master.jpg"
    alt="Lumina 4K Cosmic Astronaut Master Hero"
    class="absolute inset-0 w-full h-full object-cover object-[80%_25%] select-none pointer-events-none"
  />

  <!-- Layer 1: Soft Left Dark Gradient Overlay for typography contrast -->
  <div class="absolute inset-0 hero-overlay pointer-events-none"></div>

  <!-- Layer 2: Seamless Bottom Fade to #030405 -->
  <div class="absolute inset-0 hero-bottom-fade pointer-events-none"></div>

  <!-- Layer 3: Top Ambient Vignette behind Header -->
  <div class="absolute top-0 inset-x-0 h-24 bg-gradient-to-b from-[#030405]/80 via-[#030405]/20 to-transparent pointer-events-none"></div>

  <!-- Hero Main Content Container (Balanced Wide Container with refined insets) -->
  <div class="relative z-10 w-full max-w-[1720px] mx-auto px-6 sm:px-10 lg:px-12 flex-grow flex flex-col justify-between pt-2">
    
    <!-- Top / Center: Headline & Subtitle -->
    <div class="max-w-2xl space-y-4 pt-4 lg:pt-6 lg:pl-4">
      <!-- Eyebrow -->
      <p class="text-xs sm:text-[13px] font-bold tracking-[0.18em] uppercase text-[#A0A5AD]">
        ULTRA HD WALLPAPERS FOR EVERY SCREEN
      </p>

      <!-- Huge Headline -->
      <h1 class="text-hero font-extrabold tracking-[-0.055em] leading-[0.92] text-white">
        Unleash Pure <br />
        <span class="lumina-gradient-text">Visual Power</span> <br />
        On Your Screen
      </h1>

      <!-- Subtitle -->
      <p class="text-[#C8CCD2] text-base sm:text-lg leading-relaxed max-w-[580px] font-normal pt-1">
        Discover a world of breathtaking 4K wallpapers. From minimal elegance to epic digital worlds — all free, always.
      </p>
    </div>

    <!-- Middle/Bottom Row: Stats Glass Panel & Circular Explore Button -->
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 pt-6 pb-2 lg:pl-4 lg:pr-8">
      
      <!-- Stats Glass Panel with distinct border stroke -->
      <div class="glass-soft rounded-[20px] p-2.5 sm:p-3 max-w-[580px] flex items-center justify-between gap-2 sm:gap-6 border border-white/20 shadow-glass">
        
        <!-- Stat 1: 50,000+ Wallpapers -->
        <div class="flex items-center gap-3 px-2 sm:px-3">
          <div class="w-9 h-9 rounded-xl bg-lumina-lime/10 border border-lumina-lime/20 flex items-center justify-center shrink-0">
            <svg class="w-4 h-4 text-lumina-lime" fill="currentColor" viewBox="0 0 24 24">
              <path d="M4 4h4v4H4V4zm6 0h4v4h-4V4zm6 0h4v4h-4V4zM4 10h4v4H4v-4zm6 0h4v4h-4v-4zm6 0h4v4h-4v-4zM4 16h4v4H4v-4zm6 0h4v4h-4v-4zm6 0h4v4h-4v-4z" />
            </svg>
          </div>
          <div>
            <div class="font-bold text-sm sm:text-base text-white leading-tight">50,000+</div>
            <div class="text-[10px] sm:text-[11px] text-[#92979E] font-medium">Wallpapers</div>
          </div>
        </div>

        <div class="h-8 w-[1px] bg-white/10 hidden sm:block"></div>

        <!-- Stat 2: 100% Free Forever -->
        <div class="flex items-center gap-3 px-2 sm:px-3">
          <div class="w-9 h-9 rounded-xl bg-lumina-magenta/10 border border-lumina-magenta/20 flex items-center justify-center shrink-0">
            <svg class="w-4 h-4 text-lumina-magenta" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v13m0-13V6a2 2 0 112 2h-2zm0 0V6a2 2 0 10-2 2h2zm0 0H4a2 2 0 00-2 2v3a2 2 0 002 2h16a2 2 0 002-2V10a2 2 0 00-2-2h-8z" />
            </svg>
          </div>
          <div>
            <div class="font-bold text-sm sm:text-base text-white leading-tight">100%</div>
            <div class="text-[10px] sm:text-[11px] text-[#92979E] font-medium">Free Forever</div>
          </div>
        </div>

        <div class="h-8 w-[1px] bg-white/10 hidden sm:block"></div>

        <!-- Stat 3: 4K UHD Ultra Quality -->
        <div class="flex items-center gap-3 px-2 sm:px-3">
          <div class="w-9 h-9 rounded-xl bg-amber-500/10 border border-amber-500/20 flex items-center justify-center shrink-0">
            <svg class="w-4 h-4 text-amber-400" fill="currentColor" viewBox="0 0 24 24">
              <path d="M5 16L3 5l5.5 5L12 4l3.5 6L21 5l-2 11H5zm14 3c0 .6-.4 1-1 1H6c-.6 0-1-.4-1-1v-1h14v1z" />
            </svg>
          </div>
          <div>
            <div class="font-bold text-sm sm:text-base text-white leading-tight">4K UHD</div>
            <div class="text-[10px] sm:text-[11px] text-[#92979E] font-medium">Ultra Quality</div>
          </div>
        </div>

      </div>

      <!-- Explore Button: 56x56px Circular Play Button with Glow -->
      <a
        href="#trending-gallery"
        class="hidden sm:flex items-center gap-3.5 group cursor-pointer mb-2 mr-2"
      >
        <div class="w-14 h-14 rounded-full bg-[rgba(5,7,8,0.55)] border border-[rgba(194,255,6,0.85)] flex items-center justify-center shadow-play-glow group-hover:scale-105 transition-transform duration-300">
          <svg class="w-5 h-5 text-lumina-lime translate-x-0.5" fill="currentColor" viewBox="0 0 24 24">
            <path d="M8 5v14l11-7z" />
          </svg>
        </div>
        <div class="text-left">
          <div class="text-xs font-semibold text-white group-hover:text-lumina-lime transition-colors">Explore</div>
          <div class="text-[11px] text-[#92979E]">Stunning Worlds</div>
        </div>
      </a>

    </div>

  </div>

  <!-- Category Pills Carousel Embedded on Top of Hero Backdrop -->
  <div class="relative z-10 w-full pt-4">
    <CategoryStrip activeSlug="all" />
  </div>

</section>
