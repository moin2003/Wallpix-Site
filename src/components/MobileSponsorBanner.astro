---
import { ADSENSE_CONFIG } from '../config/adsense';

interface Props {
  className?: string;
  adSlot?: string;
}

const { className = '', adSlot = '1234567890' } = Astro.props;

// AdSense Approval Compliance:
// During site review phase, no fake/mock ads or broken containers are rendered.
// When ADSENSE_CONFIG.publisherId is set with a live ca-pub ID, this unit activates automatically.
const isLiveAdSense = ADSENSE_CONFIG.isLive;
---

{isLiveAdSense && (
  <div class={`w-full px-3 sm:px-6 lg:px-12 pt-1 pb-1.5 ${className}`}>
    <!-- Official Google AdSense Mobile Banner (Standard 320x100 / Responsive ~90-100px) -->
    <div class="relative w-full rounded-2xl bg-[#090c10]/90 border border-white/10 p-2.5 overflow-hidden backdrop-blur-md shadow-md min-h-[96px] flex flex-col justify-center">
      
      <!-- Top Meta Compliance Row -->
      <div class="flex items-center justify-between mb-1.5 px-1">
        <span class="text-[8px] uppercase font-mono tracking-widest px-1.5 py-0.5 rounded bg-white/[0.08] border border-white/10 text-gray-300 font-bold leading-none">
          ADVERTISEMENT
        </span>
        <button
          type="button"
          aria-label="Ad info"
          class="w-3.5 h-3.5 rounded-full bg-black/50 border border-white/20 flex items-center justify-center text-[9px] text-gray-400 hover:text-white leading-none transition"
        >
          i
        </button>
      </div>

      <!-- Live Google AdSense Container (Zero CLS Pre-reserved Height) -->
      <div class="w-full min-h-[80px] flex items-center justify-center overflow-hidden">
        <ins
          class="adsbygoogle"
          style="display:block; width:100%; min-height:80px;"
          data-ad-client={ADSENSE_CONFIG.publisherId}
          data-ad-slot={adSlot}
          data-ad-format="auto"
          data-full-width-responsive="true"
        ></ins>
        <script is:inline>
          (adsbygoogle = window.adsbygoogle || []).push({});
        </script>
      </div>

    </div>
  </div>
)}
