    <!-- ========================================================
         MOBILE BESPOKE LUXURY FOOTER (sm:hidden)
         Centered Brand, 1-Row Badges, Brand Color Socials & Dropdowns
         ======================================================== -->
    <div class="block sm:hidden space-y-4">
      
      <!-- 1. Brand Logo & Tagline (Centered & Nicely Sized) -->
      <div class="flex flex-col items-center text-center space-y-2">
        <a href="/" class="inline-block cursor-pointer" aria-label="WALPIX Home">
          <img
            src="/images/logo/logo-header.webp"
            alt="WALPIX 4K Wallpapers"
            width="140"
            height="40"
            loading="lazy"
            decoding="async"
