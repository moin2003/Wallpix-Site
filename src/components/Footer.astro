              </li>
            ))}
          </ul>
        </div>

        <!-- Column 4: Legal & Trust -->
        <div class="space-y-3.5">
          <div class="flex items-center gap-2">
            <svg class="w-3.5 h-3.5 text-walpix-lime" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
            </svg>
            <h4 class="text-xs font-bold uppercase tracking-wider text-white">Legal & Trust</h4>
          </div>
          <ul class="space-y-2 text-xs">
            {legalLinks.map((link) => (
              <li>
                <a href={link.href} class="text-[#9CA3AF] hover:text-walpix-lime transition-colors inline-flex items-center gap-1.5 group">
                  <span class="w-1 h-1 rounded-full bg-white/20 group-hover:bg-walpix-lime transition-colors"></span>
                  <span>{link.name}</span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      </div>

      <!-- Desktop Bottom Bar -->
      <div class="pt-6 border-t border-white/[0.08] flex items-center justify-between gap-4 text-xs text-[#8E949E]">
        <p class="font-medium text-[#A0A5AD]">
          © {currentYear} <span class="text-white font-bold">WALPIX 4K</span>. Handcrafted for visual purists & collectors.
        </p>
        <div class="flex items-center gap-2.5 text-[11.5px] text-[#9CA3AF]">
          <a href="/privacy" class="hover:text-walpix-lime transition-colors">Privacy</a>
          <span class="text-white/20">•</span>
          <a href="/terms" class="hover:text-walpix-lime transition-colors">Terms</a>
          <span class="text-white/20">•</span>
          <a href="/dmca" class="hover:text-walpix-lime transition-colors">DMCA</a>
