            </svg>
            <h4 class="text-xs font-bold uppercase tracking-wider text-white">Online Tools</h4>
          </div>
          <ul class="space-y-2.5 text-xs">
            {toolLinks.map((tool) => (
              <li>
                <a href={tool.href} class="text-[#9CA3AF] hover:text-white transition-colors flex items-center justify-between group">
                  <span class="group-hover:text-walpix-lime transition-colors">{tool.name}</span>
                  {tool.badge && (
                    <span class="text-[9px] font-mono px-2 py-0.5 rounded bg-[#C2FF06]/15 text-[#C2FF06] font-bold tracking-tight">
                      {tool.badge}
                    </span>
