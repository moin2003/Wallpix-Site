---
const currentYear = new Date().getFullYear();

const categoryLinks = [
  { name: '4K Ultra HD', href: '/category/4k-ultra-hd' },
  { name: 'Anime & Manga', href: '/category/anime' },
  { name: 'Gaming', href: '/category/gaming' },
  { name: 'AMOLED Black', href: '/category/amoled-black' },
  { name: 'Cyberpunk & Sci-Fi', href: '/category/cyberpunk-neon' },
  { name: 'Nature & Landscapes', href: '/category/nature-scenery' },
  { name: 'Space & Cosmic', href: '/category/space-cosmic' },
  { name: 'Cars & Supercars', href: '/category/cars-supercars' },
  { name: 'Browse All Tags (8,700+)', href: '/tag' },
];

const toolLinks = [
  {
    name: 'Smart 4K Canvas Cropper',
    href: '/tool/cropper',
    badge: 'Popular',
    icon: 'crop',
  },
  {
    name: 'Device Screen Mockup Studio',
    href: '/tool/mockup',
    badge: 'Live',
    icon: 'monitor',
  },
  {
    name: 'Curated Wallpaper Packs',
    href: '/collections',
    badge: 'Packs',
    icon: 'grid',
  },
  {
    name: 'Creator Community Hub',
    href: '/community',
    badge: 'Join',
    icon: 'palette',
  },
  {
    name: 'Editorial Guides & Blog',
    href: '/blog',
    badge: 'Articles',
    icon: 'book',
  },
];

const legalLinks = [
  { name: 'Privacy Policy (GDPR / CCPA)', href: '/privacy' },
  { name: 'Terms of Service', href: '/terms' },
  { name: 'DMCA & Copyright Takedown', href: '/dmca' },
  { name: 'Contact & Creator Support', href: '/contact' },
];
---

<footer class="relative mt-auto bg-[#030608] text-sm text-gray-400 overflow-hidden">
  
  <!-- 1. Top Green Accent & Glow Stripe -->
  <div class="relative w-full h-[2px] bg-gradient-to-r from-transparent via-[#C2FF06] to-transparent shadow-[0_0_16px_rgba(194,255,6,0.6)]">
    <div class="absolute inset-0 bg-[#C2FF06] blur-[2px] opacity-75"></div>
  </div>

  <!-- 2. Ambient Bottom-Center Radial Lime Glow -->
  <div class="absolute bottom-0 left-1/2 -translate-x-1/2 w-[900px] h-[320px] bg-[radial-gradient(ellipse_at_center,rgba(194,255,6,0.08)_0%,transparent_70%)] pointer-events-none"></div>

  <!-- Main Footer Content -->
  <div class="relative z-10 w-full max-w-7xl mx-auto px-4 sm:px-8 lg:px-12 pt-7 sm:pt-12 pb-6 sm:pb-8">

    <!-- ========================================================
         DESKTOP FOOTER (sm:block hidden) - 100% Intact & Untouched
         ======================================================== -->
    <div class="hidden sm:block">
      <div class="grid grid-cols-2 lg:grid-cols-5 gap-8 lg:gap-8 mb-12">
        <!-- Column 1: Brand, Mission & Social (Spans 2 cols on lg) -->
        <div class="footer-brand-col lg:col-span-2 space-y-5">
          <a href="/" class="footer-logo-link inline-flex items-center gap-2.5 cursor-pointer" aria-label="WALPIX Home">
            <img
              src="/images/logo/logo-header.webp"
              alt="WALPIX 4K Wallpapers"
              width="240"
              height="68"
              loading="lazy"
              decoding="async"
              class="footer-brand-logo-img w-auto object-contain select-none"
            />
          </a>

          <p class="text-[13px] text-[#8E949E] leading-relaxed max-w-sm">
            WALPIX — The next-generation ultra-high definition wallpaper hub. High-speed lossless streaming, instant client-side canvas cropper, and pure AMOLED aesthetics.
          </p>

          <div class="flex flex-wrap items-center gap-2 pt-1">
            <div class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-lg bg-white/[0.03] border border-white/[0.08] text-[11px] font-medium text-gray-300">
              <svg class="w-3.5 h-3.5 text-walpix-lime" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
              </svg>
              <span>100% Free Forever</span>
            </div>

            <div class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-lg bg-white/[0.03] border border-white/[0.08] text-[11px] font-medium text-gray-300">
              <svg class="w-3.5 h-3.5 text-walpix-lime" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
              </svg>
              <span>No Watermarks</span>
            </div>

            <div class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-lg bg-white/[0.03] border border-white/[0.08] text-[11px] font-medium text-gray-300">
              <svg class="w-3.5 h-3.5 text-walpix-lime" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z" />
              </svg>
              <span>Ultra HD 4K</span>
            </div>
          </div>

          <!-- Social Buttons Desktop -->
          <div class="flex flex-wrap items-center gap-2 pt-2">
            <a href="https://discord.com" target="_blank" rel="noopener noreferrer" aria-label="WALPIX Discord" class="w-8 h-8 rounded-xl bg-white/[0.03] hover:bg-white/[0.08] border border-white/[0.08] hover:border-walpix-lime/40 flex items-center justify-center text-gray-400 hover:text-walpix-lime transition-all duration-200">
              <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24"><path d="M20.317 4.37a19.791 19.791 0 0 0-4.885-1.515.074.074 0 0 0-.079.037c-.21.375-.444.864-.608 1.25a18.27 18.27 0 0 0-5.487 0 12.64 12.64 0 0 0-.617-1.25.077.077 0 0 0-.079-.037A19.736 19.736 0 0 0 3.677 4.37a.07.07 0 0 0-.032.027C.533 9.046-.32 13.58.099 18.057a.082.082 0 0 0 .031.057 19.9 19.9 0 0 0 5.993 3.03.078.078 0 0 0 .084-.028c.462-.63.874-1.295 1.226-1.994.021-.041.001-.09-.041-.106a13.107 13.107 0 0 1-1.872-.892.077.077 0 0 1-.008-.128 10.2 10.2 0 0 0 .372-.292.074.074 0 0 1 .077-.01c3.929 1.793 8.18 1.793 12.061 0a.074.074 0 0 1 .078.01c.12.098.246.198.373.292a.077.077 0 0 1-.006.127 12.299 12.299 0 0 1-1.873.893.077.077 0 0 0-.041.107c.36.698.772 1.362 1.225 1.993a.076.076 0 0 0 .084.028 19.839 19.839 0 0 0 6.002-3.03.077.077 0 0 0 .032-.054c.5-5.177-.838-9.674-3.549-13.66a.061.061 0 0 0-.031-.028zM8.02 15.33c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.956-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.956 2.418-2.157 2.418zm7.975 0c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.955-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.946 2.418-2.157 2.418z"/></svg>
            </a>
            <a href="https://github.com/moin2003/Wallpix-Site" target="_blank" rel="noopener noreferrer" aria-label="WALPIX GitHub" class="w-8 h-8 rounded-xl bg-white/[0.03] hover:bg-white/[0.08] border border-white/[0.08] hover:border-walpix-lime/40 flex items-center justify-center text-gray-400 hover:text-walpix-lime transition-all duration-200">
              <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24"><path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"/></svg>
