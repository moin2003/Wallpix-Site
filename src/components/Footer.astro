---
const currentYear = new Date().getFullYear();
---

<footer class="mt-auto border-t border-white/5 bg-obsidian-950 pt-12 pb-8 text-sm text-gray-400">
  <div class="w-full max-w-[1480px] mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-8 mb-12">
      
      <!-- Brand & Mission -->
      <div class="space-y-4 md:col-span-1">
        <div class="flex items-center gap-2">
          <span class="text-neon-lime font-black text-xl">⚡</span>
          <span class="font-display font-extrabold text-xl text-white tracking-tight">LUMINA 4K</span>
        </div>
        <p class="text-xs text-gray-400 leading-relaxed">
          The next-generation ultra-high definition wallpaper hub. Zero-cost streaming, instant client-side canvas crop, and pure AMOLED aesthetic.
        </p>
        <div class="flex items-center gap-3 text-xs text-neon-lime">
          <span>● 100% Free</span>
          <span>● No Watermarks</span>
          <span>● Lossless</span>
        </div>
      </div>

      <!-- Categories -->
      <div class="space-y-3">
        <h4 class="text-xs font-bold uppercase tracking-wider text-white">Categories</h4>
        <ul class="space-y-2 text-xs">
          <li><a href="/category/4k-ultra-hd" class="hover:text-neon-lime transition-colors">4K Ultra HD</a></li>
          <li><a href="/category/anime-gaming" class="hover:text-neon-lime transition-colors">Anime & Gaming</a></li>
          <li><a href="/category/amoled-black" class="hover:text-neon-lime transition-colors">AMOLED Dark Minimal</a></li>
          <li><a href="/category/cyberpunk-neon" class="hover:text-neon-lime transition-colors">Cyberpunk & Sci-Fi</a></li>
          <li><a href="/category/nature-scenery" class="hover:text-neon-lime transition-colors">Nature & Landscapes</a></li>
        </ul>
      </div>

      <!-- Free Tools & Explorers -->
      <div class="space-y-3">
        <h4 class="text-xs font-bold uppercase tracking-wider text-white">Online Tools</h4>
        <ul class="space-y-2 text-xs">
          <li><a href="/tool/cropper" class="hover:text-neon-lime transition-colors">⚡ Live 4K Canvas Cropper</a></li>
          <li><a href="/#color-explorer" class="hover:text-neon-lime transition-colors">🎨 Luxury Color Palette Filter</a></li>
          <li><a href="/category/all" class="hover:text-neon-lime transition-colors">📥 Batch Wallpaper Catalog</a></li>
          <li><a href="/tool/cropper" class="hover:text-neon-lime transition-colors">📱 Mobile Screen Simulator</a></li>
        </ul>
      </div>

      <!-- Legal & AdSense Compliance -->
      <div class="space-y-3">
        <h4 class="text-xs font-bold uppercase tracking-wider text-white">Legal & Support</h4>
        <ul class="space-y-2 text-xs">
          <li><a href="/privacy" class="hover:text-neon-lime transition-colors">Privacy Policy (GDPR/CCPA)</a></li>
          <li><a href="/terms" class="hover:text-neon-lime transition-colors">Terms of Service</a></li>
          <li><a href="/dmca" class="hover:text-neon-lime transition-colors">DMCA / Copyright Takedown</a></li>
          <li><a href="/contact" class="hover:text-neon-lime transition-colors">Contact Us & Feedback</a></li>
        </ul>
      </div>

    </div>

    <!-- Bottom Line & Disclaimer -->
    <div class="pt-8 border-t border-white/5 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-gray-500">
      <p>© {currentYear} Lumina Wallpapers. All rights reserved.</p>
      <p class="text-[11px] text-gray-600 max-w-md text-center sm:text-right">
        All images remain the copyright of their respective authors. Images are curated for personal desktop & mobile wallpaper use under fair use.
      </p>
    </div>
  </div>
</footer>
