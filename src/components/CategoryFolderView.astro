---
import { MAIN_CATEGORIES } from '../data/taxonomy';
import { CATEGORY_SUBFOLDERS, type SubFolderItem } from './CategorySubFolderStrip.astro';
import AdCard from './AdCard.astro';
import { ADSENSE_CONFIG } from '../config/adsense';

interface Props {
  className?: string;
}

const { className = '' } = Astro.props;

// Curated high quality themed fallback covers for subtopics
const fallbackThemedCovers: Record<string, string[]> = {
  'anime': [
