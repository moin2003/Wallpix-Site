---
interface Props {
  activeSlug?: string;
}

const { activeSlug = 'all' } = Astro.props;

const categories = [
  {
    name: 'All Wallpapers',
    slug: 'all',
    icon: 'grid',
    image: null,
  },
  {
    name: 'AMOLED Black',
    slug: 'amoled-black',
    image: '/images/mockup_cards/cat-amoled.jpg',
  },
  {
    name: 'Cyberpunk',
    slug: 'cyberpunk-neon',
    image: '/images/mockup_cards/cat-cyberpunk.jpg',
  },
  {
    name: '4K UHD',
    slug: '4k-ultra-hd',
    image: '/images/mockup_cards/cat-4k.jpg',
  },
  {
    name: 'Anime',
    slug: 'anime-gaming',
    image: '/images/mockup_cards/cat-anime.jpg',
  },
  {
    name: 'Nature',
    slug: 'nature-scenery',
    image: '/images/mockup_cards/cat-nature.jpg',
  },
  {
    name: 'Minimalist',
    slug: 'minimalist-abstract',
    image: '/images/mockup_cards/cat-minimalist.jpg',
  },
  {
    name: 'Cars',
    slug: 'cars-supercars',
    image: '/images/mockup_cards/cat-cars.jpg',
  },
];
---

<div id="categories" class="w-full max-w-[1720px] mx-auto px-6 sm:px-10 lg:px-12 py-3">
  <div class="relative flex items-center gap-2.5">
    
    <!-- Left Navigation Arrow -->
    <button
      id="cat-scroll-left"
      aria-label="Scroll categories left"
      class="hidden sm:flex w-9 h-9 rounded-full glass border border-white/12 items-center justify-center text-gray-400 hover:text-white hover:border-white/25 shrink-0 transition"
    >
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
      </svg>
    </button>

    <!-- Scrollable Pills Carousel -->
    <div
      id="category-carousel-track"
      class="flex items-center gap-3 overflow-x-auto no-scrollbar scroll-smooth py-2 flex-grow"
    >
      {categories.map((cat) => {
        const isActive = activeSlug === cat.slug;
        return (
          <a
            href={cat.slug === 'all' ? '/' : `/category/${cat.slug}`}
            class={`flex items-center gap-3 h-[52px] px-4.5 rounded-full transition-all shrink-0 border select-none ${
              isActive
                ? 'glass-pill-active font-semibold text-white'
                : 'glass-pill text-[#D7D9DC] hover:text-white'
            }`}
          >
            {/* Thumbnail Image or Grid Icon */}
            {cat.image ? (
              <img
                src={cat.image}
                alt={cat.name}
                referrerpolicy="no-referrer"
                class="w-8 h-8 rounded-full object-cover border border-white/20 shadow-sm"
              />
            ) : (
              <div class={`w-7 h-7 rounded-lg flex items-center justify-center ${isActive ? 'text-lumina-lime' : 'text-gray-400'}`}>
                <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M4 4h4v4H4V4zm6 0h4v4h-4V4zm6 0h4v4h-4V4zM4 10h4v4H4v-4zm6 0h4v4h-4v-4zm6 0h4v4h-4v-4zM4 16h4v4H4v-4zm6 0h4v4h-4v-4zm6 0h4v4h-4v-4z" />
                </svg>
              </div>
            )}

            <span class="text-xs sm:text-[13px] whitespace-nowrap font-medium">
              {cat.name}
            </span>
          </a>
        );
      })}
    </div>

    <!-- Right Navigation Arrow -->
    <button
      id="cat-scroll-right"
      aria-label="Scroll categories right"
      class="hidden sm:flex w-9 h-9 rounded-full glass border border-white/10 items-center justify-center text-gray-400 hover:text-white hover:border-white/20 shrink-0 transition"
    >
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
      </svg>
    </button>

  </div>
</div>

<script>
  const track = document.getElementById('category-carousel-track');
  const leftBtn = document.getElementById('cat-scroll-left');
  const rightBtn = document.getElementById('cat-scroll-right');

  leftBtn?.addEventListener('click', () => {
    track?.scrollBy({ left: -240, behavior: 'smooth' });
  });

  rightBtn?.addEventListener('click', () => {
    track?.scrollBy({ left: 240, behavior: 'smooth' });
  });
</script>
