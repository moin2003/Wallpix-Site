---
import type { Wallpaper } from '../data/wallpapers';
import WallpaperCard from './WallpaperCard.astro';
import AdCard from './AdCard.astro';
import { ADSENSE_CONFIG } from '../config/adsense';

interface Props {
  wallpapers: Wallpaper[];
  title?: string;
  subtitle?: string;
  gridMode?: 'all' | 'desktop' | 'phone' | 'dual';
  initialCount?: number;
  totalCount?: number;
  maxDomCount?: number;
}

const {
  wallpapers,
  title = 'Trending Wallpapers',
  subtitle = 'Handpicked ultra HD wallpapers, updated daily.',
  gridMode = 'all',
  initialCount = 36,
  totalCount = wallpapers.length,
  maxDomCount = 64,
} = Astro.props;

// High-performance DOM safeguarding: Render up to maxDomCount (64) cards in DOM, with initialCount (36) visible
const renderWallpapers = wallpapers.slice(0, maxDomCount);
---

<section id="trending-gallery" class="w-full px-4 sm:px-8 lg:px-12 pt-6 lg:pt-8 pb-12">
  
  <!-- Section Header -->
  <div class="flex items-center justify-between mb-4 sm:mb-5 gap-2 px-0.5">
    <div class="min-w-0 pr-2">
      <div class="flex items-center gap-2">
        <!-- Modern Solid Green Flame Icon -->
        <svg class="w-5 h-5 sm:w-6 sm:h-6 text-walpix-lime drop-shadow-[0_0_12px_rgba(194,255,6,0.65)] shrink-0" viewBox="0 0 24 24" fill="currentColor">
          <path fill-rule="evenodd" clip-rule="evenodd" d="M12.963 2.286a.75.75 0 00-1.071-.136 9.742 9.742 0 00-3.539 6.177A7.547 7.547 0 0110.25 8a.75.75 0 01.745.834 6.046 6.046 0 00.59 3.013c.277.587.69 1.096 1.203 1.488a.75.75 0 01-.019 1.197 3.513 3.513 0 01-2.02.618 3.5 3.5 0 01-3.5-3.5c0-.655.12-1.28.34-1.854a.75.75 0 00-1.123-.836A9.74 9.74 0 004.5 13.5C4.5 17.642 7.858 21 12 21s7.5-3.358 7.5-7.5c0-3.238-1.576-6.108-4.01-7.854a.75.75 0 00-.917.067 5.972 5.972 0 01-1.61 1.573z" />
        </svg>
        <h2 class="text-base sm:text-xl font-display font-extrabold text-white tracking-tight truncate">
          {title ? (
            <span>{title}</span>
          ) : (
            <>
              <span class="text-walpix-lime drop-shadow-[0_0_10px_rgba(194,255,6,0.35)]">Trending</span> Wallpapers
            </>
          )}
        </h2>
      </div>
      <p class="text-[11px] sm:text-[13px] text-[#858A91] mt-0.5 truncate">
        {subtitle}
      </p>
    </div>

    <!-- Redesigned Luxury Discovery Hub Pill Button (Single line on all screens) -->
    <a
      href="/wallpapers"
      class="group inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-[#080B0F] hover:bg-[#0F141C] border border-white/10 hover:border-walpix-lime/50 text-white transition-all duration-200 active:scale-95 shadow-sm shrink-0 whitespace-nowrap"
      aria-label="View all wallpapers in Discovery Hub"
    >
      <span class="text-[11px] sm:text-xs font-bold tracking-wide text-gray-300 group-hover:text-white transition-colors">
        Discovery Hub
      </span>
      <div class="w-4 h-4 rounded-full bg-walpix-lime/15 flex items-center justify-center group-hover:bg-walpix-lime transition-colors">
        <svg class="w-2.5 h-2.5 text-walpix-lime group-hover:text-[#050608] transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M9 5l7 7-7 7" />
        </svg>
      </div>
    </a>
  </div>

  <!-- Dynamic Responsive Grid Container (4 Columns on Desktop = 8 full rows of 32) -->
  <div id="wallpapers-grid-container" class={`grid-mode-${gridMode}`}>
    {renderWallpapers.map((wp, index) => {
      const isInitiallyHidden = index >= initialCount;
      return (
        <div
          class={`wallpaper-grid-item ${isInitiallyHidden ? 'load-more-hidden' : ''}`}
          style={isInitiallyHidden ? 'display: none;' : ''}
          data-index={index}
        >
          <WallpaperCard wallpaper={wp} priority={index < 4} />
          {ADSENSE_CONFIG.isLive && index === 3 && (
            <div class="wallpaper-card col-span-1">
              <AdCard />
            </div>
          )}
        </div>
      );
    })}
  </div>

  <!-- Centered Interactive Load More Section -->
  {totalCount > initialCount && (
    <div id="load-more-wrapper" class="flex flex-col items-center justify-center pt-10 pb-6">
      <button
        id="load-more-btn"
        class="group relative inline-flex items-center gap-3 px-8 py-3.5 rounded-full bg-[#090C10] hover:bg-[#C2FF06] text-white hover:text-[#050608] border border-white/[0.12] hover:border-[#C2FF06] font-bold text-xs tracking-wider uppercase transition-all duration-300 shadow-none hover:shadow-[0_0_24px_rgba(194,255,6,0.45)] cursor-pointer select-none active:scale-95"
        data-step="16"
        data-current={initialCount}
        data-total={renderWallpapers.length}
        data-grand-total={totalCount}
      >
        <svg class="w-4 h-4 transition-transform group-hover:translate-y-0.5 duration-300 text-[#C2FF06] group-hover:text-[#050608]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7" />
        </svg>
        <span id="load-more-text">Load Next 16 Wallpapers</span>
      </button>

      <p class="text-[11px] font-mono text-zinc-400 mt-2.5">
        Showing <span id="visible-count-num" class="text-walpix-lime font-bold">{Math.min(initialCount, renderWallpapers.length)}</span> of <span class="text-white font-bold">{totalCount}+</span> Handpicked Wallpapers
      </p>
    </div>
  )}

  <!-- No Results State -->
  <div id="no-results-state" class="hidden text-center py-16 space-y-3">
    <div class="w-14 h-14 rounded-2xl glass flex items-center justify-center mx-auto text-walpix-lime">
      <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
      </svg>
    </div>
    <h3 class="text-base font-bold text-white">No wallpapers found</h3>
    <p class="text-xs text-[#858A91] max-w-sm mx-auto">
      Try searching for "Cyberpunk", "Anime", "AMOLED", "Nature", or reset your search.
    </p>
    <button
      id="reset-search-btn"
      class="px-4 py-2 rounded-xl bg-walpix-lime text-[#050605] font-bold text-xs hover:bg-walpix-lime-bright transition shadow-lime"
    >
      Reset Search
    </button>
  </div>
</section>

<style>
  /* 4 items per row grid */
  #wallpapers-grid-container {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 24px;
  }

  @media (max-width: 1024px) {
    #wallpapers-grid-container {
      grid-template-columns: repeat(3, 1fr);
      gap: 18px;
    }
  }

  @media (max-width: 768px) {
    #wallpapers-grid-container {
      grid-template-columns: repeat(2, 1fr);
      gap: 14px;
    }
  }

  @media (max-width: 480px) {
    #wallpapers-grid-container {
      grid-template-columns: repeat(2, 1fr);
      gap: 10px;
    }
  }

  .wallpaper-grid-item {
    contain: layout paint;
  }

  /* Premium View All Button */
  .view-all-btn {
    background: rgba(255, 255, 255, 0.05);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    border: 1px solid rgba(255, 255, 255, 0.1);
    padding: 8px 20px;
    border-radius: 12px;
    color: #C2FF06;
    font-weight: 700;
    font-size: 13px;
    text-transform: uppercase;
    transition: all 0.3s ease;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    text-decoration: none;
  }

  .view-all-btn:hover {
    background: rgba(255, 255, 255, 0.1);
    border-color: rgba(194, 255, 6, 0.4);
    transform: translateY(-2px);
    box-shadow: 0 4px 15px rgba(194, 255, 6, 0.15);
  }
</style>

<script>
  const searchInput = document.getElementById('global-search-input') as HTMLInputElement;
  const gridContainer = document.getElementById('wallpapers-grid-container');
  const noResultsState = document.getElementById('no-results-state');
  const resetBtn = document.getElementById('reset-search-btn');
  const loadMoreBtn = document.getElementById('load-more-btn') as HTMLButtonElement;
  const loadMoreWrapper = document.getElementById('load-more-wrapper');
  const loadMoreText = document.getElementById('load-more-text');
  const visibleCountNum = document.getElementById('visible-count-num');

  // Progressive Load More Logic
  if (loadMoreBtn) {
    let currentVisible = parseInt(loadMoreBtn.getAttribute('data-current') || '32', 10);
    const step = parseInt(loadMoreBtn.getAttribute('data-step') || '16', 10);
    const total = parseInt(loadMoreBtn.getAttribute('data-total') || '0', 10);

    loadMoreBtn.addEventListener('click', () => {
      const items = document.querySelectorAll<HTMLElement>('.wallpaper-grid-item');
      const nextVisible = Math.min(currentVisible + step, total);

      items.forEach((item, idx) => {
        if (idx < nextVisible) {
          item.style.display = 'block';
          item.classList.remove('load-more-hidden');
          item.style.opacity = '0';
          item.style.transform = 'translateY(12px)';
          requestAnimationFrame(() => {
            item.style.opacity = '1';
            item.style.transform = 'translateY(0)';
          });
        }
      });

      currentVisible = nextVisible;
      loadMoreBtn.setAttribute('data-current', currentVisible.toString());

      if (visibleCountNum) {
        visibleCountNum.textContent = currentVisible.toString();
      }

      // When all loaded, turn button into gallery discovery link
      if (currentVisible >= total) {
        if (loadMoreText) {
          loadMoreText.textContent = 'Explore All in Discovery Hub →';
        }
        loadMoreBtn.onclick = () => {
          window.location.href = '/wallpapers';
        };
      }
    });
  }

  // Search Filter Handling
  function filterCards(query: string) {
    const q = query.trim().toLowerCase();
    const items = document.querySelectorAll<HTMLElement>('.wallpaper-grid-item');
    let visibleCount = 0;

    items.forEach((item) => {
      const card = item.querySelector('.wallpaper-card');
      if (!card) return;
      const title = card.getAttribute('data-title') || '';
      const category = card.getAttribute('data-category') || '';
      const tags = card.getAttribute('data-tags') || '';

      const matches = !q || title.includes(q) || category.includes(q) || tags.includes(q);

      if (matches) {
        item.style.display = 'block';
        item.style.opacity = '1';
        visibleCount++;
      } else {
        item.style.display = 'none';
      }
    });

    if (loadMoreWrapper) {
      loadMoreWrapper.style.display = q ? 'none' : 'flex';
    }

    if (visibleCount === 0 && noResultsState && gridContainer) {
      gridContainer.classList.add('hidden');
      noResultsState.classList.remove('hidden');
    } else if (noResultsState && gridContainer) {
      gridContainer.classList.remove('hidden');
      noResultsState.classList.add('hidden');
    }
  }

  searchInput?.addEventListener('input', (e) => {
    filterCards((e.target as HTMLInputElement).value);
  });

  resetBtn?.addEventListener('click', () => {
    if (searchInput) {
      searchInput.value = '';
      filterCards('');
    }
  });
</script>
