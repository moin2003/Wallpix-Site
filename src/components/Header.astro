---
interface Props {
  currentCategory?: string;
}

const { currentCategory = 'home' } = Astro.props;

const navLinks = [
  { name: 'Home', href: '/', active: true },
  { name: 'Wallpapers', href: '/wallpapers', active: false },
  { name: 'Categories', href: '#categories', active: false },
  { name: 'Collections', href: '#trending-gallery', active: false },
  { name: 'Community', href: '/tool/cropper', active: false },
];
---

<header class="w-full pt-4 pb-2 px-4 sm:px-6 lg:px-10 absolute top-0 inset-x-0 z-50">
  <div class="w-full max-w-[1720px] mx-auto h-[64px] rounded-2xl bg-[rgba(10,14,18,0.78)] backdrop-blur-xl px-5 lg:px-7 flex items-center justify-between border border-white/15 shadow-none">
    
    <!-- Left: Logo & Nav Links -->
    <div class="flex items-center gap-6 xl:gap-9">
      <!-- Logo: Glowing Lime Lightning Bolt + LUMINA 4K -->
      <a href="/" class="flex items-center gap-3 group shrink-0">
        <div class="w-9 h-9 rounded-xl bg-lumina-lime/15 border border-lumina-lime/30 flex items-center justify-center transition-transform duration-300 group-hover:scale-105 shadow-lime-sm">
          <svg class="w-4.5 h-4.5 text-lumina-lime fill-current drop-shadow-[0_0_6px_#C2FF06]" viewBox="0 0 24 24">
            <path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/>
          </svg>
        </div>
        <div class="flex items-baseline gap-1 font-sans font-extrabold text-[21px] tracking-tight">
          <span class="text-white font-extrabold">LUMINA</span>
          <span class="text-lumina-lime font-extrabold">4K</span>
        </div>
      </a>

      <!-- Desktop Nav Links -->
      <nav class="hidden xl:flex items-center gap-7">
        {navLinks.map((link) => (
          <a
            href={link.href}
            class={`relative text-[14px] font-medium transition-colors py-1 ${
              link.active ? 'text-white font-semibold' : 'text-[#A0A5AD] hover:text-white'
            }`}
          >
            {link.name}
            {link.active && (
              <span class="absolute -bottom-1.5 left-1/2 -translate-x-1/2 w-7 h-[2px] bg-lumina-lime rounded-full shadow-[0_0_6px_#C2FF06]"></span>
            )}
          </a>
        ))}
      </nav>
    </div>

    <!-- Center/Right: Sleek Search Bar with [⌘ K] -->
    <div class="relative hidden md:block w-72 lg:w-[440px] xl:w-[500px] shrink-0">
      <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-[#7E838B]">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
        </svg>
      </div>
      <input
        id="global-search-input"
        type="text"
        placeholder="Search wallpapers, e.g. anime, nature, 4K..."
        class="w-full h-10 pl-10 pr-14 bg-white/[0.04] border border-white/12 rounded-full text-[13.5px] text-white placeholder-[#7E838B] focus:outline-none focus:border-lumina-lime/40 focus:bg-white/[0.06] transition-all"
      />
      <div class="absolute inset-y-0 right-0 pr-3 flex items-center pointer-events-none">
        <span class="text-[11px] font-semibold bg-white/[0.08] border border-white/12 text-gray-300 px-1.5 py-0.5 rounded">
          ⌘ K
        </span>
      </div>
    </div>

    <!-- Right Controls: Utilities with crisp round borders & Primary CTA -->
    <div class="flex items-center gap-3 shrink-0">
      <!-- Sun/Theme Icon -->
      <button
        aria-label="Toggle theme"
        class="hidden sm:flex w-9 h-9 rounded-full bg-white/[0.03] border border-white/20 items-center justify-center text-gray-300 hover:text-white hover:border-white/35 transition"
      >
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z" />
        </svg>
      </button>

      <!-- Bell Icon with Notification Badge -->
      <button
        aria-label="Notifications"
        class="hidden sm:flex w-9 h-9 rounded-full bg-white/[0.03] border border-white/20 items-center justify-center text-gray-300 hover:text-white hover:border-white/35 transition relative"
      >
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9" />
        </svg>
        <span class="absolute top-2 right-2 w-1.5 h-1.5 bg-lumina-lime rounded-full shadow-[0_0_5px_#C2FF06]"></span>
      </button>

      <!-- Profile Avatar -->
      <button
        aria-label="User profile"
        class="w-9 h-9 rounded-full bg-white/[0.03] border border-white/20 flex items-center justify-center text-gray-300 hover:text-white hover:border-white/35 transition"
      >
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
        </svg>
      </button>

      <!-- Solid Electric Lime CTA Button -->
      <a
        href="/tool/cropper"
        class="h-10 px-4.5 rounded-xl bg-lumina-lime hover:bg-lumina-lime-bright text-[#050605] font-extrabold text-[13px] transition-all flex items-center gap-2 shadow-sm hover:shadow active:scale-95"
      >
        <svg class="w-3.5 h-3.5 fill-current text-[#050605]" viewBox="0 0 24 24">
          <path d="M19 12h-2v3h-3v2h5v-5zM7 9h3V7H5v5h2V9zm14-6H3c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h18c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm0 16.01H3V4.99h18v14.02z"/>
        </svg>
        <span class="whitespace-nowrap font-extrabold">Live Canvas Resizer</span>
      </a>
    </div>

  </div>
</header>
