---
interface Props {
  currentCategory?: string;
}

const { currentCategory = 'home' } = Astro.props;

const navLinks = [
  { 
    name: 'Home', 
    href: '/', 
    id: 'home',
    iconD: 'M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6' 
  },
  { 
    name: 'Wallpapers', 
    href: '/wallpapers', 
    id: 'wallpapers',
    iconD: 'M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z' 
  },
  { 
    name: 'Categories', 
    href: '/categories', 
    id: 'categories',
    iconD: 'M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zM14 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zM14 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z' 
  },
  { 
    name: 'Topics', 
    href: '/topics', 
    id: 'topics',
    iconD: 'M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z' 
  },
  { 
    name: 'Collections', 
    href: '/collections', 
    id: 'collections',
    iconD: 'M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10' 
  },
  { 
    name: 'Tags', 
    href: '/tag', 
    id: 'tag',
    iconD: 'M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z' 
  },
  { 
    name: 'Studio Tools', 
    href: '/tool/cropper', 
    id: 'tool',
    isDropdown: true,
    iconD: 'M14.121 14.121L19 19m-7-7l7-7m-7 7l-2.879 2.879M12 12L9.121 9.121m0 5.758a3 3 0 10-4.242 4.243 3 3 0 004.242-4.243zm0-5.758a3 3 0 10-4.242-4.243 3 3 0 004.242 4.243z' 
  },
  { 
    name: 'Blog', 
    href: '/blog', 
    id: 'blog',
    iconD: 'M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z' 
  },
];
---

<header id="site-header" class="walpix-site-header w-full px-3 sm:px-6 lg:px-12 sticky top-0 inset-x-0 z-50 pointer-events-none transition-all duration-300">
  <!-- Glassy Navbar Container -->
  <div class="glassy-nav-container pointer-events-auto">
    
    <!-- Left: Logo & Nav Links -->
    <div class="nav-section-left flex items-center gap-4 lg:gap-6 2xl:gap-8 min-w-0">
      <!-- Logo: Official WALPIX Brand Logo (Navbar Dedicated) -->
      <a href="/" class="flex items-center gap-2 shrink-0 py-0.5 cursor-pointer" aria-label="WALPIX 4K Home">
        <img
          src="/images/logo/logo-header.webp"
          alt="WALPIX 4K Wallpapers"
          width="240"
          height="68"
          loading="eager"
          decoding="async"
          fetchpriority="high"
          class="nav-brand-logo-img w-auto object-contain select-none"
        />
      </a>

      <!-- Vertical Divider (Hidden below 1320px) -->
      <div class="desktop-nav-divider h-6 w-[1px] bg-white/20 mx-1 hidden min-[1321px]:block shrink-0"></div>

      <!-- Desktop Nav Links (Hidden below 1320px) -->
      <nav class="desktop-nav hidden min-[1321px]:flex items-center shrink-0">
        {navLinks.map((link) => {
          const isActive = (currentCategory === 'home' && link.id === 'home') ||
                           (currentCategory === 'wallpapers' && link.id === 'wallpapers') ||
                           (currentCategory === link.id);
          
          if (link.isDropdown) {
            return (
              <div class="relative group/tools py-2">
                <a
                  href={link.href}
                  class={`nav-link relative text-[13.5px] lg:text-[14px] font-medium transition-colors py-1 flex items-center gap-1.5 whitespace-nowrap ${
                    isActive
                      ? 'nav-link-active font-semibold'
                      : 'text-[#9CA3AF] hover:text-white'
                  }`}
                >
                  <span>{link.name}</span>
                  <span class="px-1.5 py-0.2 rounded bg-walpix-lime/20 text-walpix-lime font-mono text-[9px] font-bold">3</span>
                  <svg class="w-3.5 h-3.5 text-gray-400 group-hover/tools:rotate-180 transition-transform duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
                  </svg>
                </a>

                <!-- Luxury Tools Dropdown Popover -->
                <div class="absolute top-full left-0 w-72 rounded-2xl bg-[#090C10]/95 backdrop-blur-2xl border border-white/[0.08] p-2 shadow-2xl space-y-1 opacity-0 pointer-events-none translate-y-2 group-hover/tools:opacity-100 group-hover/tools:pointer-events-auto group-hover/tools:translate-y-0 transition-all duration-200 z-50">
                  <div class="px-3 py-1.5 text-[10px] font-mono text-gray-400 uppercase tracking-wider border-b border-white/[0.06] flex items-center justify-between">
                    <span>Creative Tools</span>
                    <span class="text-[#C2FF06] font-bold">100% Free</span>
                  </div>

                  <!-- 1. Canvas Resizer & Cropper -->
                  <a href="/tool/cropper" class="p-2.5 rounded-xl hover:bg-[#C2FF06]/10 border border-transparent hover:border-[#C2FF06]/40 transition-all flex items-start gap-3 group/item block">
                    <div class="w-8 h-8 rounded-lg bg-[#C2FF06]/15 border border-[#C2FF06]/40 flex items-center justify-center text-[#C2FF06] shrink-0 mt-0.5 shadow-[0_0_10px_rgba(194,255,6,0.2)]">
                      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.121 14.121L19 19m-7-7l7-7m-7 7l-2.879 2.879M12 12L9.121 9.121m0 5.758a3 3 0 10-4.242 4.243 3 3 0 004.242-4.243zm0-5.758a3 3 0 10-4.242-4.243 3 3 0 004.242 4.243z"/>
                      </svg>
                    </div>
                    <div>
                      <div class="text-xs font-bold text-white group-hover/item:text-[#C2FF06]">4K Canvas Resizer</div>
                      <div class="text-[10px] text-gray-400 leading-tight">Crop, zoom, pan & resize for desktop or phone</div>
                    </div>
                  </a>

                  <!-- 2. Social Avatar & PFP Maker -->
                  <a href="/tool/avatar" class="p-2.5 rounded-xl hover:bg-[#FF28B8]/10 border border-transparent hover:border-[#FF28B8]/40 transition-all flex items-start gap-3 group/item block">
                    <div class="w-8 h-8 rounded-lg bg-[#FF28B8]/15 border border-[#FF28B8]/40 flex items-center justify-center text-[#FF28B8] shrink-0 mt-0.5 shadow-[0_0_10px_rgba(255,40,184,0.2)]">
                      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5.121 17.804A13.937 13.937 0 0112 16c2.5 0 4.847.655 6.879 1.804M15 10a3 3 0 11-6 0 3 3 0 016 0zm6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
                      </svg>
                    </div>
                    <div>
                      <div class="text-xs font-bold text-white group-hover/item:text-[#FF28B8]">Social Avatar & PFP Maker</div>
                      <div class="text-[10px] text-gray-400 leading-tight">Discord, Steam, IG glow avatars with RGB rings</div>
                    </div>
                  </a>

                  <!-- 3. Dual & Multi-Monitor Splitter -->
                  <a href="/tool/splitter" class="p-2.5 rounded-xl hover:bg-[#00F0FF]/10 border border-transparent hover:border-[#00F0FF]/40 transition-all flex items-start gap-3 group/item block">
                    <div class="w-8 h-8 rounded-lg bg-[#00F0FF]/15 border border-[#00F0FF]/40 flex items-center justify-center text-[#00F0FF] shrink-0 mt-0.5 shadow-[0_0_10px_rgba(0,240,255,0.2)]">
                      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                      </svg>
                    </div>
                    <div>
                      <div class="text-xs font-bold text-white group-hover/item:text-[#00F0FF]">Multi-Monitor Splitter</div>
                      <div class="text-[10px] text-gray-400 leading-tight">Span 4K wallpapers across dual/triple screens</div>
                    </div>
                  </a>
                </div>
              </div>
            );
          }

          return (
            <a
              href={link.href}
              class={`nav-link relative text-[13.5px] lg:text-[14px] font-medium transition-colors py-1 whitespace-nowrap ${
                isActive
                  ? 'nav-link-active font-semibold'
                  : 'text-[#9CA3AF] hover:text-white'
              }`}
            >
              {link.name}
            </a>
          );
        })}
      </nav>
    </div>

    <!-- Center: Responsive Pill Search Bar (Guaranteed Min-Width) -->
    <div class="nav-search-wrapper relative hidden md:flex items-center flex-1 max-w-sm lg:max-w-md xl:max-w-[440px] mx-2 lg:mx-4 2xl:mx-6 min-w-[160px]">
      <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-[#8E939D]">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
        </svg>
      </div>
      <input
        id="global-search-input"
        type="text"
        placeholder="Search wallpapers, e.g. anime, nature, 4K..."
        class="w-full h-10 pl-10 pr-12 sm:pr-14 bg-white/[0.04] hover:bg-white/[0.06] focus:bg-white/[0.08] border border-white/[0.10] focus:border-walpix-lime/40 rounded-full text-[13px] sm:text-[13.5px] text-white placeholder-[#8E939D] focus:outline-none transition-all"
      />
      <div class="absolute inset-y-0 right-0 pr-3 flex items-center pointer-events-none">
        <kbd class="text-[11px] font-semibold bg-white/[0.08] border border-white/10 text-gray-300 px-2 py-0.5 rounded-md leading-none">
          ⌘ K
        </kbd>
      </div>
    </div>

    <!-- Right: Utility Controls & Primary CTA -->
    <div class="nav-section-right flex items-center gap-1.5 sm:gap-2.5 shrink-0">
      
      <!-- Mobile Header Search Button (Replacing Sun/Theme button on mobile screens) -->
      <button
        type="button"
        id="mobile-header-search-btn"
        aria-label="Search wallpapers"
        class="nav-icon-btn flex sm:hidden items-center justify-center cursor-pointer shrink-0 text-gray-300 hover:text-white"
      >
        <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" class="w-4 h-4">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
        </svg>
      </button>

      <!-- Sun/Theme Icon (Preserved on tablet/desktop >=640px) -->
      <button
        type="button"
        aria-label="Toggle theme"
        class="nav-icon-btn hidden sm:flex items-center justify-center cursor-pointer shrink-0"
      >
        <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z" />
        </svg>
      </button>

      <!-- Bell Icon with Notification Badge (Hidden on mobile <640px, visible in hamburger menu) -->
      <button
        type="button"
        aria-label="Notifications"
        class="nav-icon-btn hidden sm:flex items-center justify-center relative cursor-pointer shrink-0"
      >
        <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9" />
        </svg>
        <span class="absolute top-2 right-2 w-2 h-2 bg-[#C2FF06] rounded-full shadow-[0_0_8px_#C2FF06]"></span>
      </button>

      <!-- Profile Avatar (Hidden on mobile <640px, visible in hamburger menu) -->
      <button
        type="button"
        aria-label="User profile"
        class="nav-icon-btn hidden sm:flex items-center justify-center cursor-pointer shrink-0"
      >
        <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
        </svg>
      </button>

      <!-- Solid Electric Lime CTA Button with Glow-only Hover Effect -->
      <a
        href="/tool/cropper"
        class="hidden sm:flex h-9 sm:h-10 px-3.5 sm:px-4 lg:px-5 rounded-xl bg-[#C2FF06] hover:bg-[#b5ff00] text-[#050608] font-black text-[12px] sm:text-[13px] transition-all duration-300 items-center gap-1.5 sm:gap-2 shadow-none hover:shadow-[0_0_24px_rgba(194,255,6,0.65)] shrink-0 ml-1 cursor-pointer active:scale-95"
      >
        <svg class="w-4 h-4 fill-current text-[#050608] shrink-0" viewBox="0 0 24 24">
          <path d="M19 12h-2v3h-3v2h5v-5zM7 9h3V7H5v5h2V9zm14-6H3c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h18c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm0 16.01H3V4.99h18v14.02z"/>
        </svg>
        <span class="whitespace-nowrap font-black tracking-tight text-[#050608]">Live Canvas Resizer</span>
      </a>

      <!-- Mobile Menu Toggle Button (Visible below 1320px) -->
      <button
        type="button"
        id="mobile-menu-btn"
        aria-label="Toggle mobile menu"
        class="mobile-menu-toggle rounded-xl bg-white/[0.06] hover:bg-white/[0.12] border border-white/[0.12] hover:border-walpix-lime/40 flex items-center justify-center text-gray-200 hover:text-white transition shrink-0 cursor-pointer"
      >
        <svg class="w-4.5 h-4.5 sm:w-5 sm:h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </button>
    </div>

  </div>

  <!-- Mobile Dropdown Navigation Menu (Floating Absolute Overlay Drawer) -->
  <div id="mobile-nav-menu" class="hidden absolute top-[calc(100%+8px)] inset-x-3 sm:inset-x-6 z-[100] p-4 rounded-2xl bg-[#090C10]/98 backdrop-blur-2xl border border-white/[0.12] shadow-[0_20px_50px_rgba(0,0,0,0.9)] pointer-events-auto transition-all max-h-[85vh] overflow-y-auto">
    <!-- Mobile Search (Visible on small screens) -->
    <div class="relative mb-3 md:hidden">
      <input
        type="text"
        id="mobile-search-input"
        placeholder="Search wallpapers, e.g. anime, nature, 4K..."
        class="w-full h-10 pl-10 pr-4 bg-white/[0.05] border border-white/10 rounded-xl text-xs text-white placeholder-gray-400 outline-none focus:border-walpix-lime/50"
      />
      <svg class="w-4 h-4 text-gray-400 absolute left-3.5 top-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
      </svg>
    </div>

    <!-- Links List with Rich Vector Icons -->
    <div class="flex flex-col space-y-1.5">
      {navLinks.map((link) => {
        const isActive = (currentCategory === 'home' && link.id === 'home') ||
                         (currentCategory === 'wallpapers' && link.id === 'wallpapers') ||
                         (currentCategory === link.id);
        return (
          <a
            href={link.href}
            class={`px-3.5 py-2.5 rounded-xl text-sm font-medium transition-colors flex items-center justify-between group ${
              isActive 
                ? 'bg-walpix-lime/10 border border-walpix-lime/30 text-walpix-lime font-bold' 
                : 'text-gray-300 hover:text-white hover:bg-white/[0.06]'
            }`}
          >
            <div class="flex items-center gap-3">
              <div class={`w-7 h-7 rounded-lg flex items-center justify-center transition-colors ${
                isActive ? 'bg-walpix-lime/20 text-walpix-lime' : 'bg-white/5 text-gray-400 group-hover:text-white'
              }`}>
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={link.iconD} />
                </svg>
              </div>
              <span>{link.name}</span>
            </div>
            <svg class="w-3.5 h-3.5 text-gray-500 group-hover:text-walpix-lime transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
            </svg>
          </a>
        );
      })}
    </div>

    <!-- Mobile Studio Tools Direct Links -->
    <div class="mt-3 pt-3 border-t border-white/10 space-y-1">
      <span class="text-[10px] font-mono text-gray-400 uppercase tracking-wider px-2">Creative Studio Tools:</span>
      <div class="grid grid-cols-3 gap-1.5 pt-1">
        <a href="/tool/cropper" class="p-2 rounded-xl bg-white/[0.03] border border-white/10 text-[11px] font-medium text-gray-200 flex flex-col items-center text-center gap-1 hover:border-walpix-lime/40 transition-colors">
          <span class="w-1.5 h-1.5 rounded-full bg-walpix-lime"></span>
          <span>4K Resizer</span>
        </a>
        <a href="/tool/avatar" class="p-2 rounded-xl bg-white/[0.03] border border-white/10 text-[11px] font-medium text-gray-200 flex flex-col items-center text-center gap-1 hover:border-[#FF28B8]/40 transition-colors">
          <span class="w-1.5 h-1.5 rounded-full bg-[#FF28B8]"></span>
          <span>Avatar Maker</span>
        </a>
        <a href="/tool/splitter" class="p-2 rounded-xl bg-white/[0.03] border border-white/10 text-[11px] font-medium text-gray-200 flex flex-col items-center text-center gap-1 hover:border-[#00F0FF]/40 transition-colors">
          <span class="w-1.5 h-1.5 rounded-full bg-[#00F0FF]"></span>
          <span>Screen Splitter</span>
        </a>
      </div>
    </div>

    <!-- Mobile Quick Utilities & CTA Button -->
    <div class="pt-3 mt-3 border-t border-white/10 flex flex-col gap-2.5">
      <!-- Mobile Quick Utilities -->
      <div class="grid grid-cols-3 gap-2 sm:hidden py-1">
        <button type="button" class="flex items-center justify-center gap-1.5 text-xs font-semibold text-gray-200 hover:text-white py-2 px-2 rounded-xl bg-white/[0.04] border border-white/10 hover:border-walpix-lime/30 active:scale-95 transition-all cursor-pointer">
          <svg class="w-4 h-4 text-walpix-lime" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z" />
          </svg>
          <span>Theme</span>
        </button>
        <button type="button" class="flex items-center justify-center gap-1.5 text-xs font-semibold text-gray-200 hover:text-white py-2 px-2 rounded-xl bg-white/[0.04] border border-white/10 hover:border-walpix-lime/30 relative active:scale-95 transition-all cursor-pointer">
          <svg class="w-4 h-4 text-walpix-lime" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9" />
          </svg>
          <span>Alerts</span>
          <span class="w-1.5 h-1.5 rounded-full bg-walpix-lime shadow-[0_0_6px_rgba(194,255,6,0.8)]"></span>
        </button>
        <button type="button" class="flex items-center justify-center gap-1.5 text-xs font-semibold text-gray-200 hover:text-white py-2 px-2 rounded-xl bg-white/[0.04] border border-white/10 hover:border-walpix-lime/30 active:scale-95 transition-all cursor-pointer">
          <svg class="w-4 h-4 text-walpix-lime" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
          </svg>
          <span>Account</span>
        </button>
      </div>

      <a
        href="/tool/cropper"
        class="w-full h-11 rounded-xl bg-walpix-lime text-[#050608] font-black text-xs sm:text-sm flex items-center justify-center gap-2 shadow-md active:scale-98"
      >
        <svg class="w-4 h-4 fill-current text-[#050608]" viewBox="0 0 24 24">
