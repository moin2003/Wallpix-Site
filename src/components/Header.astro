---
interface Props {
  currentCategory?: string;
}

const { currentCategory = 'home' } = Astro.props;

const navLinks = [
  { name: 'Home', href: '/', active: true },
  { name: 'Wallpapers', href: '/wallpapers', active: false },
  { name: 'Categories', href: '#categories', active: false },
  { name: 'Collections', href: '#trending-gallery', active: false },
  { name: 'Community', href: '/tool/cropper', active: false },
];
---

<header class="w-full pt-4 pb-2 px-4 sm:px-8 lg:px-12 absolute top-0 inset-x-0 z-50">
  <div class="w-full h-[72px] rounded-2xl bg-[rgba(14,18,24,0.76)] backdrop-blur-2xl px-6 lg:px-8 flex items-center justify-between border border-white/16 shadow-[inset_0_1px_1px_rgba(255,255,255,0.12)]">
    
    <!-- Left: Logo & Nav Links -->
    <div class="flex items-center gap-8 xl:gap-12">
      <!-- Logo: Glowing Lime Lightning Bolt + LUMINA 4K -->
      <a href="/" class="flex items-center gap-3.5 group shrink-0">
        <div class="w-10 h-10 rounded-xl bg-lumina-lime/15 border border-lumina-lime/35 flex items-center justify-center transition-transform duration-300 group-hover:scale-105 shadow-lime-sm">
          <svg class="w-5 h-5 text-lumina-lime fill-current drop-shadow-[0_0_8px_#C2FF06]" viewBox="0 0 24 24">
            <path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/>
          </svg>
        </div>
        <div class="flex items-baseline gap-1.5 font-sans font-extrabold text-[24px] tracking-tight">
          <span class="text-white font-black">LUMINA</span>
          <span class="text-lumina-lime font-black tracking-normal">4K</span>
        </div>
      </a>

      <!-- Desktop Nav Links -->
      <nav class="hidden xl:flex items-center gap-8">
        {navLinks.map((link) => (
          <a
            href={link.href}
            class={`relative text-[15px] font-semibold transition-colors py-1.5 ${
              link.active ? 'text-white' : 'text-[#A8ADB6] hover:text-white'
            }`}
          >
            {link.name}
            {link.active && (
              <span class="absolute -bottom-1 left-1/2 -translate-x-1/2 w-8 h-[2.5px] bg-lumina-lime rounded-full shadow-[0_0_8px_#C2FF06]"></span>
            )}
          </a>
        ))}
      </nav>
    </div>

    <!-- Center/Right: Sleek Search Bar (Subtle Border, NO thick white stroke) -->
    <div class="relative hidden md:block w-80 lg:w-[480px] xl:w-[540px] shrink-0">
      <div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none text-[#8E939D]">
        <svg class="w-4.5 h-4.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
        </svg>
      </div>
      <input
        id="global-search-input"
        type="text"
        placeholder="Search wallpapers, e.g. anime, nature, 4K..."
        class="w-full h-11 pl-11 pr-16 bg-white/[0.05] border border-white/10 rounded-full text-[14px] text-white placeholder-[#8E939D] focus:outline-none focus:border-lumina-lime/40 focus:bg-white/[0.08] transition-all"
      />
      <div class="absolute inset-y-0 right-0 pr-3.5 flex items-center pointer-events-none">
        <span class="text-xs font-semibold bg-white/[0.08] border border-white/10 text-gray-300 px-2 py-0.5 rounded-md">
          ⌘ K
        </span>
      </div>
    </div>

    <!-- Right Controls: Utilities & Primary CTA -->
    <div class="flex items-center gap-3 shrink-0">
      <!-- Sun/Theme Icon -->
      <button
        aria-label="Toggle theme"
        class="hidden sm:flex w-10 h-10 rounded-full bg-white/[0.04] border border-white/10 items-center justify-center text-gray-300 hover:text-white hover:bg-white/[0.08] transition"
      >
        <svg class="w-4.5 h-4.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z" />
        </svg>
      </button>

      <!-- Bell Icon with Notification Badge -->
      <button
        aria-label="Notifications"
        class="hidden sm:flex w-10 h-10 rounded-full bg-white/[0.04] border border-white/10 items-center justify-center text-gray-300 hover:text-white hover:bg-white/[0.08] transition relative"
      >
        <svg class="w-4.5 h-4.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9" />
        </svg>
        <span class="absolute top-2.5 right-2.5 w-1.5 h-1.5 bg-lumina-lime rounded-full shadow-[0_0_6px_#C2FF06]"></span>
      </button>

      <!-- Profile Avatar -->
      <button
        aria-label="User profile"
        class="w-10 h-10 rounded-full bg-white/[0.04] border border-white/10 flex items-center justify-center text-gray-300 hover:text-white hover:bg-white/[0.08] transition"
      >
        <svg class="w-4.5 h-4.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
        </svg>
      </button>

      <!-- Solid Electric Lime CTA Button -->
      <a
        href="/tool/cropper"
        class="h-11 px-5 rounded-xl bg-lumina-lime hover:bg-lumina-lime-bright text-[#050605] font-extrabold text-sm transition-all flex items-center gap-2 shadow-sm hover:shadow active:scale-95"
      >
        <svg class="w-4 h-4 fill-current text-[#050605]" viewBox="0 0 24 24">
          <path d="M19 12h-2v3h-3v2h5v-5zM7 9h3V7H5v5h2V9zm14-6H3c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h18c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm0 16.01H3V4.99h18v14.02z"/>
        </svg>
        <span class="whitespace-nowrap font-black">Live Canvas Resizer</span>
      </a>
    </div>

  </div>
</header>
