<script>
  // Mobile Menu Toggle logic
  const menuBtn = document.getElementById('mobile-menu-btn');
  const searchBtn = document.getElementById('mobile-header-search-btn');
  const navMenu = document.getElementById('mobile-nav-menu');
  const mobileSearchInput = document.getElementById('mobile-search-input') as HTMLInputElement | null;

  if (menuBtn && navMenu) {
    menuBtn.addEventListener('click', () => {
      navMenu.classList.toggle('hidden');
    });
  }

  // Mobile Header Search Button click: open drawer and focus search
  if (searchBtn && navMenu && mobileSearchInput) {
    searchBtn.addEventListener('click', () => {
      navMenu.classList.remove('hidden');
      setTimeout(() => {
        mobileSearchInput.focus();
        mobileSearchInput.select();
      }, 50);
    });
  }

  // Mobile Search Enter Key submit
  if (mobileSearchInput) {
    mobileSearchInput.addEventListener('keydown', (e) => {
      if (e.key === 'Enter') {
        const query = mobileSearchInput.value.trim();
        if (query) {
          window.location.href = `/wallpapers?search=${encodeURIComponent(query)}`;
        }
      }
    });
  }

  // Desktop search input Enter Key submit
  const desktopSearchInput = document.getElementById('global-search-input') as HTMLInputElement | null;
  if (desktopSearchInput) {
    desktopSearchInput.addEventListener('keydown', (e) => {
      if (e.key === 'Enter') {
        const query = desktopSearchInput.value.trim();
        if (query) {
          window.location.href = `/wallpapers?search=${encodeURIComponent(query)}`;
        }
      }
    });
  }

  // Keyboard shortcut for search focus (Cmd/Ctrl + K)
  window.addEventListener('keydown', (e) => {
    if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'k') {
      e.preventDefault();
      const searchInput = document.getElementById('global-search-input') as HTMLInputElement | null;
      if (searchInput && window.innerWidth >= 768) {
        searchInput.focus();
        searchInput.select();
      } else if (mobileSearchInput && navMenu) {
        navMenu.classList.remove('hidden');
        mobileSearchInput.focus();
        mobileSearchInput.select();
      }
    }
  });
</script>
