---
interface Props {
  className?: string;
}

const { className = '' } = Astro.props;

interface CategoryItem {
  name: string;
  slug: string;
  image?: string | null;
  isAll?: boolean;
}

// Exactly matches the Hero capsule strip categories from CategoryStrip.astro
const categoryList: CategoryItem[] = [
  {
    name: 'All',
    slug: 'all',
    isAll: true,
  },
  {
    name: 'AMOLED Black',
    slug: 'amoled-black',
    image: '/images/mockup_cards/cat-amoled.webp',
  },
  {
    name: 'Cyberpunk',
    slug: 'cyberpunk-neon',
    image: '/images/mockup_cards/card-2-neondrive.webp',
  },
  {
    name: '4K UHD',
    slug: '4k-ultra-hd',
    image: '/images/mockup_cards/cat-4k.webp',
  },
  {
    name: 'HD Wallpapers',
    slug: 'hd-wallpapers',
    image: '/images/mockup_cards/cat-minimalist.webp',
  },
  {
    name: 'Movies & TV',
    slug: 'movies',
    image: '/images/mockup_cards/card-3-shadowrealm.webp',
  },
  {
    name: 'TV Shows',
    slug: 'tv-shows',
    image: '/images/mockup_cards/card-2-neondrive.webp',
  },
  {
    name: 'Anime',
    slug: 'anime-gaming',
    image: '/images/mockup_cards/card-3-shadowrealm.webp',
  },
  {
    name: 'Space & Cosmic',
    slug: 'space-cosmic',
    image: '/images/mockup_cards/card-4-cosmichorizon.webp',
  },
  {
    name: 'Nature',
    slug: 'nature-scenery',
    image: '/images/mockup_cards/card-1-mountain.webp',
  },
  {
    name: 'Cars & Bikes',
    slug: 'cars-supercars',
    image: '/images/mockup_cards/card-6-nightbeast.webp',
  },
  {
    name: 'Cartoons',
    slug: 'cartoon',
    image: '/images/mockup_cards/cat-anime.webp',
  },
  {
    name: 'Music & Bands',
    slug: 'music',
    image: '/images/mockup_cards/card-2-neondrive.webp',
  },
  {
    name: 'Minimalist',
    slug: 'minimalist-abstract',
    image: '/images/mockup_cards/cat-minimalist.webp',
  },
  {
    name: 'Animals',
    slug: 'animals-wildlife',
    image: '/images/mockup_cards/card-5-forestcalm.webp',
  },
  {
    name: 'Cityscapes',
    slug: 'city-architecture',
    image: '/images/mockup_cards/cat-cyberpunk.webp',
  },
  {
    name: 'Gaming',
    slug: 'gaming',
    image: '/images/mockup_cards/cat-cyberpunk.webp',
  },
  {
    name: 'Sports',
    slug: 'sports',
    image: '/images/mockup_cards/cat-cars.webp',
  },
  {
    name: 'Superheroes',
    slug: 'superheroes',
    image: '/images/mockup_cards/card-3-shadowrealm.webp',
