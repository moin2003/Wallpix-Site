---
import type { Wallpaper } from '../data/wallpapers';
import GalleryWallpaperCard from './GalleryWallpaperCard.astro';
import AdCard from './AdCard.astro';

interface Props {
  wallpapers: Wallpaper[];
}

const { wallpapers } = Astro.props;
---

<section class="w-full max-w-lumina mx-auto px-4 sm:px-6 lg:px-[38px] pt-3 pb-12">
  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-3">
    {wallpapers.map((wp, index) => {
      // Insert AdCard at index 5 (Row 2, Column 2 in a 4-column layout)
      const showAd = index === 5;
      return (
        <>
          {showAd && <AdCard />}
          <GalleryWallpaperCard wallpaper={wp} priority={index < 8} />
        </>
      );
    })}
  </div>
</section>
