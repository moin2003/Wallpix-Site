// Combine curated list and all subTopics to give an exhaustive WallpaperCat-level directory
const curatedMap = new Map<string, SubFolderItem>();
(CURATED_CATEGORY_FOLDERS[categorySlug] || []).forEach(item => {
  curatedMap.set(item.slug, item);
});

let folderList: SubFolderItem[] = [];

if (subTopics.length > 0) {
  folderList = subTopics.map((topic) => {
    if (curatedMap.has(topic.slug)) {
      return curatedMap.get(topic.slug)!;
    }
    const topicCover = (topic as any).cover;
    return {
      name: topic.name,
      slug: topic.slug,
      count: topic.count.includes('Wallpapers') ? topic.count : `${topic.count} Wallpapers`,
      badge: `${categoryName} Hub`,
      thumb: topicCover || 'https://wallpapercat.com/w/full/f/9/6/1302353-3840x2160-desktop-4k-anime-background-image.jpg'
    };
  });
} else if (CURATED_CATEGORY_FOLDERS[categorySlug]) {
  folderList = CURATED_CATEGORY_FOLDERS[categorySlug];
}
---

{folderList.length > 0 && (
  <section class={`w-full px-4 sm:px-8 lg:px-12 pt-4 sm:pt-6 pb-6 sm:pb-8 ${className}`}>
    
