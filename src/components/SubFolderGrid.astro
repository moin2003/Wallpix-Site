        <div class="w-7 h-7 sm:w-8 sm:h-8 rounded-lg sm:rounded-xl bg-walpix-lime/10 border border-walpix-lime/30 flex items-center justify-center text-walpix-lime text-sm sm:text-base shrink-0">
          <svg class="w-3.5 h-3.5 sm:w-4 sm:h-4 text-walpix-lime" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 7v10a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-6l-2-2H5a2 2 0 00-2 2z" />
          </svg>
        </div>
        <div>
          <h2 class="text-sm sm:text-lg font-bold text-white tracking-wide font-display flex items-center gap-2">
            <span>{categoryName} Series & Collections</span>
            <span class="text-[10px] sm:text-xs font-mono px-2 py-0.5 rounded-full bg-white/10 text-walpix-lime font-bold">
              {folderList.length} Hubs
            </span>
          </h2>
          <p class="text-[11px] sm:text-xs text-[#8E949E] mt-0.5 line-clamp-1 sm:line-clamp-none">
            Click any series or character card to explore all dedicated 4K wallpapers
          </p>
        </div>
      </div>
    </div>

    <!-- 2-Column Mobile & 3-Column Desktop Visual Cards Grid -->
    <div class="grid grid-cols-2 sm:grid-cols-2 lg:grid-cols-3 gap-2.5 sm:gap-6" id="subfolder-cards-grid">
      {folderList.map((folder, index) => {
        // High-RPM Strategic In-Feed Native Ad Slots at position 6 and position 18
        const showAd = index === 5 || index === 17;
        const isInitiallyHidden = index >= 24;
        return (
          <>
            <a
              href={`/tag/${folder.slug}`}
              class={`group relative block aspect-[16/10] sm:aspect-[16/9] w-full rounded-xl sm:rounded-2xl overflow-hidden bg-[#070b12] border border-white/[0.10] hover:border-walpix-lime/60 shadow-lg hover:shadow-[0_10px_30px_rgba(194,255,6,0.22)] transition-all duration-300 hover:-translate-y-1.5 cursor-pointer select-none ${isInitiallyHidden ? 'subfolder-extra hidden' : ''}`}
              data-index={index}
            >
              <!-- Full-Bleed Image -->
              <img
                src={getOptimizedThumbUrl(folder.thumb, 480, 80)}
                alt={`${folder.name} 4K Wallpapers Collection`}
                width="480"
                height="270"
                loading={index < 4 ? 'eager' : 'lazy'}
                fetchpriority={index < 4 ? 'high' : 'low'}
                decoding="async"
                class="absolute inset-0 w-full h-full object-cover group-hover:scale-108 transition-transform duration-700 ease-out"
                onerror="this.src='/images/placeholder-wallpaper.webp'"
              />
              
              <!-- Cinematic Dark Gradient Overlay -->
              <div class="absolute inset-0 bg-gradient-to-t from-black via-black/45 to-transparent"></div>

              <!-- Top Badge (Optional) -->
              {folder.badge && (
                <div class="absolute top-2 sm:top-3 left-2 sm:left-3 z-10">
                  <span class="px-1.5 sm:px-2.5 py-0.5 sm:py-1 rounded-md sm:rounded-lg bg-black/75 backdrop-blur-md border border-white/15 text-[9px] sm:text-[10px] font-mono text-gray-200 shadow-md">
                    {folder.badge}
                  </span>
                </div>
              )}

              <!-- Folder Icon (Top Right) -->
              <div class="absolute top-2 sm:top-3 right-2 sm:right-3 z-10 w-6 h-6 sm:w-8 sm:h-8 rounded-lg sm:rounded-xl bg-black/60 backdrop-blur-md border border-white/15 flex items-center justify-center text-[10px] sm:text-xs text-walpix-lime group-hover:bg-walpix-lime group-hover:text-black transition-all shadow-md">
                <svg class="w-3.5 h-3.5 sm:w-4 sm:h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 7v10a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-6l-2-2H5a2 2 0 00-2 2z" />
                </svg>
              </div>

              <!-- Bottom Card Content Area (Title + Count) -->
              <div class="absolute inset-x-0 bottom-0 p-2.5 sm:p-5 z-10 space-y-0.5 sm:space-y-1">
                <h3 class="text-xs sm:text-base lg:text-lg font-bold text-white group-hover:text-walpix-lime transition-colors truncate leading-tight drop-shadow-md">
                  {folder.name}
                </h3>
                <div class="flex items-center justify-between">
                  <span class="text-[10px] sm:text-xs font-mono text-gray-300 group-hover:text-white transition-colors">
                    {folder.count}
                  </span>
                  <span class="hidden sm:flex text-xs font-bold text-walpix-lime items-center gap-1 opacity-0 group-hover:opacity-100 transition-opacity">
                    <span>Explore</span>
                    <span>→</span>
                  </span>
                </div>
              </div>
            </a>

            {showAd && (
              <div class="col-span-1 aspect-[16/10] sm:aspect-[16/9] w-full">
                <AdCard />
              </div>
            )}
          </>
        );
      })}
    </div>

    <!-- Progressive Expansion for Large Categories like Anime (383 Hubs) -->
    {folderList.length > 24 && (
      <div id="subfolder-expand-container" class="flex flex-col items-center justify-center pt-8 pb-2">
        <button
          id="subfolder-expand-btn"
          type="button"
          class="group inline-flex items-center gap-2.5 px-8 py-3 rounded-full bg-[#080B0F] hover:bg-walpix-lime text-white hover:text-[#050608] border border-white/10 hover:border-walpix-lime font-mono text-xs font-bold transition-all duration-300 shadow-lg cursor-pointer select-none active:scale-95"
        >
          <span>Explore All {folderList.length} Series & Collections</span>
          <svg class="w-3.5 h-3.5 text-walpix-lime group-hover:text-[#050608] transition-transform group-hover:translate-y-0.5 duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7" />
          </svg>
        </button>
        <p class="text-[11px] font-mono text-zinc-400 mt-2">
          Showing <span id="subfolder-visible-count" class="text-walpix-lime font-bold">24</span> of <span class="text-white font-bold">{folderList.length}</span> Handpicked Series Hubs
        </p>
      </div>
    )}

  </section>
)}

<script>
  const expandBtn = document.getElementById('subfolder-expand-btn');
  const expandContainer = document.getElementById('subfolder-expand-container');
  if (expandBtn) {
    expandBtn.addEventListener('click', () => {
      const hiddenCards = document.querySelectorAll('.subfolder-extra');
      hiddenCards.forEach((card) => {
        card.classList.remove('hidden');
        card.classList.remove('subfolder-extra');
      });
      if (expandContainer) {
        expandContainer.style.display = 'none';
      }
    });
  }
</script>
