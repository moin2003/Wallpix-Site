<script>
  function setupSubFolderControls() {
    const grid = document.getElementById('subfolder-cards-grid');
    if (!grid) return;

    const cards = Array.from(grid.querySelectorAll('.subfolder-card')) as HTMLElement[];
    const loadMoreBtn = document.getElementById('subfolder-load-more-btn');
    const showAllBtn = document.getElementById('subfolder-show-all-btn');
    const remainingSpan = document.getElementById('subfolder-remaining-count');
    const searchInput = document.getElementById('subfolder-search-input') as HTMLInputElement | null;
    const actionsWrap = document.getElementById('subfolder-actions-wrap');

    let currentlyShown = 36;
    const BATCH_SIZE = 24;

    function updateRemaining() {
      const hiddenCount = cards.filter(c => c.getAttribute('data-hidden') === 'true').length;
      if (remainingSpan) {
        remainingSpan.textContent = `${hiddenCount} Remaining`;
      }
      if (hiddenCount === 0 && actionsWrap) {
        actionsWrap.style.display = 'none';
      }
    }

    if (loadMoreBtn) {
      loadMoreBtn.onclick = () => {
        let revealed = 0;
        for (const card of cards) {
          if (card.getAttribute('data-hidden') === 'true') {
            card.setAttribute('data-hidden', 'false');
            card.classList.remove('hidden');
            card.style.display = '';
            revealed++;
            if (revealed >= BATCH_SIZE) break;
          }
        }
        currentlyShown += revealed;
        updateRemaining();
      };
    }

    if (showAllBtn) {
      showAllBtn.onclick = () => {
        for (const card of cards) {
          card.setAttribute('data-hidden', 'false');
          card.classList.remove('hidden');
          card.style.display = '';
        }
        currentlyShown = cards.length;
        updateRemaining();
      };
    }

    if (searchInput) {
      searchInput.oninput = (e) => {
        const query = (e.target as HTMLInputElement).value.trim().toLowerCase();
        if (!query) {
          cards.forEach((card, idx) => {
            if (idx < currentlyShown) {
              card.setAttribute('data-hidden', 'false');
              card.classList.remove('hidden');
              card.style.display = '';
            } else {
              card.setAttribute('data-hidden', 'true');
              card.classList.add('hidden');
              card.style.display = 'none';
            }
          });
          if (actionsWrap && currentlyShown < cards.length) {
            actionsWrap.style.display = 'flex';
          }
          updateRemaining();
          return;
        }

        cards.forEach((card) => {
          const name = card.getAttribute('data-name') || '';
          if (name.includes(query)) {
            card.classList.remove('hidden');
            card.style.display = '';
          } else {
            card.classList.add('hidden');
            card.style.display = 'none';
          }
        });

        if (actionsWrap) {
          actionsWrap.style.display = 'none';
        }
      };
    }
  }

  // Initialize immediately and on view transitions
  setupSubFolderControls();
  document.addEventListener('astro:page-load', setupSubFolderControls);
</script>
