const defaultUniversalFallbacks = [
  'https://wallpapercat.com/w/full/7/c/2/180013-3840x2160-desktop-4k-porsche-wallpaper.jpg',
  'https://wallpapercat.com/w/full/5/a/0/306069-3840x2160-desktop-4k-interstellar-wallpaper.jpg',
  'https://wallpapercat.com/w/full/5/d/f/2614-3840x2160-desktop-4k-cyberpunk-2077-wallpaper-photo.jpg',
  'https://w.wallhaven.cc/full/xe/wallhaven-xekje3.png',
  'https://w.wallhaven.cc/full/qr/wallhaven-qrppoq.png'
];

const categoryFallbacks = CATEGORY_FALLBACK_IMAGES[categorySlug] || defaultUniversalFallbacks;

// Combine curated list and all subTopics to give an exhaustive WallpaperCat-level directory
const curatedMap = new Map<string, SubFolderItem>();
(CURATED_CATEGORY_FOLDERS[categorySlug] || []).forEach(item => {
  const liveCount = getLiveSubTopicCount(item.slug);
  curatedMap.set(item.slug, {
    ...item,
    count: liveCount > 0 ? `${liveCount} Wallpapers` : item.count
  });
});

let folderList: SubFolderItem[] = [];

if (subTopics.length > 0) {
  folderList = subTopics.map((topic, i) => {
    const liveCount = getLiveSubTopicCount(topic.slug);
    const countDisplay = liveCount > 0 
      ? `${liveCount} Wallpapers` 
      : (topic.count.includes('Wallpapers') ? topic.count : `${topic.count} Wallpapers`);

    const topicCover = (topic as any).cover;
    if (curatedMap.has(topic.slug)) {
      const cur = curatedMap.get(topic.slug)!;
      return {
        ...cur,
        count: countDisplay,
        thumb: topicCover || cur.thumb
      };
    }
    return {
      name: topic.name,
      slug: topic.slug,
      count: countDisplay,
      badge: `${categoryName} Hub`,
      thumb: topicCover || categoryFallbacks[i % categoryFallbacks.length]
    };
  });
} else if (CURATED_CATEGORY_FOLDERS[categorySlug]) {
  folderList = (CURATED_CATEGORY_FOLDERS[categorySlug] || []).map(item => {
    const liveCount = getLiveSubTopicCount(item.slug);
    return {
      ...item,
      count: liveCount > 0 ? `${liveCount} Wallpapers` : item.count
    };
  });
}

const INITIAL_DISPLAY = 36;
