---
import { LUXURY_COLORS } from '../data/wallpapers';

interface Props {
  activeColor?: string;
}

const { activeColor } = Astro.props;
---

<div id="color-explorer" class="w-full max-w-[1480px] mx-auto px-4 sm:px-6 lg:px-8 py-6">
  <div class="glass-panel rounded-2xl p-5 sm:p-6 border border-white/5 relative overflow-hidden">
    
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 mb-4">
      <div>
        <div class="flex items-center gap-2">
          <span class="text-neon-lime text-lg">✦</span>
          <h2 class="text-base sm:text-lg font-bold text-white tracking-wide">
            Aesthetic Color Explorer
          </h2>
        </div>
        <p class="text-xs text-gray-400 mt-0.5">
          Filter high-res wallpapers by curated luxury two-tone color palettes
        </p>
      </div>

      <!-- Quick Reset Link -->
      {activeColor && (
        <a
          href="/"
          class="text-xs text-neon-pink hover:underline font-medium inline-flex items-center gap-1 self-start md:self-auto"
        >
          ✕ Clear color filter
        </a>
      )}
    </div>

    <!-- 10 Two-Tone Color Chips Grid -->
    <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-5 gap-3">
      {LUXURY_COLORS.map((color) => {
        const isSelected = activeColor === color.slug;
        return (
          <a
            href={`/color/${color.slug}`}
            class={`group relative flex items-center gap-3 p-2.5 rounded-xl border transition-all duration-300 ${
              isSelected
                ? 'bg-obsidian-800 border-neon-lime shadow-glow-lime scale-[1.02]'
                : 'bg-obsidian-850/60 border-white/5 hover:border-white/20 hover:bg-obsidian-800'
            }`}
          >
            <!-- Dual Color Capsule Preview -->
            <div class="flex items-center -space-x-1 shrink-0">
              <span
                class="w-5 h-5 rounded-full border border-black/40 shadow-sm"
                style={`background-color: ${color.hexPrimary};`}
              ></span>
              <span
                class="w-5 h-5 rounded-full border border-black/40 shadow-sm"
                style={`background-color: ${color.hexAccent};`}
              ></span>
            </div>

            <div class="flex flex-col min-w-0">
              <span class="text-xs font-semibold text-gray-200 group-hover:text-white truncate">
                {color.name}
              </span>
              <span class="text-[10px] font-mono text-gray-500 uppercase">
                {color.hexAccent}
              </span>
            </div>
          </a>
        );
      })}
    </div>
  </div>
</div>
