---
import type { Wallpaper } from '../data/wallpapers';

interface Props {
  wallpaper: Wallpaper;
  priority?: boolean;
}

const { wallpaper, priority = false } = Astro.props;

// Generate realistic like counts from views/downloads
const likesCount = ((wallpaper.downloads || 450) * 1.8 / 100).toFixed(1) + 'K';
---

<div
  class="group relative aspect-square w-full wallpaper-card cursor-pointer flex flex-col justify-between"
  data-title={wallpaper.title.toLowerCase()}
  data-category={wallpaper.category?.toLowerCase() || ''}
  data-tags={(wallpaper.tags || []).join(' ').toLowerCase()}
>
  <a
    href={`/wallpapers/${wallpaper.slug}`}
    class="absolute inset-0 w-full h-full block overflow-hidden"
  >
    <!-- Wallpaper Image -->
    <img
      src={wallpaper.sourceCdn}
      alt={wallpaper.title}
      loading={priority ? 'eager' : 'lazy'}
      decoding="async"
      referrerpolicy="no-referrer"
      class="w-full h-full object-cover select-none"
      onerror="this.src='https://images.unsplash.com/photo-1618005182384-a83a8bd57fbe?w=800&q=80'"
    />

    <!-- Top Left: 4K Glass Badge -->
    <div class="absolute top-3 left-3 z-20 pointer-events-none">
      <span class="px-2.5 py-1 rounded-lg bg-[#050607]/80 backdrop-blur-md border border-white/10 text-[11px] font-bold text-white tracking-wide shadow-sm">
        4K
      </span>
    </div>

    <!-- Bottom Cinematic Gradient Overlay -->
    <div class="absolute inset-0 wallpaper-overlay pointer-events-none z-10"></div>

    <!-- Bottom Metadata (Title, Category, Likes) -->
    <div class="absolute bottom-0 inset-x-0 p-3 sm:p-3.5 z-20 flex items-end justify-between gap-2 pointer-events-none">
      <div class="min-w-0">
        <h3 class="text-[13px] sm:text-sm font-semibold text-white truncate leading-tight group-hover:text-lumina-lime transition-colors">
          {wallpaper.title}
        </h3>
        <p class="text-[11px] text-[#A6ABB1] truncate mt-0.5 font-normal">
          {wallpaper.category || '4K UHD'}
        </p>
      </div>

      <!-- Likes Counter with Heart -->
      <div class="flex items-center gap-1 text-[11px] sm:text-xs text-[#E0E2E5] font-medium shrink-0 pb-0.5">
        <svg class="w-3.5 h-3.5 text-lumina-pink group-hover:scale-110 transition-transform" fill="currentColor" viewBox="0 0 24 24">
          <path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z" />
        </svg>
        <span>{likesCount}</span>
      </div>
    </div>
  </a>
</div>
