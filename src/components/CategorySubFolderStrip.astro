          <span class="hidden sm:inline-block px-2 py-0.5 rounded-full bg-walpix-lime/10 border border-walpix-lime/30 text-[10px] text-walpix-lime font-mono font-semibold">
            {catData.totalCount}
          </span>
        </div>
        <a
          href={catData.hubUrl}
          class="group inline-flex items-center gap-1.5 text-[11px] sm:text-xs text-walpix-lime font-semibold hover:underline"
        >
          <span>Explore Complete {catData.name} Hub</span>
          <svg class="w-3.5 h-3.5 group-hover:translate-x-0.5 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
          </svg>
        </a>
      </div>

      <!-- Track -->
      <div class="relative w-full flex items-center gap-1.5 sm:gap-2">
        <button class="strip-left-btn hidden sm:flex items-center justify-center shrink-0 select-none z-20 hover:scale-110 transition-all duration-200 cursor-pointer text-walpix-lime p-0.5" aria-label="Scroll left">
          <svg class="w-6 h-6 text-walpix-lime drop-shadow-[0_0_8px_rgba(194,255,6,0.6)]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M15 19l-7-7 7-7" />
          </svg>
        </button>

        <div class="strip-scroll-track flex items-center gap-2.5 sm:gap-3 overflow-x-auto no-scrollbar scroll-smooth py-1 px-1 flex-grow min-w-0 select-none cursor-grab">
          {catData.subFolders.map((folder) => (
            <a
              href={`/tag/${folder.slug}`}
              data-subfolder-tag={folder.tagQuery || folder.slug}
              class="subfolder-chip group relative shrink-0 h-[52px] sm:h-[56px] min-w-[170px] sm:min-w-[195px] rounded-xl overflow-hidden border border-white/10 hover:border-walpix-lime/70 hover:shadow-[0_4px_20px_rgba(194,255,6,0.25)] hover:-translate-y-0.5 transition-all duration-300 select-none flex items-center px-3 py-2 cursor-pointer"
            >
              <img src={folder.thumb} alt={folder.name} class="absolute inset-0 w-full h-full object-cover group-hover:scale-110 transition-transform duration-500 ease-out" loading="lazy" />
              <div class="absolute inset-0 bg-gradient-to-r from-black/85 via-black/60 to-black/75 group-hover:from-black/70 group-hover:via-black/50 group-hover:to-black/65 transition-colors"></div>
              <div class="relative z-10 flex flex-col justify-center min-w-0 w-full">
                <div class="flex items-center justify-between gap-1 w-full">
                  <span class="text-xs sm:text-[13px] font-bold text-white group-hover:text-walpix-lime transition-colors truncate drop-shadow-[0_2px_4px_rgba(0,0,0,0.8)]">
                    {folder.name}
                  </span>
                </div>
                <div class="flex items-center gap-2 mt-0.5">
                  <span class="text-[10px] text-zinc-300/90 font-medium">
                    {folder.count}
                  </span>
                  {folder.badge && (
                    <span class="text-[9px] px-1.5 py-0.2 rounded bg-walpix-lime/20 text-walpix-lime font-mono">
                      {folder.badge}
                    </span>
                  )}
                </div>
              </div>
            </a>
          ))}
        </div>

        <button class="strip-right-btn hidden sm:flex items-center justify-center shrink-0 select-none z-20 hover:scale-110 transition-all duration-200 cursor-pointer text-walpix-lime p-0.5" aria-label="Scroll right">
          <svg class="w-6 h-6 text-walpix-lime drop-shadow-[0_0_8px_rgba(194,255,6,0.6)]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7" />
          </svg>
        </button>
      </div>
    </div>
  ))}
</div>

<style>
  .strip-scroll-track {
    -webkit-overflow-scrolling: touch;
    touch-action: pan-x pan-y;
    overscroll-behavior-x: contain;
    scrollbar-width: none;
    -ms-overflow-style: none;
    contain: paint;
  }
  .strip-scroll-track::-webkit-scrollbar {
    display: none;
  }
</style>

<script>
  // Initialize drag & scroll for all tracks
  const tracks = document.querySelectorAll<HTMLElement>('.strip-scroll-track');
  tracks.forEach((track) => {
    const parent = track.closest('.relative');
    if (!parent) return;
    const leftBtn = parent.querySelector<HTMLButtonElement>('.strip-left-btn');
    const rightBtn = parent.querySelector<HTMLButtonElement>('.strip-right-btn');

    function updateArrowState() {
      if (!track || !leftBtn || !rightBtn) return;
      const scrollLeft = track.scrollLeft;
      const maxScroll = track.scrollWidth - track.clientWidth;

      if (scrollLeft <= 5) {
        leftBtn.style.opacity = '0.3';
        leftBtn.style.pointerEvents = 'none';
      } else {
        leftBtn.style.opacity = '1';
        leftBtn.style.pointerEvents = 'auto';
      }

      if (maxScroll > 0 && scrollLeft >= maxScroll - 5) {
        rightBtn.style.opacity = '0.3';
        rightBtn.style.pointerEvents = 'none';
      } else {
        rightBtn.style.opacity = '1';
        rightBtn.style.pointerEvents = 'auto';
      }
    }

    updateArrowState();
    track.addEventListener('scroll', updateArrowState);
    window.addEventListener('resize', updateArrowState);

    leftBtn?.addEventListener('click', () => {
      track.scrollBy({ left: -320, behavior: 'smooth' });
    });

    rightBtn?.addEventListener('click', () => {
      track.scrollBy({ left: 320, behavior: 'smooth' });
    });

    // Mouse wheel horizontal scroll
    track.addEventListener('wheel', (e) => {
      if (e.deltaY !== 0) {
        e.preventDefault();
        track.scrollLeft += e.deltaY;
      }
    }, { passive: false });

    // Mouse drag-to-scroll
    let isDown = false;
    let startX = 0;
    let scrollLeft = 0;
    let moved = false;

    track.addEventListener('mousedown', (e) => {
      isDown = true;
      moved = false;
      track.style.cursor = 'grabbing';
      startX = e.pageX - track.offsetLeft;
      scrollLeft = track.scrollLeft;
    });

    window.addEventListener('mouseup', () => {
      isDown = false;
      track.style.cursor = 'grab';
    });

    track.addEventListener('mousemove', (e) => {
      if (!isDown) return;
      e.preventDefault();
      moved = true;
      const x = e.pageX - track.offsetLeft;
      const walk = (x - startX) * 1.5;
      track.scrollLeft = scrollLeft - walk;
    });

    track.addEventListener('click', (e) => {
      if (moved) {
        e.preventDefault();
        e.stopPropagation();
      }
    }, true);
  });
</script>
