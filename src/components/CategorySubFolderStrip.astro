<div id="dynamic-subfolder-container" class="w-full px-3 sm:px-6 lg:px-10 py-2">
  
  <!-- DEFAULT: Global Trending Topic Hubs (shown when 'all' is active) -->
  <div id="subfolder-strip-all" class="subfolder-group-view block transition-opacity duration-300">
    <div class="flex items-center justify-between gap-3 mb-2 px-1">
      <div class="flex items-center gap-2">
        <span class="inline-flex items-center justify-center w-5 h-5 rounded-md bg-walpix-lime/10 text-walpix-lime text-xs font-bold">
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
          </svg>
        </span>
        <span class="text-xs sm:text-sm font-bold text-white tracking-wide">Popular Screen & Resolution Hubs</span>
        <span class="hidden sm:inline-block px-2 py-0.5 rounded-full bg-white/5 border border-white/10 text-[10px] text-zinc-400 font-mono">
          50k+ Curated
        </span>
      </div>
      <a
        href="/topics"
        class="group inline-flex items-center gap-1 text-[11px] sm:text-xs text-walpix-lime font-semibold hover:underline"
      >
        <span>All 18+ Topic Hubs</span>
        <svg class="w-3.5 h-3.5 group-hover:translate-x-0.5 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
        </svg>
      </a>
    </div>

    <!-- Track -->
    <div class="relative w-full flex items-center gap-1.5 sm:gap-2">
      <button class="strip-left-btn hidden sm:flex items-center justify-center shrink-0 select-none z-20 hover:scale-110 transition-all duration-200 cursor-pointer text-walpix-lime p-0.5" aria-label="Scroll left">
        <svg class="w-6 h-6 text-walpix-lime drop-shadow-[0_0_8px_rgba(194,255,6,0.6)]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M15 19l-7-7 7-7" />
        </svg>
      </button>

      <div class="strip-scroll-track flex items-center gap-2.5 sm:gap-3 overflow-x-auto no-scrollbar scroll-smooth py-1 px-1 flex-grow min-w-0 select-none cursor-grab">
        {TOPIC_HUBS.map((topic) => (
          <a
            href={`/topic/${topic.slug}`}
            class="group relative shrink-0 h-[48px] sm:h-[52px] min-w-[150px] sm:min-w-[170px] rounded-xl overflow-hidden border border-white/10 hover:border-walpix-lime/60 hover:shadow-[0_4px_16px_rgba(194,255,6,0.2)] hover:-translate-y-0.5 transition-all duration-300 select-none flex items-center px-3 py-2"
          >
            <img src={topic.cover} alt={topic.name} class="absolute inset-0 w-full h-full object-cover group-hover:scale-110 transition-transform duration-500 ease-out" loading="lazy" />
            <div class="absolute inset-0 bg-gradient-to-r from-black/75 via-black/55 to-black/70 group-hover:from-black/60 group-hover:via-black/40 group-hover:to-black/55 transition-colors"></div>
            <div class="relative z-10 flex flex-col justify-center min-w-0">
              <span class="text-xs sm:text-[13px] font-bold text-white group-hover:text-walpix-lime transition-colors truncate drop-shadow-[0_2px_4px_rgba(0,0,0,0.8)]">
                {topic.name}
              </span>
              <span class="text-[10px] text-zinc-300/80 font-mono truncate">
                {topic.badge}
              </span>
            </div>
          </a>
        ))}
      </div>

      <button class="strip-right-btn hidden sm:flex items-center justify-center shrink-0 select-none z-20 hover:scale-110 transition-all duration-200 cursor-pointer text-walpix-lime p-0.5" aria-label="Scroll right">
        <svg class="w-6 h-6 text-walpix-lime drop-shadow-[0_0_8px_rgba(194,255,6,0.6)]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7" />
        </svg>
      </button>
    </div>
  </div>

  <!-- DYNAMIC: Category Specific Sub-Folders & Franchises (Swapped dynamically on Category Pill Click) -->
  {Object.entries(CATEGORY_SUBFOLDERS).map(([catKey, catData]) => (
    <div
      id={`subfolder-strip-${catKey}`}
      class="subfolder-group-view hidden transition-opacity duration-300"
    >
      <div class="flex items-center justify-between gap-3 mb-2 px-1">
        <div class="flex items-center gap-2">
          <span class="inline-flex items-center justify-center w-5 h-5 rounded-md bg-walpix-lime/10 text-walpix-lime text-xs font-bold">
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 7v10a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-6l-2-2H5a2 2 0 00-2 2z" />
            </svg>
          </span>
          <span class="text-xs sm:text-sm font-bold text-white tracking-wide">
            {catData.name} Sub-Folders & Franchises
