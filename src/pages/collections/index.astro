const schema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'Themed Wallpaper Collections & Aesthetic Packs (4K UHD) | WALPIX 4K',
  url: 'https://walpix.site/collections',
};
---

<Layout
  title="Themed Wallpaper Collections & Aesthetic Packs (4K UHD) | WALPIX 4K"
  description="Explore handpicked 4K wallpaper packs and curated split-collage collections for dual monitors, OLED screens, gaming setups, and smartphone lock screens."
  schema={schema}
>
  <Header currentCategory="collections" />

  <main class="min-h-screen bg-[#020406] pb-20">
    <!-- Header Hero Banner (Edge-to-Edge Fluid) -->
    <section class="relative w-full px-4 sm:px-8 lg:px-12 pt-10 pb-8 text-center border-b border-white/[0.06] bg-gradient-to-b from-[#060a0f] to-[#020406]">
      <div class="max-w-3xl mx-auto space-y-3">
        <span class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[#C2FF06]/10 border border-[#C2FF06]/30 text-xs font-mono font-bold text-[#C2FF06] tracking-wide uppercase shadow-sm">
          <span class="w-1.5 h-1.5 rounded-full bg-[#C2FF06] shadow-[0_0_6px_#C2FF06]"></span>
          <span>Curated Wallpaper Packs & Sets</span>
        </span>
        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-black text-white tracking-tight">
          Featured <span class="text-walpix-lime">Collections</span> & Packs
        </h1>
        <p class="text-sm sm:text-base text-[#8E949E] leading-relaxed">
          Explore multi-image curated collections for gaming battlestations, anime universes, exotic supercars, and OLED screens. Every pack formatted in native 4K UHD.
        </p>
      </div>
    </section>

    <!-- Top High-RPM AdSense Placement with 30px Safe Margin -->
    <div class="w-full px-4 sm:px-8 lg:px-12 my-6">
      <AdSenseLeaderboard slotId="collections-top-leaderboard" />
    </div>

    <!-- Thematic Clusters with Split-Collage Cards -->
    <div class="w-full px-4 sm:px-8 lg:px-12 space-y-16 pt-4">
      {thematicClusters.map((cluster) => (
        <section class="space-y-6">
          <!-- Section Heading -->
          <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-2 pb-3 border-b border-white/[0.08]">
            <div>
              <span class="text-xs font-mono font-bold text-walpix-lime uppercase tracking-widest block mb-1">
                {cluster.categoryKicker}
              </span>
              <h2 class="text-2xl font-bold text-white tracking-tight flex items-center gap-2">
                <span>{cluster.categoryTitle}</span>
              </h2>
            </div>
            <span class="text-xs font-mono text-[#8E949E]">
              {cluster.cards.length} Thematic Packs
            </span>
          </div>

          <!-- 4-Column Responsive Split-Collage Grid -->
          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
            {cluster.cards.map((card) => (
              <CollageCollectionCard
                title={card.title}
                category={card.category}
                count={card.count}
                href={card.href}
                images={card.images}
                description={card.description}
              />
            ))}
          </div>
        </section>
      ))}
    </div>

    <!-- Mid/Bottom AdSense Placement with 30px Safe Margin -->
    <div class="w-full px-4 sm:px-8 lg:px-12 my-10">
      <AdSenseLeaderboard slotId="collections-bottom-leaderboard" />
    </div>
  </main>

  <Footer />
</Layout>
