---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import MobileSponsorBanner from '../components/MobileSponsorBanner.astro';
import BrowseByCategory from '../components/BrowseByCategory.astro';
import AdSenseLeaderboard from '../components/AdSenseLeaderboard.astro';
import RelatedSearchWidget from '../components/RelatedSearchWidget.astro';
import TopicStrip from '../components/TopicStrip.astro';
import WallpaperGrid from '../components/WallpaperGrid.astro';
import OrientationToggle from '../components/OrientationToggle.astro';
import ColorPaletteFilter from '../components/ColorPaletteFilter.astro';
import Footer from '../components/Footer.astro';
import { wallpapers } from '../data/wallpapers';

// Category diversification function: picks 2 items per category in continuous round-robin
// Guarantees balanced variety across Anime, Gaming, Cars, Nature, AMOLED, Cyberpunk, Movies, etc.
function diversifyByCategories(items: Wallpaper[], maxTotal: number, perBatch = 2): Wallpaper[] {
  const byCat = new Map<string, Wallpaper[]>();
  for (const item of items) {
    const cat = item.category || 'Other';
    if (!byCat.has(cat)) byCat.set(cat, []);
    byCat.get(cat)!.push(item);
  }

  const result: Wallpaper[] = [];
  const catEntries = Array.from(byCat.entries());
  let offset = 0;

  while (result.length < maxTotal) {
    let addedAny = false;
    for (const [, arr] of catEntries) {
      for (let k = 0; k < perBatch; k++) {
        const itemIdx = offset + k;
        if (itemIdx < arr.length && result.length < maxTotal) {
          result.push(arr[itemIdx]);
          addedAny = true;
        }
      }
    }
    if (!addedAny) break;
    offset += perBatch;
  }
  return result;
}

// 1. Desktop 16:9 Showcase: Rich 64 diverse wallpapers across all categories
const desktopPool = wallpapers.filter(w => w.aspectRatio === '16:9' || (!w.aspectRatio?.includes('9:16') && !w.aspectRatio?.includes('vertical')));
const desktopWps = diversifyByCategories(desktopPool, 64, 2);

// 2. Mobile 9:16 Showcase: Rich 64 diverse vertical phone wallpapers across all categories
const allMobilePool = wallpapers.filter(w => w.aspectRatio === '9:16' || w.aspectRatio === 'vertical');
const mobileWps = diversifyByCategories(allMobilePool, 64, 2);

const trendingWallpapers: typeof wallpapers = [...desktopWps, ...mobileWps];

// Device Format Auto-Detection:
// On PC/Desktop: defaults to 'desktop' (hiding phone cards)
// On Mobile: defaults to 'phone' (hiding desktop cards)
// Explicit URL query ?format= always takes highest priority
const userAgent = Astro.request.headers.get('user-agent') || '';
const isMobileUA = /mobile|iphone|ipod|android|blackberry|opera mini|iemobile|wpdesktop/i.test(userAgent);
const queryFormat = (Astro.url.searchParams.get('format') || '').toLowerCase().trim();
const detectedFormat = (queryFormat === 'all' || queryFormat === 'desktop' || queryFormat === 'phone' || queryFormat === 'dual')
  ? queryFormat
  : (isMobileUA ? 'phone' : 'desktop');

const schema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'WALPIX 4K Wallpapers',
  url: 'https://www.walpix.site',
  description: 'Download free ultra HD 4K, 2K and AMOLED wallpapers for desktop and mobile with instant live canvas cropper.',
  potentialAction: {
    '@type': 'SearchAction',
    target: 'https://www.walpix.site/?search={search_term_string}',
    'query-input': 'required name=search_term_string',
  },
};
---

<Layout
  title="WALPIX 4K - Ultra HD Wallpapers For Every Screen"
  description="Discover a world of breathtaking 4K wallpapers. From minimal elegance to epic digital worlds — all free, always."
  preloadImage="/images/hero-astronaut-master.webp"
  schema={schema}
>
  <!-- Floating Glass Capsule Header -->
  <Header currentCategory="all" />
  
  <main class="min-h-screen bg-[#030405]">
    <!-- Cinematic Hero Section (includes embedded Category Strip) -->
    <Hero />

    <!-- Mobile Sponsor Ad Placement Banner (Under Hero for Mobile Screens) -->
    <MobileSponsorBanner className="sm:hidden" />

    <!-- Browse by Category Section (Moved up directly under Hero for Mobile Screens) -->
    <BrowseByCategory className="sm:hidden" />

    <!-- 1. Google AdSense Top Dual-Banner Showcase (Tablet & Desktop) -->
    <AdSenseLeaderboard className="hidden sm:block pt-4 pb-3" variant="top" />

    <!-- 2. Sleek Popular Searches Discovery Strip (After Browse by Category on Mobile, Under AdSense on Desktop) -->
    <RelatedSearchWidget className="pt-2 pb-1 sm:pt-2 sm:pb-2" />

    <!-- Ultra-Luxury Glass Device Switcher Bar -->
    <div class="w-full px-4 sm:px-8 lg:px-12 pt-1 pb-2">
      <OrientationToggle activeFormat={detectedFormat} />
    </div>

    <!-- 3. Trending 4K Wallpapers Grid (4 Columns with In-Grid Native Ad) -->
    <WallpaperGrid
      wallpapers={trendingWallpapers}
      gridMode={detectedFormat}
      enableLoadMore={false}
      maxDomCount={128}
      totalCount={wallpapers.length}
      title="Trending Wallpapers"
      subtitle="Handpicked ultra HD wallpapers, updated daily."
    />

    <!-- High-Intent Topics & Resolution Strip (8K, 4K, 1080p, PC, Laptop, Mobile, Brands) -->
    <section class="w-full px-4 sm:px-8 lg:px-12 pt-4 pb-8">
      <div class="flex items-center justify-between mb-3">
        <div class="flex items-center gap-2">
          <span class="w-2 h-2 rounded-full bg-walpix-lime shadow-[0_0_8px_#C2FF06]"></span>
          <h2 class="text-xs sm:text-sm font-bold uppercase tracking-wider text-white">Popular Wallpaper Topics</h2>
        </div>
        <a href="/topics" class="text-xs text-walpix-lime hover:underline font-semibold flex items-center gap-1">
          All Topics & Resolutions →
        </a>
      </div>
      <TopicStrip cardSize="large" />
    </section>

    <!-- 4. Google AdSense Bottom Leaderboard Banner (Minimalist Sponsor Banner) -->
    <AdSenseLeaderboard
      className="py-4"
      variant="bottom"
      adSlot="9876543210"
    />

    <!-- 5. Luxury Color Explorer Module -->
    <ColorPaletteFilter />
  </main>

  <Footer />
</Layout>

