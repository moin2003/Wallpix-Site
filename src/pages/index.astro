---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import MobileSponsorBanner from '../components/MobileSponsorBanner.astro';
import BrowseByCategory from '../components/BrowseByCategory.astro';
import AdSenseLeaderboard from '../components/AdSenseLeaderboard.astro';
import RelatedSearchWidget from '../components/RelatedSearchWidget.astro';
import TopicStrip from '../components/TopicStrip.astro';
import WallpaperGrid from '../components/WallpaperGrid.astro';
import OrientationToggle from '../components/OrientationToggle.astro';
import ColorPaletteFilter from '../components/ColorPaletteFilter.astro';
import Footer from '../components/Footer.astro';
import { wallpapers, type Wallpaper } from '../data/wallpapers';

// Device Format Auto-Detection:
// On PC/Desktop: defaults to 'desktop' (hiding phone cards)
// On Mobile: defaults to 'phone' (hiding desktop cards)
// Explicit URL query ?format= always takes highest priority
const userAgent = Astro.request.headers.get('user-agent') || '';
const isMobileUA = /mobile|iphone|ipod|android|blackberry|opera mini|iemobile|wpdesktop/i.test(userAgent);
const queryFormat = (Astro.url.searchParams.get('format') || '').toLowerCase().trim();
const detectedFormat = (queryFormat === 'all' || queryFormat === 'desktop' || queryFormat === 'phone' || queryFormat === 'dual')
  ? queryFormat
  : (isMobileUA ? 'phone' : 'desktop');

// High visual quality scoring: prioritizes 4K/2K resolution and high view/download engagement
function score(w: Wallpaper): number {
  let s = (w.views || 0) + (w.downloads || 0) * 2;
  const res = w.resolution || '';
  if (res.includes('3840') || res.includes('4K') || res.includes('2160')) s += 50000;
  if (res.includes('2560') || res.includes('1440')) s += 20000;
  return s;
}

function isAspect(w: Wallpaper, type: 'desktop' | 'phone'): boolean {
  const a = w.aspectRatio || '';
  const is916 = a === '9:16' || a.includes('9:16') || a.includes('vertical');
  if (type === 'phone') return is916;
  return !is916 && !a.includes('32:9');
}

// 10 Curated Elite Buckets specifically tailored for high-contrast homepage aesthetics:
// 1. Spider-Man & Superhero Red Suit (Miles Morales, Peter Parker, Iron Man, Batman)
// 2. Anime & Aesthetics (Iconic characters, stunning aesthetic anime landscapes)
// 3. AMOLED Black & Dark Matte (Pitch black, dark matte textures, ultra OLED contrast)
// 4. Minimalist & Abstract (3D fluid forms, modern geometric renders, clean curves)
// 5. Space & Cosmic (Deep space nebulae, James Webb cosmos, astronauts, planets)
// 6. Cyberpunk & Neon (Futuristic neon cities, rainy streets, synthwave aesthetics)
// 7. Gaming & Action (Elden Ring, God of War, GTA, Witcher, Cyberpunk 2077)
// 8. Luxury & Supercars (Porsche, Lamborghini, Ferrari, McLaren, BMW drift)
// 9. Nature & Landscapes (Aurora Borealis, mist pines, alpine peaks, ocean bioluminescence)
// 10. Fantasy & Mythical (Dragons, glowing celestial realms, enchanted worlds)
const curatedBuckets = [
  { key: 'spiderman', test: (w: Wallpaper) => /spider|peter parker|miles morales|iron man|batman/i.test(w.title) || Boolean(w.tags && w.tags.some((t: string) => /spider|miles-morales|peter-parker|marvel/i.test(t))) },
  { key: 'anime', test: (w: Wallpaper) => w.category === 'Anime & Manga' && !/spider|iron man|batman/i.test(w.title) },
  { key: 'amoled', test: (w: Wallpaper) => w.category === 'AMOLED Black' || /amoled|pitch black|dark matte|matte black/i.test(w.title) },
  { key: 'abstract', test: (w: Wallpaper) => w.category === 'Minimalist & Abstract' || /abstract|minimal|3d render|fluid/i.test(w.title) },
  { key: 'space', test: (w: Wallpaper) => w.category === 'Space & Cosmic' || /space|cosmic|galaxy|nebula|astronaut/i.test(w.title) },
  { key: 'cyberpunk', test: (w: Wallpaper) => (w.category === 'Cyberpunk & Neon' || /cyberpunk|neon|synthwave/i.test(w.title)) && w.category !== 'Anime & Manga' },
  { key: 'gaming', test: (w: Wallpaper) => w.category === 'Gaming' || /gaming|gta|witcher|elden ring|god of war/i.test(w.title) },
  { key: 'supercars', test: (w: Wallpaper) => w.category === 'Cars & Bikes' || /supercar|porsche|lamborghini|ferrari|bmw|audi/i.test(w.title) },
  { key: 'nature', test: (w: Wallpaper) => (w.category === 'Nature & Landscapes' || w.category === 'Nature & Scenery' || /aurora|mountain|landscape|forest/i.test(w.title)) && w.category !== 'Anime & Manga' },
  { key: 'fantasy', test: (w: Wallpaper) => w.category === 'Fantasy & Mythical' || /fantasy|mythical|dragon/i.test(w.title) }
];

function buildCuratedShowcase(items: Wallpaper[], type: 'desktop' | 'phone', targetCount = 96): Wallpaper[] {
  const seenIds = new Set<string>();
  const bucketPools = curatedBuckets.map(b => {
    const matched = items
      .filter(w => isAspect(w, type) && b.test(w))
      .sort((a, b) => score(b) - score(a));
    return { ...b, matched, idx: 0 };
  });

  const result: Wallpaper[] = [];
  while (result.length < targetCount) {
    let addedAny = false;
    for (const b of bucketPools) {
      if (result.length >= targetCount) break;
      while (b.idx < b.matched.length) {
        const item = b.matched[b.idx++];
        if (!seenIds.has(item.id)) {
          seenIds.add(item.id);
          result.push(item);
          addedAny = true;
          break;
        }
      }
    }
    if (!addedAny) break;
  }
  return result;
}

// 96 Curated Masterpieces for Desktop (24 complete rows of 4 columns)
const desktopCurated = buildCuratedShowcase(wallpapers, 'desktop', 96);

// 96 Curated Masterpieces for Mobile (48 complete rows of 2 columns)
const mobileCurated = buildCuratedShowcase(wallpapers, 'phone', 96);

// Prioritize active device format first for instant server-rendered presentation
const trendingWallpapers: typeof wallpapers = detectedFormat === 'phone'
  ? [...mobileCurated, ...desktopCurated]
  : [...desktopCurated, ...mobileCurated];

const schema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'WALPIX 4K Wallpapers',
  url: 'https://www.walpix.site',
  description: 'Download free ultra HD 4K, 2K and AMOLED wallpapers for desktop and mobile with instant live canvas cropper.',
  potentialAction: {
    '@type': 'SearchAction',
    target: 'https://www.walpix.site/?search={search_term_string}',
    'query-input': 'required name=search_term_string',
  },
};
---

<Layout
  title="WALPIX 4K - Ultra HD Wallpapers For Every Screen"
  description="Discover a world of breathtaking 4K wallpapers. From minimal elegance to epic digital worlds — all free, always."
  preloadImage="/images/hero-astronaut-master.webp"
  schema={schema}
>
  <!-- Floating Glass Capsule Header -->
  <Header currentCategory="all" />
  
  <main class="min-h-screen bg-[#030405]">
    <!-- Cinematic Hero Section (includes embedded Category Strip) -->
    <Hero />

    <!-- Mobile Sponsor Ad Placement Banner (Under Hero for Mobile Screens) -->
    <MobileSponsorBanner className="sm:hidden" />

    <!-- Browse by Category Section (Moved up directly under Hero for Mobile Screens) -->
    <BrowseByCategory className="sm:hidden" />

    <!-- 1. Google AdSense Top Dual-Banner Showcase (Tablet & Desktop) -->
    <AdSenseLeaderboard className="hidden sm:block pt-4 pb-3" variant="top" />

    <!-- 2. Sleek Popular Searches Discovery Strip (After Browse by Category on Mobile, Under AdSense on Desktop) -->
    <RelatedSearchWidget className="pt-2 pb-1 sm:pt-2 sm:pb-2" />

    <!-- Ultra-Luxury Glass Device Switcher Bar -->
    <div class="w-full px-4 sm:px-8 lg:px-12 pt-1 pb-2">
      <OrientationToggle activeFormat={detectedFormat} />
    </div>

    <!-- 3. Trending 4K Wallpapers Grid (4 Columns with In-Grid Native Ad) -->
    <WallpaperGrid
      wallpapers={trendingWallpapers}
      gridMode={detectedFormat}
      enableLoadMore={false}
      maxDomCount={200}
      totalCount={wallpapers.length}
      title="Trending Wallpapers"
      subtitle="Handpicked ultra HD wallpapers, updated daily."
    />

    <!-- High-Intent Topics & Resolution Strip (8K, 4K, 1080p, PC, Laptop, Mobile, Brands) -->
    <section class="w-full px-4 sm:px-8 lg:px-12 pt-4 pb-8">
      <div class="flex items-center justify-between mb-3">
        <div class="flex items-center gap-2">
          <span class="w-2 h-2 rounded-full bg-walpix-lime shadow-[0_0_8px_#C2FF06]"></span>
          <h2 class="text-xs sm:text-sm font-bold uppercase tracking-wider text-white">Popular Wallpaper Topics</h2>
        </div>
        <a href="/topics" class="text-xs text-walpix-lime hover:underline font-semibold flex items-center gap-1">
          All Topics & Resolutions →
        </a>
      </div>
      <TopicStrip cardSize="large" />
    </section>

    <!-- 4. Google AdSense Bottom Leaderboard Banner (Minimalist Sponsor Banner) -->
    <AdSenseLeaderboard
      className="py-4"
      variant="bottom"
      adSlot="9876543210"
    />

    <!-- 5. Luxury Color Explorer Module -->
    <ColorPaletteFilter />
  </main>

  <Footer />
</Layout>

