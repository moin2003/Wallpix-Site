---
import Layout from '../../../layouts/Layout.astro';
import Header from '../../../components/Header.astro';
import WallpaperCard from '../../../components/WallpaperCard.astro';
import GalleryWallpaperCard from '../../../components/GalleryWallpaperCard.astro';
import AdSenseLeaderboard from '../../../components/AdSenseLeaderboard.astro';
import CollageCollectionCard from '../../../components/CollageCollectionCard.astro';
import Footer from '../../../components/Footer.astro';
import { ADSENSE_CONFIG } from '../../../config/adsense';
import { MAIN_CATEGORIES } from '../../../data/taxonomy';
import { getAllTags, getWallpapersByTag, slugifyTag, wallpapers, getLiveSubTopicCount } from '../../../data/wallpapers';
import { getOptimizedThumbUrl } from '../../../utils/imageOptimizer';

export async function getStaticPaths() {
  const tagCounts = new Map<string, number>();
  wallpapers.forEach((w) => {
    const seen = new Set<string>();
    (w.tags || []).forEach((t) => {
      const s = slugifyTag(t);
      if (s && !seen.has(s)) {
        seen.add(s);
        tagCounts.set(s, (tagCounts.get(s) || 0) + 1);
      }
    });
  });

  const paths: any[] = [];
  MAIN_CATEGORIES.forEach((cat) => {
    const catSlug = cat.slug || cat.id;
    const subs = cat.subTopics || [];
    subs.forEach((sub) => {
      const sSlug = slugifyTag(sub.slug);
      const directCount = tagCounts.get(sSlug) || 0;
      const parsedCount = parseInt(String(sub.count).replace(/[^0-9]/g, '')) || 24;
      const count = directCount > 0 ? directCount : parsedCount;
      paths.push({
        params: { category: catSlug, slug: sSlug },
        props: {
          categoryInfo: { id: cat.id, name: cat.name, slug: catSlug },
          subTopicInfo: { name: sub.name, slug: sSlug, count },
        },
      });
    });
  });

  return paths;
}

interface Props {
  categoryInfo: { id: string; name: string; slug: string };
  subTopicInfo: { name: string; slug: string; count: number };
}

const { category: catParam, slug: subSlug } = Astro.params;
const parentCat = MAIN_CATEGORIES.find(c => c.slug === catParam || c.id === catParam);
const categoryInfo = (Astro.props as any).categoryInfo || { id: parentCat?.id || catParam, name: parentCat?.name || catParam, slug: catParam };
const subTopicInfo = (Astro.props as any).subTopicInfo || { name: (subSlug || '').replace(/-/g, ' ').replace(/\b\w/g, l => l.toUpperCase()), slug: subSlug || '', count: 24 };
const subTopic = subTopicInfo;
const allTags = getAllTags();

// Fetch direct matching wallpapers from catalog
const directMatches = getWallpapersByTag(subTopic.slug);

// Parent category details
const parentCategory = categoryInfo.name;

// Find related wallpapers within the same parent category
const sameCategoryWallpapers = wallpapers.filter(
  (w) =>
    (w.category || '').toLowerCase().includes(categoryInfo.id.toLowerCase()) ||
    (w.category || '').toLowerCase().includes(categoryInfo.slug.toLowerCase())
);

// Fallback stream if direct matches are fewer than 6
const wallpapersList =
  directMatches.length > 0
    ? directMatches
    : sameCategoryWallpapers.slice(0, 18);

// Similar wallpapers for bottom multi-column grid
const streamIds = new Set(wallpapersList.slice(0, 8).map((w) => w.id));
const potentialSimilar = wallpapers.filter(
  (w) =>
    !streamIds.has(w.id) &&
    ((categoryInfo && (w.category || '').toLowerCase().includes(categoryInfo.id.toLowerCase())) ||
      (w.tags && w.tags.some((t) => t.toLowerCase().includes(subTopic.slug) || subTopic.slug.includes(t.toLowerCase()))))
);
const similarWallpapers = Array.from(
  new Set([...potentialSimilar, ...sameCategoryWallpapers.filter((w) => !streamIds.has(w.id))])
).slice(0, 8);

// Intelligent related sibling subtopics from same category
const siblingSubTopics = (MAIN_CATEGORIES.find((c) => c.id === categoryInfo.id)?.subTopics || [])
  .filter((s) => s.slug !== subTopic.slug)
  .slice(0, 18);

function getThumbnailForSub(sSlug: string, index = 0): string {
  const match = wallpapers.find(
    (w) =>
      w.sourceCdn?.startsWith('http') &&
      (w.tags || []).some((t) => slugifyTag(t) === sSlug)
  );
  if (match?.sourceCdn) return match.sourceCdn;
  if (sameCategoryWallpapers[index % sameCategoryWallpapers.length]?.sourceCdn) {
    return sameCategoryWallpapers[index % sameCategoryWallpapers.length].sourceCdn;
  }
  return 'https://wallpapercat.com/w/full/f/9/6/1302353-3840x2160-desktop-4k-anime-background-image.jpg';
}

const relatedTagsWithThumbs = siblingSubTopics.map((sib, i) => {
  const liveCount = getLiveSubTopicCount(sib.slug);
  return {
    name: sib.name,
    slug: sib.slug,
    count: liveCount > 0 ? liveCount : (parseInt((sib as any).count?.replace(/[^0-9]/g, '')) || 24),
    thumb: getThumbnailForSub(sib.slug, i),
  };
});

const discoverMoreSubEntities = relatedTagsWithThumbs.slice(0, 4);
const categorySiblingLinks = relatedTagsWithThumbs.slice(4, 12);
const mostDownloadedRankings = [...wallpapersList]
  .sort((a, b) => (b.downloads || 0) - (a.downloads || 0))
  .slice(0, 5);
const lsiSemanticLinks = relatedTagsWithThumbs.slice(12, 20);

const heroImage = wallpapersList[0]?.sourceCdn || '/images/hero-astronaut-master.png';
const pageTitle = `${subTopic.name} Wallpapers (4K UHD Free Download) - ${categoryInfo.name} | WALPIX 4K`;
const metaDescription = `Download ultra-high definition 4K ${subTopic.name} wallpapers for Windows 11, Mac, iPhone, Android, and dual-monitor battlestations. Curated ultra-resolution collection from ${categoryInfo.name}, 100% free with no watermark.`;

// Runway Collections
const runwayCollections = [
  {
    title: 'Cyberpunk & Night City',
    category: 'Cyberpunk',
    count: 142,
    href: '/collections/cyberpunk-night-city-pack',
    images: [
      'https://wallpapercat.com/w/full/5/d/f/2614-3840x2160-desktop-4k-cyberpunk-2077-wallpaper-photo.jpg',
      'https://images.unsplash.com/photo-1542751371-adc38448a05e?w=800&q=80',
      'https://images.unsplash.com/photo-1511447333015-45b65e60f6d5?w=800&q=80',
    ],
  },
  {
    title: 'Anime Legends & Samurai',
    category: 'Anime',
    count: 215,
    href: '/category/anime/naruto',
    images: [
      'https://wallpapercat.com/w/full/f/9/6/1302353-3840x2160-desktop-4k-anime-background-image.jpg',
      'https://wallpapercat.com/w/full/5/3/1/141742-3840x2160-desktop-4k-naruto-wallpaper-photo.jpg',
      'https://wallpapercat.com/w/full/0/f/4/24693-3840x2160-desktop-4k-jujutsu-kaisen-tv-series-background-photo.jpg',
    ],
  },
  {
    title: 'Track Beasts & Supercars',
    category: 'Cars',
    count: 185,
    href: '/category/cars/nissan-skyline',
    images: [
      'https://images.unsplash.com/photo-1503376780353-7e6692767b70?w=800&q=80',
      'https://images.unsplash.com/photo-1617814076367-b759c7d7e738?w=800&q=80',
      'https://images.unsplash.com/photo-1583121274602-3e2820c69888?w=800&q=80',
    ],
  },
  {
    title: 'Pure Black OLED Void',
    category: 'AMOLED',
    count: 280,
    href: '/collections/amoled-dark-void-pack',
    images: [
      'https://wallpapercat.com/w/full/2/0/9/71103-3840x2160-desktop-4k-red-dead-redemption-wallpaper-image.jpg',
      'https://images.unsplash.com/photo-1518709268805-4e9042af9f23?w=800&q=80',
      'https://wallpapercat.com/w/full/5/d/f/2614-3840x2160-desktop-4k-cyberpunk-2077-wallpaper-photo.jpg',
    ],
  },
];

const schema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: `${subTopic.name} 4K Wallpapers - ${categoryInfo.name}`,
  description: metaDescription,
  url: `https://walpix.site/category/${categoryInfo.slug}/${subTopic.slug}`,
  breadcrumb: {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://walpix.site/' },
      { '@type': 'ListItem', position: 2, name: 'Categories', item: 'https://walpix.site/categories' },
      { '@type': 'ListItem', position: 3, name: categoryInfo.name, item: `https://walpix.site/category/${categoryInfo.slug}` },
      { '@type': 'ListItem', position: 4, name: subTopic.name, item: `https://walpix.site/category/${categoryInfo.slug}/${subTopic.slug}` },
    ],
  },
  mainEntity: {
    '@type': 'ItemList',
    itemListElement: wallpapersList.slice(0, 12).map((wp, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      item: {
        '@type': 'ImageObject',
        name: wp.title,
        contentUrl: wp.sourceCdn,
        url: `https://walpix.site/wallpapers/${wp.slug}`,
      },
    })),
  },
};
---

<Layout
  title={pageTitle}
  description={metaDescription}
  image={heroImage}
  schema={schema}
>
  <!-- Global Navigation Header -->
  <Header />

  <main class="min-h-screen bg-[#020406] text-left">
    <!-- Top Header & Breadcrumbs Section -->
    <section class="relative w-full overflow-hidden bg-[#030508] border-b border-white/[0.08] pt-6 pb-6">
      <!-- Subtle Background Ambient Glow -->
      <div class="absolute inset-0 z-0 pointer-events-none">
        <img
          src={getOptimizedThumbUrl(heroImage, 400, 70)}
          alt={`${subTopic.name} Backdrop Preview`}
          class="w-full h-full object-cover object-center opacity-20 filter blur-md scale-105"
        />
        <div class="absolute inset-0 bg-gradient-to-r from-[#020406] via-[#020406]/95 to-[#020406]/85"></div>
      </div>

      <div class="relative z-10 w-full px-4 sm:px-8 lg:px-12 text-left">
        <!-- Breadcrumbs (Clean, hierarchical silo, 100% matched to URL) -->
        <nav class="flex items-center gap-1.5 sm:gap-2 text-[11px] sm:text-xs text-[#8E949E] font-mono mb-2.5 sm:mb-3 text-left overflow-x-auto no-scrollbar whitespace-nowrap">
          <a href="/" class="hover:text-white transition-colors">Home</a>
          <span>/</span>
          <a href="/categories" class="hover:text-white transition-colors">Categories</a>
          <span>/</span>
          <a href={`/category/${categoryInfo.slug}`} class="hover:text-white transition-colors">
            {categoryInfo.name}
          </a>
          <span>/</span>
          <span class="text-walpix-lime font-bold">{subTopic.name}</span>
        </nav>

        <!-- Main Title & Editor's Note -->
        <div class="space-y-1.5 sm:space-y-2 text-left">
          <div class="flex flex-wrap items-center gap-2 sm:gap-3">
            <h1 class="text-xl sm:text-3xl lg:text-4xl font-black text-white tracking-tight leading-tight">
              {subTopic.name} <span class="text-walpix-lime">Wallpapers</span>
            </h1>
            <span class="px-2 py-0.5 sm:px-2.5 sm:py-0.5 rounded-full bg-walpix-lime/10 border border-walpix-lime/30 text-[10px] sm:text-xs font-mono text-walpix-lime font-bold">
              {wallpapersList.length} 4K Assets
            </span>
          </div>

          <p class="text-[11px] sm:text-sm text-gray-400 max-w-3xl leading-relaxed line-clamp-2 sm:line-clamp-none">
            <span class="text-gray-300 font-semibold">Editor's note:</span> Handpicked ultra HD lossless 4K backgrounds and mobile wallpapers for {subTopic.name}. Free instant download with zero watermarks.
          </p>
        </div>

        <!-- Luxury Interactive Sibling Sub-Topics Carousel -->
        {relatedTagsWithThumbs.length > 0 && (
          <div class="mt-3 sm:mt-5 pt-2.5 sm:pt-4 border-t border-white/[0.08]">
            <div class="tag-strip-wrapper relative w-full flex items-center gap-1.5 sm:gap-2">
              <button
                class="tag-btn-left hidden sm:flex items-center justify-center shrink-0 select-none z-20 hover:scale-110 transition-all duration-200 cursor-pointer text-walpix-lime p-0.5"
                aria-label="Scroll left"
              >
                <svg class="w-6 h-6 text-walpix-lime drop-shadow-[0_0_8px_rgba(194,255,6,0.6)]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M15 19l-7-7 7-7" />
                </svg>
              </button>

              <div class="tag-scroll-track flex items-center gap-2 sm:gap-3.5 overflow-x-auto no-scrollbar scroll-smooth py-1 sm:py-1.5 px-0.5 sm:px-1 flex-grow min-w-0 select-none cursor-grab">
                {relatedTagsWithThumbs.map((rTag) => (
                  <a
                    href={`/category/${categoryInfo.slug}/${rTag.slug}`}
                    class={`group relative shrink-0 h-[38px] sm:h-[52px] min-w-[125px] sm:min-w-[190px] rounded-lg sm:rounded-xl overflow-hidden border transition-all duration-300 select-none flex items-center px-2.5 sm:px-3 py-1.5 sm:py-2 cursor-pointer ${
                      rTag.slug === subTopic.slug
                        ? 'border-walpix-lime ring-1 sm:ring-2 ring-walpix-lime/30 shadow-[0_0_14px_rgba(194,255,6,0.3)]'
                        : 'border-white/10 hover:border-walpix-lime/70 hover:shadow-[0_4px_20px_rgba(194,255,6,0.25)] hover:-translate-y-0.5'
                    }`}
                  >
                    <img
                      src={getOptimizedThumbUrl(rTag.thumb, 320, 80)}
                      alt={rTag.name}
                      class="absolute inset-0 w-full h-full object-cover group-hover:scale-110 transition-transform duration-500 ease-out"
                      loading="lazy"
                    />
                    <div class="absolute inset-0 bg-gradient-to-r from-black/85 via-black/60 to-black/75 group-hover:from-black/70 group-hover:via-black/50 group-hover:to-black/65 transition-colors"></div>

                    <div class="relative z-10 flex flex-col justify-center min-w-0 w-full">
                      <span class="text-[11px] sm:text-[13px] font-bold text-white group-hover:text-walpix-lime transition-colors truncate drop-shadow-[0_2px_4px_rgba(0,0,0,0.8)]">
                        {rTag.name}
                      </span>
                      <span class="text-[9px] sm:text-[10px] text-zinc-300/90 font-mono mt-0.5">
                        {rTag.count} Wallpapers
                      </span>
                    </div>
                  </a>
                ))}
              </div>

              <button
                class="tag-btn-right hidden sm:flex items-center justify-center shrink-0 select-none z-20 hover:scale-110 transition-all duration-200 cursor-pointer text-walpix-lime p-0.5"
                aria-label="Scroll right"
              >
                <svg class="w-6 h-6 text-walpix-lime drop-shadow-[0_0_8px_rgba(194,255,6,0.6)]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7" />
                </svg>
              </button>
            </div>
          </div>
        )}
      </div>
    </section>

    <!-- Tri-Link Architecture Main Content Area -->
    <div class="w-full px-4 sm:px-8 lg:px-12 py-6 sm:py-8">
      <div class="grid grid-cols-1 lg:grid-cols-[290px_minmax(0,1fr)_290px] xl:grid-cols-[320px_minmax(0,1fr)_320px] gap-6 xl:gap-8 items-start">
        
        <!-- LEFT SIDEBAR -->
        <aside class="space-y-6 order-2 lg:order-1 sticky top-24">
          <!-- Discover More -->
          <div class="space-y-3">
            <div class="flex items-center gap-1.5 text-xs font-mono font-bold text-walpix-lime uppercase tracking-wider pb-1">
              <svg class="w-3.5 h-3.5 text-walpix-lime" fill="currentColor" viewBox="0 0 24 24">
                <path d="M12 2l2.4 7.2h7.6l-6 4.8 2.4 7.2-6.4-4.8-6.4 4.8 2.4-7.2-6-4.8h7.6z" />
              </svg>
              <span>Discover More</span>
            </div>

            <div class="grid grid-cols-2 lg:grid-cols-1 gap-2.5 lg:gap-3.5">
              {discoverMoreSubEntities.map((sub) => (
                <a
                  href={`/category/${categoryInfo.slug}/${sub.slug}`}
                  class="group relative block aspect-[16/10] lg:aspect-[16/9] w-full rounded-xl lg:rounded-2xl overflow-hidden bg-[#070b12] border border-white/[0.12] hover:border-walpix-lime/60 shadow-lg hover:shadow-[0_8px_25px_rgba(194,255,6,0.25)] transition-all duration-300 hover:-translate-y-1 cursor-pointer"
                >
                  <img
                    src={getOptimizedThumbUrl(sub.thumb, 400, 80)}
                    alt={sub.name}
                    class="absolute inset-0 w-full h-full object-cover group-hover:scale-108 transition-transform duration-500 ease-out"
                    loading="lazy"
                  />
                  <div class="absolute inset-0 bg-gradient-to-t from-black via-black/50 to-transparent"></div>
                  <div class="absolute inset-x-0 bottom-0 p-2.5 lg:p-3.5 z-10">
                    <h4 class="text-xs lg:text-sm font-bold text-white group-hover:text-walpix-lime truncate transition-colors leading-tight">
                      {sub.name}
                    </h4>
                    <span class="text-[10px] lg:text-[11px] font-mono text-gray-300 group-hover:text-white block mt-0.5">
                      {sub.count} Wallpapers
                    </span>
                  </div>
                </a>
              ))}
            </div>
          </div>

          <!-- Top in Category -->
          <div class="p-3.5 sm:p-4 rounded-xl lg:rounded-2xl bg-[#070a0f]/90 border border-white/[0.10] space-y-2.5 shadow-lg">
            <div class="pb-2 border-b border-white/[0.08]">
              <h3 class="text-xs font-mono font-bold text-gray-200 uppercase tracking-wider flex items-center gap-1.5">
                <svg class="w-3.5 h-3.5 text-walpix-lime" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 17L17 7M17 7H7M17 7v10" />
                </svg>
                <span>More in {categoryInfo.name}</span>
              </h3>
            </div>

            <div class="flex flex-wrap lg:flex-col gap-1.5 lg:space-y-1.5 text-xs">
              {categorySiblingLinks.map((sib) => (
                <a
                  href={`/category/${categoryInfo.slug}/${sib.slug}`}
                  class="flex items-center justify-between py-1.5 px-2 rounded-lg bg-white/[0.03] lg:bg-transparent text-gray-300 hover:text-walpix-lime hover:bg-white/[0.06] transition-all group font-medium"
                >
                  <span class="group-hover:translate-x-1 transition-transform truncate">
                    {sib.name}
                  </span>
                  <span class="text-[10px] font-mono text-gray-500 group-hover:text-walpix-lime shrink-0 pl-1">
                    {sib.count}
                  </span>
                </a>
              ))}
            </div>
          </div>
        </aside>

        <!-- CENTER COLUMN: Responsive Stream -->
        <section class="order-1 lg:order-2 min-w-0">
          <!-- MOBILE & TABLET (< lg): 2-Column Responsive Wallpaper Grid -->
          <div class="grid grid-cols-2 gap-2.5 sm:gap-4 lg:hidden">
            {wallpapersList.map((wp, index) => (
              <WallpaperCard wallpaper={wp} priority={index < 4} />
            ))}
          </div>

          <!-- DESKTOP (>= lg): 1-Per-Row Large Immersive Stream -->
          <div class="hidden lg:block space-y-8">
            {wallpapersList.map((wp, index) => {
              const showStreamAd = ADSENSE_CONFIG.isLive && (index === 3 || index === 8);
              return (
                <>
                  <div class="group relative rounded-3xl overflow-hidden bg-[#070b12] border border-white/[0.12] hover:border-walpix-lime/60 shadow-2xl transition-all duration-300">
                    <a href={`/wallpapers/${wp.slug}`} class="block relative aspect-[16/9] w-full overflow-hidden bg-black/60 cursor-pointer">
                      <img
                        src={getOptimizedThumbUrl(wp.sourceCdn, 1200, 85)}
                        alt={wp.title}
                        class="w-full h-full object-cover group-hover:scale-[1.02] transition-transform duration-700 ease-out"
                        loading={index < 2 ? 'eager' : 'lazy'}
                      />
                      <div class="absolute inset-0 bg-gradient-to-t from-[#070b12] via-transparent to-black/20 opacity-70 group-hover:opacity-30 transition-opacity"></div>
                      <div class="absolute top-4 left-4 z-10 flex items-center gap-2">
                        <span class="px-3 py-1 rounded-xl bg-black/80 backdrop-blur-md border border-walpix-lime/40 text-xs font-mono font-bold text-walpix-lime shadow-lg">
                          4K UHD
                        </span>
                        <span class="px-2.5 py-1 rounded-xl bg-black/80 backdrop-blur-md border border-white/20 text-xs font-mono text-gray-200 shadow-lg">
                          16:9
                        </span>
                      </div>
                      <div class="absolute bottom-4 left-4 z-10">
                        <span class="px-3 py-1 rounded-xl bg-black/80 backdrop-blur-md border border-white/20 text-xs font-mono text-white font-semibold shadow-lg">
                          3840 × 2160
                        </span>
                      </div>
                    </a>

                    <div class="p-4 sm:p-5 bg-gradient-to-r from-[#040609] via-[#080d14] to-[#040609] flex flex-col md:flex-row md:items-center justify-between gap-4 border-t border-white/[0.08]">
                      <div class="min-w-0">
                        <a href={`/wallpapers/${wp.slug}`}>
                          <h3 class="text-base sm:text-lg font-bold text-white group-hover:text-walpix-lime transition-colors truncate">
                            {wp.title}
                          </h3>
                        </a>
                        <div class="flex items-center gap-2 text-xs text-gray-400 font-mono mt-1">
                          <span class="flex items-center gap-1">
                            <svg class="w-3.5 h-3.5 text-walpix-lime" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
                            </svg>
                            {wp.downloads?.toLocaleString() || '18.4K'} downloads
                          </span>
                          <span>•</span>
                          <span>{wp.views?.toLocaleString() || '45K'} views</span>
                          <span>•</span>
                          <span class="text-walpix-lime font-bold">100% Free 4K</span>
                        </div>
                      </div>

                      <div class="flex items-center flex-wrap sm:flex-nowrap gap-2 sm:gap-2.5 shrink-0 justify-between sm:justify-end">
                        <!-- Creative Tools (Simulation, Resizer, Cropper) -->
                        <div class="flex items-center gap-1.5 sm:gap-2">
                          <a
                            href={`/wallpapers/${wp.slug}#simulation`}
                            class="h-10 px-3 rounded-xl bg-white/[0.04] hover:bg-white/[0.1] border border-white/10 hover:border-walpix-lime/40 text-xs font-semibold text-white/80 hover:text-white flex items-center gap-1.5 transition-all cursor-pointer"
                            title="Live Screen Simulation"
                          >
                            <svg class="w-3.5 h-3.5 text-walpix-lime" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                            </svg>
                            <span class="hidden xl:inline">Simulation</span>
                          </a>

                          <a
