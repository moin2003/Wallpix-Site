---
export const prerender = true;
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<Layout
  title="Contact Us & Feedback"
  description="Contact the WALPIX Wallpapers support and creator relations team."
>
  <Header />

  <main class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="glass-panel rounded-3xl p-8 sm:p-12 border border-white/10 space-y-6">
      <div class="border-b border-white/10 pb-4">
        <h1 class="text-3xl font-display font-black text-white">Contact Us</h1>
        <p class="text-xs text-gray-400 mt-1">Have feedback, wallpaper requests, or copyright inquiries? Send us a message.</p>
      </div>

      <form class="space-y-4" onsubmit="event.preventDefault(); alert('Thank you! Your message has been received.');">
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div>
            <label class="block text-xs font-semibold text-gray-300 mb-1">Your Name</label>
            <input
              type="text"
              required
              placeholder="e.g. John Doe"
              class="w-full px-4 py-2.5 bg-obsidian-850 border border-white/10 rounded-xl text-sm text-white focus:outline-none focus:border-neon-lime"
            />
          </div>
          <div>
            <label class="block text-xs font-semibold text-gray-300 mb-1">Email Address</label>
            <input
              type="email"
              required
              placeholder="you@domain.com"
              class="w-full px-4 py-2.5 bg-obsidian-850 border border-white/10 rounded-xl text-sm text-white focus:outline-none focus:border-neon-lime"
            />
          </div>
        </div>

        <div>
          <label class="block text-xs font-semibold text-gray-300 mb-1">Subject</label>
          <select class="w-full px-4 py-2.5 bg-obsidian-850 border border-white/10 rounded-xl text-sm text-white focus:outline-none focus:border-neon-lime">
            <option>General Feedback / Suggestion</option>
            <option>Wallpaper Submission / Artist Portfolio</option>
            <option>Bug Report / Technical Issue</option>
            <option>Advertising / Business Inquiry</option>
          </select>
        </div>

        <div>
          <label class="block text-xs font-semibold text-gray-300 mb-1">Message</label>
          <textarea
            rows="5"
            required
            placeholder="Write your message details here..."
            class="w-full px-4 py-2.5 bg-obsidian-850 border border-white/10 rounded-xl text-sm text-white focus:outline-none focus:border-neon-lime"
          ></textarea>
        </div>

        <button
          type="submit"
          class="w-full py-3.5 rounded-xl bg-neon-lime text-obsidian-950 font-display font-extrabold text-sm hover:scale-[1.01] transition shadow-glow-lime"
        >
          Send Message
        </button>
      </form>
    </div>
  </main>

  <Footer />
</Layout>
