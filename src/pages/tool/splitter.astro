---
export const prerender = true;
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

// Pristine 4K/Superwide wallpapers for multi-monitor splitting
const sampleWallpapers = [
  {
    title: 'Cyberpunk Tokyo',
    category: 'Cyberpunk',
    url: 'https://images.unsplash.com/photo-1514565131-fce0801e5785?auto=format&fit=crop&w=2400&q=85'
  },
  {
    title: 'Deep Space Horizon',
    category: 'Space',
    url: 'https://images.unsplash.com/photo-1451187580459-43490279c0fa?auto=format&fit=crop&w=2400&q=85'
  },
  {
    title: 'Mountain Serenity',
    category: 'Nature',
    url: '/images/hero-clean.jpg'
  },
  {
    title: 'AMOLED Minimal',
    category: 'AMOLED',
    url: 'https://images.unsplash.com/photo-1618005182384-a83a8bd57fbe?auto=format&fit=crop&w=2400&q=85'
  },
  {
    title: 'Nordic Alpine Sunset',
    category: 'Nature',
    url: 'https://images.unsplash.com/photo-1464822759023-fed622ff2c3b?auto=format&fit=crop&w=2400&q=85'
  },
  {
    title: 'Night Beast GT',
    category: 'Cars',
    url: 'https://images.unsplash.com/photo-1503376780353-7e6692767b70?auto=format&fit=crop&w=2400&q=85'
  },
  {
    title: 'Shadow Samurai',
    category: 'Anime',
    url: 'https://images.unsplash.com/photo-1578632767115-351597cf2477?auto=format&fit=crop&w=2400&q=85'
  },
  {
    title: 'Emerald Calm Lake',
    category: 'Landscape',
    url: 'https://images.unsplash.com/photo-1448375240586-882707db888b?auto=format&fit=crop&w=2400&q=85'
  }
];
---

<Layout
  title="Multi-Monitor Wallpaper Splitter & Slicer Studio - WALPIX 4K"
  description="Span 4K and 8K superwide wallpapers across Dual, Triple, Vertical Streamer, or Ultrawide monitor setups with physical bezel gap compensation and instant 1-click slicing."
>
  <Header currentCategory="tool" />

  <main class="min-h-screen bg-[#030508] text-[#F3F5F7] pb-16 selection:bg-[#00F0FF] selection:text-black">
    
    <!-- Top Header -->
    <div class="w-full max-w-[1780px] mx-auto px-4 sm:px-6 lg:px-8 pt-5 pb-3">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-3 border-b border-white/[0.08]">
        <div class="flex items-center gap-3">
          <div class="w-9 h-9 rounded-xl bg-[#00F0FF]/15 border border-[#00F0FF]/40 flex items-center justify-center text-[#00F0FF] shadow-[0_0_12px_rgba(0,240,255,0.18)]">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
            </svg>
          </div>
          <div>
            <div class="flex items-center gap-2">
              <h1 class="text-xl sm:text-2xl font-display font-bold text-white tracking-tight">
                Multi-Monitor Wallpaper Splitter
              </h1>
              <span class="px-2 py-0.5 rounded text-[10px] font-mono font-bold bg-[#00F0FF]/15 border border-[#00F0FF]/40 text-[#00F0FF] uppercase tracking-wider">
                PRO Studio
              </span>
            </div>
          </div>
        </div>

        <!-- Quick Switcher with Circular Icons -->
        <div class="flex items-center gap-2">
          <a
            href="/tool/cropper"
            class="px-3.5 py-1.5 rounded-xl bg-[#0D121B] hover:bg-[#141B26] border border-white/10 text-xs font-medium text-gray-200 hover:text-white transition flex items-center gap-2 group"
          >
            <span class="w-4 h-4 rounded-full bg-walpix-lime flex items-center justify-center text-[9px] text-black font-bold shadow-sm">
              C
            </span>
            <span>4K Resizer</span>
          </a>
          <a
            href="/tool/avatar"
            class="px-3.5 py-1.5 rounded-xl bg-[#0D121B] hover:bg-[#141B26] border border-white/10 text-xs font-medium text-gray-200 hover:text-white transition flex items-center gap-2 group"
          >
            <span class="w-4 h-4 rounded-full bg-[#FF28B8] flex items-center justify-center text-[9px] text-white font-bold shadow-sm">
              P
            </span>
            <span>Avatar Maker</span>
          </a>
        </div>
      </div>
    </div>

    <!-- Workspace -->
    <div class="w-full max-w-[1780px] mx-auto px-4 sm:px-6 lg:px-8 space-y-4">
      
      <!-- Multi-Monitor Setup Selector -->
      <div class="bg-[#090D14] border border-white/10 rounded-xl p-2.5 shadow-lg">
        <div class="flex items-center gap-2 overflow-x-auto no-scrollbar scroll-smooth">
          <span class="text-[10px] font-mono font-bold uppercase tracking-wider text-gray-400 px-2 shrink-0">Layout:</span>
          
          <button
            data-layout="dual-16-9"
            class="layout-btn is-active px-3 py-2 rounded-xl text-left cursor-pointer transition select-none shrink-0 flex items-center gap-2 bg-[#00F0FF] text-black font-semibold shadow-sm"
          >
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
            <div>
              <div class="text-xs font-bold leading-none">Dual 16:9 (Side-by-Side)</div>
              <div class="text-[10px] font-mono opacity-80">3840×1080 / 7680×2160</div>
            </div>
          </button>

          <button
            data-layout="streamer-left"
            class="layout-btn px-3 py-2 rounded-xl text-left cursor-pointer transition select-none shrink-0 flex items-center gap-2 bg-[#101622] hover:bg-[#161F2E] border border-white/10 text-gray-300"
          >
            <svg class="w-4 h-4 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z"/></svg>
            <div>
              <div class="text-xs font-bold leading-none">Streamer Setup (Left)</div>
              <div class="text-[10px] font-mono text-gray-400">Vertical 9:16 + Main 16:9</div>
            </div>
          </button>

          <button
            data-layout="streamer-right"
            class="layout-btn px-3 py-2 rounded-xl text-left cursor-pointer transition select-none shrink-0 flex items-center gap-2 bg-[#101622] hover:bg-[#161F2E] border border-white/10 text-gray-300"
          >
            <svg class="w-4 h-4 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
            <div>
              <div class="text-xs font-bold leading-none">Streamer Setup (Right)</div>
              <div class="text-[10px] font-mono text-gray-400">Main 16:9 + Vertical 9:16</div>
            </div>
          </button>

          <button
            data-layout="triple-16-9"
            class="layout-btn px-3 py-2 rounded-xl text-left cursor-pointer transition select-none shrink-0 flex items-center gap-2 bg-[#101622] hover:bg-[#161F2E] border border-white/10 text-gray-300"
          >
            <svg class="w-4 h-4 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8h18M3 16h18M3 8v8M21 8v8"/></svg>
            <div>
              <div class="text-xs font-bold leading-none">Triple Monitor (3 × 16:9)</div>
              <div class="text-[10px] font-mono text-gray-400">Panoramic 5760×1080 / 11520×2160</div>
            </div>
          </button>

          <button
            data-layout="ultrawide-plus-16-9"
            class="layout-btn px-3 py-2 rounded-xl text-left cursor-pointer transition select-none shrink-0 flex items-center gap-2 bg-[#101622] hover:bg-[#161F2E] border border-white/10 text-gray-300"
          >
            <svg class="w-4 h-4 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 18h16M4 6v12M20 6v12"/></svg>
            <div>
              <div class="text-xs font-bold leading-none">Ultrawide 21:9 + 16:9</div>
              <div class="text-[10px] font-mono text-gray-400">3440×1440 + 2560×1440</div>
            </div>
          </button>
        </div>
      </div>

      <!-- Main Two-Column Workbench -->
      <div class="grid grid-cols-1 lg:grid-cols-[minmax(0,1fr)_390px] xl:grid-cols-[minmax(0,1fr)_420px] gap-5 items-start">
        
        <!-- Left: Stage Viewer with Physical Monitor Bezels -->
        <div class="space-y-3">
          
          <div class="bg-[#090D14] border border-white/10 rounded-xl overflow-hidden shadow-2xl">
            
            <!-- Stage Top Bar -->
            <div class="px-4 py-2.5 bg-[#0D121B] border-b border-white/10 flex items-center justify-between gap-3">
              <div class="flex items-center gap-2.5">
                <span class="w-2.5 h-2.5 rounded-full bg-[#00F0FF]"></span>
                <span id="layout-title" class="text-xs font-mono font-bold text-white">Dual 16:9 Monitors</span>
                <span id="splitter-source-res" class="text-[11px] font-mono text-gray-400 ml-2 hidden sm:inline">Source: 3840 × 2160</span>
              </div>

              <!-- Quick Reset Action -->
              <div class="flex items-center gap-1.5">
                <button id="btn-reset-splitter" class="px-3 py-1 rounded-lg bg-[#131A26] hover:bg-[#1B2536] border border-white/10 text-xs font-semibold text-gray-300 hover:text-white transition cursor-pointer">
                  Reset Alignment
                </button>
              </div>
            </div>

            <!-- Grand Monitor Stage (Responsive Mobile Height) -->
            <div id="splitter-stage" class="relative w-full h-[340px] sm:h-[480px] lg:h-[700px] xl:h-[760px] bg-[#020305] flex items-center justify-center overflow-x-auto overflow-y-hidden select-none p-3 sm:p-6 md:p-8 touch-pan-x no-scrollbar">
              
              <!-- Checkered Subgrid Background -->
              <div class="absolute inset-0 opacity-10 bg-[radial-gradient(#fff_1px,transparent_1px)] [background-size:16px_16px] pointer-events-none"></div>

              <!-- Realistic Physical Monitors Stage Container -->
              <div id="monitors-container" class="relative flex items-end justify-center gap-2 sm:gap-4 md:gap-5 transition-all duration-300 min-w-min">
                <!-- Dynamically Rendered Physical Monitors with Stands -->
              </div>

              <!-- Floating Bottom Tip -->
              <div class="absolute bottom-3 left-4 right-4 flex items-center justify-between pointer-events-none text-[11px] text-gray-400">
                <span class="bg-black/80 px-2.5 py-1 rounded-md border border-white/10">Wallpaper spans seamlessly across physical screens</span>
                <span class="bg-black/80 px-2 py-1 rounded-md border border-white/10 font-mono">Live Slices</span>
              </div>

            </div>

          </div>

          <!-- Curated Pristine 4K Wallpapers -->
          <div class="bg-[#090D14] border border-white/10 rounded-xl p-3 shadow-lg">
            <div class="flex items-center justify-between mb-2">
              <span class="text-xs font-bold text-gray-300">Quick Test With Wallpapers:</span>
              <span class="text-[10px] text-gray-400">Click to load instantly</span>
            </div>
            <div class="grid grid-cols-4 sm:grid-cols-8 gap-2">
              {sampleWallpapers.map((wp) => (
                <button
                  type="button"
                  data-sample-url={wp.url}
                  class="sample-splitter-btn group relative aspect-video rounded-lg overflow-hidden border border-white/10 hover:border-[#00F0FF] transition cursor-pointer"
                >
                  <img
                    src={wp.url}
                    alt={wp.title}
                    class="w-full h-full object-cover group-hover:scale-105 transition-transform"
                    loading="lazy"
                  />
                  <div class="absolute inset-0 bg-black/40 group-hover:bg-transparent transition-colors"></div>
                  <span class="absolute bottom-1 left-1 right-1 text-[9px] font-medium text-white truncate px-1 py-0.5 rounded bg-black/70">
                    {wp.title}
                  </span>
                </button>
              ))}
            </div>
          </div>

        </div>

        <!-- Right: Control Panel -->
        <div class="space-y-4">
          
          <!-- Image Upload & Dropzone Area -->
          <div class="bg-[#090D14] border border-white/10 rounded-xl p-4 space-y-3 shadow-lg">
            <div class="flex items-center justify-between">
              <h3 class="text-xs font-bold text-gray-200 uppercase tracking-wider font-mono">Source Wallpaper</h3>
              <div class="flex gap-1 text-[11px]">
                <button id="tab-splitter-upload" class="px-2 py-0.5 rounded text-[#00F0FF] font-bold bg-[#00F0FF]/10">Upload File</button>
                <button id="tab-splitter-url" class="px-2 py-0.5 rounded text-gray-400 hover:text-white">Direct URL</button>
              </div>
            </div>

            <!-- Drag & Drop Zone Box -->
            <div id="splitter-dropzone-box" class="relative border-2 border-dashed border-white/15 hover:border-[#00F0FF]/50 rounded-xl p-5 text-center cursor-pointer transition-colors bg-[#0D121B]/50">
              <input id="splitter-file-input" type="file" accept="image/*" class="absolute inset-0 opacity-0 cursor-pointer w-full h-full z-10" />
              <div class="flex flex-col items-center justify-center gap-2 pointer-events-none">
                <div class="w-10 h-10 rounded-xl bg-[#00F0FF]/10 border border-[#00F0FF]/40 flex items-center justify-center text-[#00F0FF] shadow-[0_0_12px_rgba(0,240,255,0.15)]">
                  <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4-4m0 0L8 8m4-4v12"/></svg>
                </div>
                <div>
                  <div class="text-xs font-bold text-white">Choose or drag panoramic wallpaper</div>
                  <div class="text-[10px] text-gray-400 mt-0.5">PNG, JPG, WebP up to 100MB (or Ctrl+V)</div>
                </div>
              </div>
            </div>

            <!-- Direct URL Input -->
            <div id="splitter-url-box" class="hidden space-y-2 pt-1">
              <div class="flex gap-1.5">
                <input
                  id="splitter-url-input"
                  type="url"
                  placeholder="https://example.com/panoramic-4k.jpg"
                  class="flex-1 px-3 py-2 rounded-lg bg-[#06080D] border border-white/15 text-xs text-white placeholder-gray-500 focus:outline-none focus:border-[#00F0FF] font-mono"
                />
                <button
                  id="btn-splitter-load-url"
                  class="px-3.5 py-2 rounded-lg bg-[#00F0FF] hover:bg-[#00d0de] text-black text-xs font-bold transition cursor-pointer"
                >
                  Load
                </button>
              </div>
            </div>
          </div>

          <!-- Alignment & Bezel Settings -->
          <div class="bg-[#090D14] border border-white/10 rounded-xl p-4 space-y-4 shadow-lg">
            
            <!-- Bezel Gap Compensation -->
            <div>
              <div class="flex items-center justify-between text-[11px] text-gray-400 mb-1 font-mono">
                <span>Physical Bezel Gap</span>
                <span id="bezel-gap-text" class="text-[#00F0FF] font-bold">12 px</span>
              </div>
              <input
                id="bezel-slider"
                type="range"
                min="0"
                max="60"
                value="12"
                class="w-full accent-[#00F0FF] cursor-pointer"
              />
              <p class="text-[10px] text-gray-500 mt-1">Compensates for the physical plastic border between your monitors.</p>
            </div>

            <!-- Vertical Framing Offset -->
            <div>
              <div class="flex items-center justify-between text-[11px] text-gray-400 mb-1 font-mono">
                <span>Vertical Framing</span>
                <span id="offset-y-text" class="text-gray-300 font-semibold">Center (50%)</span>
              </div>
              <input
                id="offset-y-slider"
                type="range"
                min="0"
                max="100"
                value="50"
                class="w-full accent-[#00F0FF] cursor-pointer"
              />
            </div>

            <!-- Download CTA: All Screens -->
            <button
              id="btn-download-all-screens"
              type="button"
              class="w-full py-4 px-4 rounded-xl bg-[#00F0FF] hover:bg-[#00d0de] active:scale-[0.99] text-black font-extrabold text-sm tracking-wide transition cursor-pointer shadow-[0_0_20px_rgba(0,240,255,0.3)] flex items-center justify-center gap-2"
            >
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"/></svg>
              <span>Download All Screens (Auto)</span>
            </button>

            <!-- Individual Screen Downloads -->
            <div class="space-y-2 pt-2 border-t border-white/10">
              <span class="text-[10px] font-mono text-gray-400 uppercase tracking-wider block font-bold">Individual Screen Downloads:</span>
              <div id="individual-download-buttons" class="grid grid-cols-2 gap-2">
                <!-- Dynamically populated buttons -->
              </div>
            </div>

            <div class="text-[11px] text-center text-gray-500 flex items-center justify-center gap-1.5 pt-1">
              <svg class="w-3.5 h-3.5 text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
              <span>Lossless Multi-Monitor Slices • Zero Compression</span>
            </div>

          </div>

        </div>

      </div>

    </div>

    <!-- Hidden Export Canvas -->
    <canvas id="splitter-export-canvas" class="hidden"></canvas>
  </main>

  <Footer />
</Layout>

<script>
  interface ScreenSpec {
    id: string;
    name: string;
    w: number;
    h: number;
    aspectRatio: number;
    isVertical?: boolean;
  }

  interface LayoutSpec {
    title: string;
    screens: ScreenSpec[];
  }

  const LAYOUT_CONFIGS: Record<string, LayoutSpec> = {
    'dual-16-9': {
      title: 'Dual 16:9 Monitors (Side-by-Side)',
      screens: [
        { id: 'left', name: 'Screen 1 (Left)', w: 3840, h: 2160, aspectRatio: 16 / 9 },
        { id: 'right', name: 'Screen 2 (Right)', w: 3840, h: 2160, aspectRatio: 16 / 9 }
      ]
    },
    'streamer-left': {
      title: 'Streamer Setup (Vertical Left + Main Right)',
      screens: [
        { id: 'left-stream', name: 'Screen 1 (Chat/Stream)', w: 1215, h: 2160, aspectRatio: 9 / 16, isVertical: true },
        { id: 'right-main', name: 'Screen 2 (Main Game)', w: 3840, h: 2160, aspectRatio: 16 / 9 }
      ]
    },
    'streamer-right': {
      title: 'Streamer Setup (Main Left + Vertical Right)',
      screens: [
        { id: 'left-main', name: 'Screen 1 (Main Game)', w: 3840, h: 2160, aspectRatio: 16 / 9 },
        { id: 'right-stream', name: 'Screen 2 (Chat/Stream)', w: 1215, h: 2160, aspectRatio: 9 / 16, isVertical: true }
      ]
    },
    'triple-16-9': {
      title: 'Triple 16:9 Monitors (Panoramic)',
      screens: [
        { id: 'screen-1', name: 'Screen 1 (Left)', w: 3840, h: 2160, aspectRatio: 16 / 9 },
        { id: 'screen-2', name: 'Screen 2 (Center)', w: 3840, h: 2160, aspectRatio: 16 / 9 },
        { id: 'screen-3', name: 'Screen 3 (Right)', w: 3840, h: 2160, aspectRatio: 16 / 9 }
      ]
    },
    'ultrawide-plus-16-9': {
      title: 'Ultrawide 21:9 + 16:9 Standard',
      screens: [
        { id: 'main-ultra', name: 'Screen 1 (Ultrawide 21:9)', w: 3440, h: 1440, aspectRatio: 21 / 9 },
        { id: 'sec-standard', name: 'Screen 2 (Side 16:9)', w: 2560, h: 1440, aspectRatio: 16 / 9 }
      ]
    }
  };

  // State
  let currentLayoutKey = 'dual-16-9';
  let bezelGap = 12;
  let offsetYPercent = 50;
  let sourceImage = new Image();
  sourceImage.crossOrigin = 'anonymous';
  sourceImage.src = 'https://images.unsplash.com/photo-1514565131-fce0801e5785?auto=format&fit=crop&w=2400&q=85';

  // Elements
  const stage = document.getElementById('splitter-stage') as HTMLDivElement;
  const monitorsContainer = document.getElementById('monitors-container') as HTMLDivElement;
  const layoutTitle = document.getElementById('layout-title');
  const sourceRes = document.getElementById('splitter-source-res');
  const bezelSlider = document.getElementById('bezel-slider') as HTMLInputElement;
  const bezelGapText = document.getElementById('bezel-gap-text');
  const offsetYSlider = document.getElementById('offset-y-slider') as HTMLInputElement;
  const offsetYText = document.getElementById('offset-y-text');
  const btnDownloadAll = document.getElementById('btn-download-all-screens');
  const indDownloadContainer = document.getElementById('individual-download-buttons');
  const exportCanvas = document.getElementById('splitter-export-canvas') as HTMLCanvasElement;
  const fileInput = document.getElementById('splitter-file-input') as HTMLInputElement;

  function initMonitors() {
    const layout = LAYOUT_CONFIGS[currentLayoutKey];
    if (!layout || !monitorsContainer) return;

    if (layoutTitle) layoutTitle.textContent = layout.title;
    monitorsContainer.innerHTML = '';

    const isMobile = window.innerWidth < 640;
    const maxStageH = (stage ? stage.clientHeight : 600) - (isMobile ? 50 : 100);
    const gapPx = isMobile ? Math.max(6, Math.round(bezelGap / 3)) : Math.max(12, Math.round(bezelGap / 2));
    const totalGaps = (layout.screens.length - 1) * gapPx;
    const maxStageW = Math.max(260, (stage ? stage.clientWidth : 1100) - (isMobile ? 24 : 60) - totalGaps);

    const totalAspect = layout.screens.reduce((acc, s) => acc + s.aspectRatio, 0);
    const targetH = Math.max(isMobile ? 75 : 120, Math.min(maxStageH, Math.round(maxStageW / totalAspect)));

    monitorsContainer.style.gap = `${gapPx}px`;

    layout.screens.forEach((spec, index) => {
      const monitorW = Math.round(targetH * spec.aspectRatio);
      const monitorH = targetH;

      // Realistic physical monitor housing with sleek bezel, chin, and stand
      const monitorOuter = document.createElement('div');
      monitorOuter.className = 'flex flex-col items-center select-none shrink-0';
      monitorOuter.style.width = `${monitorW}px`;

      monitorOuter.innerHTML = `
        <div class="relative w-full rounded-lg bg-[#141A26] p-1 sm:p-2 border border-white/20 shadow-2xl">
          <div class="relative w-full overflow-hidden rounded bg-black" style="height: ${monitorH}px;">
            <canvas id="monitor-canvas-${index}" width="${monitorW}" height="${monitorH}" class="w-full h-full object-cover"></canvas>
            
            <!-- Screen Number Overlay Badge -->
            <div class="absolute top-1 sm:top-2 left-1 sm:left-2 px-1.5 sm:px-2 py-0.5 rounded bg-black/80 border border-white/15 text-[9px] sm:text-[10px] font-mono font-bold text-white">
              ${spec.name}
            </div>

            <!-- Resolution Badge -->
            <div class="absolute bottom-1 sm:bottom-2 right-1 sm:right-2 px-1.5 sm:px-2 py-0.5 rounded bg-black/80 border border-white/15 text-[8px] sm:text-[9px] font-mono text-[#00F0FF] font-bold">
              ${spec.w}×${spec.h}
            </div>
          </div>
        </div>
        <!-- Monitor Stand Stem & Base -->
        <div class="w-6 sm:w-10 h-2.5 sm:h-4 bg-[#1C2433] border-x border-white/10"></div>
        <div class="w-16 sm:w-28 h-1.5 sm:h-2 bg-[#253043] rounded-full border border-white/15 shadow-md"></div>
      `;

      monitorsContainer.appendChild(monitorOuter);
    });

    renderScreenSlices();
    updateDownloadButtons();
  }

  function renderScreenSlices() {
    if (!sourceImage.complete || sourceImage.naturalWidth <= 0) return;

    const layout = LAYOUT_CONFIGS[currentLayoutKey];
    if (!layout) return;

    const imgW = sourceImage.naturalWidth;
    const imgH = sourceImage.naturalHeight;

    const totalLayoutW = layout.screens.reduce((sum, s) => sum + s.w, 0);
    const maxScreenH = Math.max(...layout.screens.map((s) => s.h));

    const totalAspect = totalLayoutW / maxScreenH;
    const imgAspect = imgW / imgH;

    let sourceW = imgW;
    let sourceH = imgW / totalAspect;

    if (sourceH > imgH) {
      sourceH = imgH;
      sourceW = imgH * totalAspect;
    }

    const availableExtraY = Math.max(0, imgH - sourceH);
    const sourceY = (availableExtraY * (offsetYPercent / 100));

    let currentX = (imgW - sourceW) / 2;

    layout.screens.forEach((spec, index) => {
      const canvas = document.getElementById(`monitor-canvas-${index}`) as HTMLCanvasElement;
      if (!canvas) return;

      const ctx = canvas.getContext('2d');
      if (!ctx) return;

      const sliceRatio = spec.w / totalLayoutW;
      const sliceSourceW = sourceW * sliceRatio;

      ctx.clearRect(0, 0, canvas.width, canvas.height);
      ctx.imageSmoothingEnabled = true;
      ctx.imageSmoothingQuality = 'high';

      ctx.drawImage(
        sourceImage,
        currentX, sourceY, sliceSourceW, sourceH,
        0, 0, canvas.width, canvas.height
      );

      currentX += sliceSourceW;
    });
  }

  function updateDownloadButtons() {
    if (!indDownloadContainer) return;
    const layout = LAYOUT_CONFIGS[currentLayoutKey];
    if (!layout) return;

    indDownloadContainer.innerHTML = '';
    layout.screens.forEach((spec, index) => {
      const btn = document.createElement('button');
      btn.type = 'button';
      btn.className = 'px-3 py-2 rounded-lg bg-[#131A26] hover:bg-[#1B2536] border border-white/10 text-xs font-semibold text-gray-200 hover:text-white transition flex items-center justify-between cursor-pointer';
      btn.innerHTML = `
        <span class="truncate">${spec.name.split(' ')[0]} ${index + 1}</span>
        <span class="text-[10px] font-mono text-[#00F0FF] font-bold">${spec.w}×${spec.h}</span>
      `;
      btn.addEventListener('click', () => downloadScreen(index));
      indDownloadContainer.appendChild(btn);
    });
  }

  function downloadScreen(index: number) {
    const layout = LAYOUT_CONFIGS[currentLayoutKey];
    if (!layout || !sourceImage.complete || !exportCanvas) return;
    const spec = layout.screens[index];
    if (!spec) return;

    const imgW = sourceImage.naturalWidth;
    const imgH = sourceImage.naturalHeight;
    const totalLayoutW = layout.screens.reduce((sum, s) => sum + s.w, 0);
    const maxScreenH = Math.max(...layout.screens.map((s) => s.h));
    const totalAspect = totalLayoutW / maxScreenH;

    let sourceW = imgW;
    let sourceH = imgW / totalAspect;
    if (sourceH > imgH) {
      sourceH = imgH;
      sourceW = imgH * totalAspect;
    }

    const availableExtraY = Math.max(0, imgH - sourceH);
    const sourceY = availableExtraY * (offsetYPercent / 100);

    let currentX = (imgW - sourceW) / 2;
    for (let i = 0; i < index; i++) {
      currentX += sourceW * (layout.screens[i].w / totalLayoutW);
    }
    const sliceSourceW = sourceW * (spec.w / totalLayoutW);

    exportCanvas.width = spec.w;
    exportCanvas.height = spec.h;
    const ctx = exportCanvas.getContext('2d');
    if (!ctx) return;

    ctx.imageSmoothingEnabled = true;
    ctx.imageSmoothingQuality = 'high';

    ctx.drawImage(
      sourceImage,
      currentX, sourceY, sliceSourceW, sourceH,
      0, 0, spec.w, spec.h
    );

    const a = document.createElement('a');
    a.href = exportCanvas.toDataURL('image/jpeg', 0.96);
    a.download = `walpix-screen-${index + 1}-${spec.w}x${spec.h}.jpg`;
    document.body.appendChild(a);
    a.click();
    document.body.removeChild(a);
  }

  // Layout Buttons
  const layoutBtns = document.querySelectorAll('.layout-btn');
  layoutBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      layoutBtns.forEach((b) => {
        b.classList.remove('bg-[#00F0FF]', 'text-black', 'font-semibold');
        b.classList.add('bg-[#101622]', 'text-gray-300');
      });
      btn.classList.add('bg-[#00F0FF]', 'text-black', 'font-semibold');
      btn.classList.remove('bg-[#101622]', 'text-gray-300');

      currentLayoutKey = btn.getAttribute('data-layout') || 'dual-16-9';
      initMonitors();
    });
  });

  // Bezel Slider
  bezelSlider?.addEventListener('input', () => {
    bezelGap = parseInt(bezelSlider.value, 10);
    if (bezelGapText) bezelGapText.textContent = `${bezelGap} px`;
    if (monitorsContainer) monitorsContainer.style.gap = `${Math.max(6, bezelGap / 2)}px`;
    renderScreenSlices();
  });

  // Offset Slider
  offsetYSlider?.addEventListener('input', () => {
    offsetYPercent = parseInt(offsetYSlider.value, 10);
    if (offsetYText) offsetYText.textContent = `${offsetYPercent}%`;
    renderScreenSlices();
  });

  // Reset Alignment
  document.getElementById('btn-reset-splitter')?.addEventListener('click', () => {
    offsetYPercent = 50;
    if (offsetYSlider) offsetYSlider.value = '50';
    if (offsetYText) offsetYText.textContent = 'Center (50%)';
    renderScreenSlices();
  });

  // Download All Screens (Sequential)
  btnDownloadAll?.addEventListener('click', () => {
    const layout = LAYOUT_CONFIGS[currentLayoutKey];
    if (!layout) return;

    layout.screens.forEach((_, i) => {
      setTimeout(() => downloadScreen(i), i * 350);
    });
  });

  // Image Loading
  function onSplitterImgLoaded() {
    if (sourceRes) sourceRes.textContent = `Source: ${sourceImage.naturalWidth} × ${sourceImage.naturalHeight}`;
    initMonitors();
  }

  sourceImage.addEventListener('load', onSplitterImgLoaded);
  if (sourceImage.complete && sourceImage.naturalWidth > 0) onSplitterImgLoaded();

  function loadSplitterUrl(url: string) {
    sourceImage.src = url;
  }

  // URL query parameter loader
  const urlParams = new URLSearchParams(window.location.search);
  const initialUrl = urlParams.get('url') || urlParams.get('img') || urlParams.get('image');
  if (initialUrl) loadSplitterUrl(initialUrl);

  // Sample Wallpapers
  document.querySelectorAll('.sample-splitter-btn').forEach((btn) => {
    btn.addEventListener('click', () => {
      const url = btn.getAttribute('data-sample-url');
      if (url) loadSplitterUrl(url);
    });
  });

  // File Upload
  fileInput?.addEventListener('change', (e) => {
    const target = e.target as HTMLInputElement;
    const file = target.files?.[0];
    if (file) {
      const reader = new FileReader();
      reader.onload = (evt) => {
        if (evt.target?.result) loadSplitterUrl(evt.target.result as string);
      };
      reader.readAsDataURL(file);
    }
  });

  // Tabs (Upload vs URL)
  const tabSplitterUpload = document.getElementById('tab-splitter-upload');
  const tabSplitterUrl = document.getElementById('tab-splitter-url');
  const splitterDropzoneBox = document.getElementById('splitter-dropzone-box');
  const splitterUrlBox = document.getElementById('splitter-url-box');

  tabSplitterUpload?.addEventListener('click', () => {
    tabSplitterUpload.className = 'px-2 py-0.5 rounded text-[#00F0FF] font-bold bg-[#00F0FF]/10';
    tabSplitterUrl!.className = 'px-2 py-0.5 rounded text-gray-400 hover:text-white';
    splitterDropzoneBox?.classList.remove('hidden');
    splitterUrlBox?.classList.add('hidden');
  });

  tabSplitterUrl?.addEventListener('click', () => {
    tabSplitterUrl.className = 'px-2 py-0.5 rounded text-[#00F0FF] font-bold bg-[#00F0FF]/10';
    tabSplitterUpload!.className = 'px-2 py-0.5 rounded text-gray-400 hover:text-white';
    splitterUrlBox?.classList.remove('hidden');
    splitterDropzoneBox?.classList.add('hidden');
  });

  document.getElementById('btn-splitter-load-url')?.addEventListener('click', () => {
    const input = document.getElementById('splitter-url-input') as HTMLInputElement;
    if (input?.value.trim()) {
      loadSplitterUrl(input.value.trim());
    }
  });

  window.addEventListener('resize', () => initMonitors(), { passive: true });
</script>
