---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import AdSenseSlot from '../../components/AdSenseSlot.astro';
---

<Layout
  title="Online 4K Wallpaper Resizer & Smart Cropper"
  description="Free online wallpaper crop and resize tool. Resize any image to 4K Ultra HD, 1080p, Ultrawide, iPhone, or Samsung resolution with zero quality loss and instant download."
>
  <Header />

  <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
    <div class="text-center max-w-2xl mx-auto mb-8 space-y-3">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-neon-lime/10 border border-neon-lime/30 text-neon-lime text-xs font-bold font-mono uppercase tracking-wider">
        ⚡ Zero-Loss Canvas Engine
      </div>
      <h1 class="text-3xl sm:text-4xl font-display font-black text-white">
        Smart Wallpaper <span class="bg-gradient-to-r from-neon-lime via-neon-cyan to-neon-pink bg-clip-text text-transparent">Cropper & Resizer</span>
      </h1>
      <p class="text-gray-400 text-sm sm:text-base">
        Paste any image URL or upload your wallpaper to crop, resize, and convert to 4K, 2K, Ultrawide, or Smartphone formats in seconds.
      </p>
    </div>

    <!-- Interactive Cropping Studio UI -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
      
      <!-- Left: Interactive Canvas Viewport (8 Cols) -->
      <div class="lg:col-span-8 glass-panel rounded-2xl p-4 sm:p-6 border border-white/10 space-y-4">
        
        <!-- Top Toolbar -->
        <div class="flex flex-wrap items-center justify-between gap-3 pb-3 border-b border-white/5">
          <div class="flex items-center gap-2">
            <span class="text-xs font-semibold text-gray-300">Preset Resolutions:</span>
          </div>
          <div class="flex flex-wrap items-center gap-1.5" id="preset-buttons">
            <button data-w="3840" data-h="2160" class="preset-btn px-2.5 py-1 rounded-lg bg-neon-lime text-obsidian-950 text-xs font-bold shadow-glow-lime">4K Desktop (16:9)</button>
            <button data-w="2560" data-h="1440" class="preset-btn px-2.5 py-1 rounded-lg bg-obsidian-800 text-gray-300 hover:text-white border border-white/10 text-xs font-medium">2K QHD</button>
            <button data-w="3440" data-h="1440" class="preset-btn px-2.5 py-1 rounded-lg bg-obsidian-800 text-gray-300 hover:text-white border border-white/10 text-xs font-medium">Ultrawide (21:9)</button>
            <button data-w="1080" data-h="2400" class="preset-btn px-2.5 py-1 rounded-lg bg-obsidian-800 text-gray-300 hover:text-white border border-white/10 text-xs font-medium">📱 Mobile (9:20)</button>
            <button data-w="2048" data-h="2732" class="preset-btn px-2.5 py-1 rounded-lg bg-obsidian-800 text-gray-300 hover:text-white border border-white/10 text-xs font-medium">iPad / Tablet</button>
          </div>
        </div>

        <!-- Canvas Stage -->
        <div class="relative w-full aspect-[16/10] bg-obsidian-950 rounded-xl overflow-hidden flex items-center justify-center border border-white/5 shadow-inner">
          <canvas id="crop-canvas" class="max-w-full max-h-full object-contain"></canvas>
          <div id="canvas-placeholder" class="text-center p-6 space-y-3">
            <span class="text-4xl">🎨</span>
            <h4 class="text-base font-bold text-white">Select a wallpaper or enter an image URL to begin</h4>
            <p class="text-xs text-gray-500">Image is processed securely inside your browser.</p>
          </div>
        </div>

        <!-- Image Loader Input -->
        <div class="flex flex-col sm:flex-row gap-3 pt-2">
          <input
            id="image-url-input"
            type="text"
            placeholder="Paste direct Image URL (e.g. https://...)"
            value="https://wallpapercat.com/w/featured-for-top/xmini-sq/6/7/b/6189.jpg"
            class="flex-grow px-4 py-2.5 bg-obsidian-850 border border-white/10 rounded-xl text-xs sm:text-sm text-ice focus:outline-none focus:border-neon-lime"
          />
          <button
            id="load-image-btn"
            class="px-5 py-2.5 bg-obsidian-800 hover:bg-obsidian-700 text-white font-semibold rounded-xl text-xs sm:text-sm border border-white/10 transition"
          >
            Load URL
          </button>
          <label class="px-5 py-2.5 bg-white/5 hover:bg-white/10 text-gray-300 font-semibold rounded-xl text-xs sm:text-sm border border-white/10 transition cursor-pointer text-center">
            Upload Local
            <input id="local-file-input" type="file" accept="image/*" class="hidden" />
          </label>
        </div>
      </div>

      <!-- Right: Control Panel & Export (4 Cols) -->
      <div class="lg:col-span-4 space-y-6">
        <div class="glass-panel rounded-2xl p-5 sm:p-6 border border-white/10 space-y-5">
          <h3 class="text-base font-bold text-white flex items-center gap-2">
            <span>⚙️</span> Export Settings
          </h3>

          <!-- Custom Dimensions -->
          <div class="grid grid-cols-2 gap-3">
            <div>
              <label class="block text-xs font-semibold text-gray-400 mb-1">Target Width (px)</label>
              <input
                id="target-w"
                type="number"
                value="3840"
                class="w-full px-3 py-2 bg-obsidian-850 border border-white/10 rounded-xl text-sm font-mono text-white focus:outline-none focus:border-neon-lime"
              />
            </div>
            <div>
              <label class="block text-xs font-semibold text-gray-400 mb-1">Target Height (px)</label>
              <input
                id="target-h"
                type="number"
                value="2160"
                class="w-full px-3 py-2 bg-obsidian-850 border border-white/10 rounded-xl text-sm font-mono text-white focus:outline-none focus:border-neon-lime"
              />
            </div>
          </div>

          <!-- Format Selector -->
          <div>
            <label class="block text-xs font-semibold text-gray-400 mb-1">Output Format</label>
            <div class="grid grid-cols-3 gap-2">
              <button data-format="image/jpeg" class="format-btn active px-3 py-2 rounded-xl bg-neon-lime text-obsidian-950 text-xs font-bold">JPG (High-Res)</button>
              <button data-format="image/png" class="format-btn px-3 py-2 rounded-xl bg-obsidian-850 text-gray-300 border border-white/10 text-xs font-medium">PNG (Lossless)</button>
              <button data-format="image/webp" class="format-btn px-3 py-2 rounded-xl bg-obsidian-850 text-gray-300 border border-white/10 text-xs font-medium">WebP (Fast)</button>
            </div>
          </div>

          <!-- Quality Slider -->
          <div>
            <div class="flex items-center justify-between text-xs font-semibold text-gray-400 mb-1">
              <span>Quality Factor</span>
              <span id="quality-val" class="text-neon-lime font-mono">95%</span>
            </div>
            <input
              id="quality-slider"
              type="range"
              min="50"
              max="100"
              value="95"
              class="w-full accent-neon-lime cursor-pointer"
            />
          </div>

          <!-- Process & Download Button -->
          <button
            id="download-cropped-btn"
            class="w-full py-3.5 rounded-xl bg-gradient-to-r from-neon-lime to-neon-cyan text-obsidian-950 font-display font-extrabold text-sm sm:text-base hover:opacity-95 transition-all shadow-glow-lime flex items-center justify-center gap-2"
          >
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
            </svg>
            <span>Generate & Download 4K</span>
          </button>

          <p class="text-[11px] text-gray-500 text-center">
            🔒 100% Client-Side Private • Instant Download
          </p>
        </div>

        <!-- High-RPM Ad Slot -->
        <AdSenseSlot format="rectangle" slotId="cropper-sidebar-ad" />
      </div>

    </div>
  </main>

  <Footer />
</Layout>

<script>
  // Client-Side Canvas Cropper Logic
  const canvas = document.getElementById('crop-canvas') as HTMLCanvasElement;
  const ctx = canvas?.getContext('2d');
  const placeholder = document.getElementById('canvas-placeholder');
  const urlInput = document.getElementById('image-url-input') as HTMLInputElement;
  const loadBtn = document.getElementById('load-image-btn');
  const fileInput = document.getElementById('local-file-input') as HTMLInputElement;
  const targetW = document.getElementById('target-w') as HTMLInputElement;
  const targetH = document.getElementById('target-h') as HTMLInputElement;
  const qualitySlider = document.getElementById('quality-slider') as HTMLInputElement;
  const qualityVal = document.getElementById('quality-val');
  const downloadBtn = document.getElementById('download-cropped-btn');
  const presetButtons = document.querySelectorAll('.preset-btn');
  const formatButtons = document.querySelectorAll('.format-btn');

  let currentImage: HTMLImageElement | null = null;
  let selectedFormat = 'image/jpeg';

  function renderToCanvas() {
    if (!currentImage || !canvas || !ctx) return;
    if (placeholder) placeholder.style.display = 'none';

    const w = parseInt(targetW.value) || 3840;
    const h = parseInt(targetH.value) || 2160;

    canvas.width = w;
    canvas.height = h;

    // Draw scaled center crop
    const imgRatio = currentImage.naturalWidth / currentImage.naturalHeight;
    const targetRatio = w / h;
    let sWidth = currentImage.naturalWidth;
    let sHeight = currentImage.naturalHeight;
    let sx = 0;
    let sy = 0;

    if (imgRatio > targetRatio) {
      sWidth = currentImage.naturalHeight * targetRatio;
      sx = (currentImage.naturalWidth - sWidth) / 2;
    } else {
      sHeight = currentImage.naturalWidth / targetRatio;
      sy = (currentImage.naturalHeight - sHeight) / 2;
    }

    ctx.drawImage(currentImage, sx, sy, sWidth, sHeight, 0, 0, w, h);
  }

  function loadImageFromSrc(src: string) {
    const img = new Image();
    img.crossOrigin = 'anonymous';
    img.referrerPolicy = 'no-referrer';
    img.onload = () => {
      currentImage = img;
      renderToCanvas();
    };
    img.src = src;
  }

  // Load default image on mount
  if (urlInput && urlInput.value) {
    loadImageFromSrc(urlInput.value);
  }

  loadBtn?.addEventListener('click', () => {
    if (urlInput.value) loadImageFromSrc(urlInput.value);
  });

  fileInput?.addEventListener('change', (e) => {
    const file = (e.target as HTMLInputElement).files?.[0];
    if (file) {
      const reader = new FileReader();
      reader.onload = (event) => {
        if (event.target?.result) loadImageFromSrc(event.target.result as string);
      };
      reader.readAsDataURL(file);
    }
  });

  presetButtons.forEach((btn) => {
    btn.addEventListener('click', () => {
      presetButtons.forEach((b) => {
        b.className = 'preset-btn px-2.5 py-1 rounded-lg bg-obsidian-800 text-gray-300 hover:text-white border border-white/10 text-xs font-medium';
      });
      btn.className = 'preset-btn px-2.5 py-1 rounded-lg bg-neon-lime text-obsidian-950 text-xs font-bold shadow-glow-lime';

      const w = btn.getAttribute('data-w') || '3840';
      const h = btn.getAttribute('data-h') || '2160';
      if (targetW) targetW.value = w;
      if (targetH) targetH.value = h;
      renderToCanvas();
    });
  });

  formatButtons.forEach((btn) => {
    btn.addEventListener('click', () => {
      formatButtons.forEach((b) => {
        b.className = 'format-btn px-3 py-2 rounded-xl bg-obsidian-850 text-gray-300 border border-white/10 text-xs font-medium';
      });
      btn.className = 'format-btn active px-3 py-2 rounded-xl bg-neon-lime text-obsidian-950 text-xs font-bold';
      selectedFormat = btn.getAttribute('data-format') || 'image/jpeg';
    });
  });

  qualitySlider?.addEventListener('input', (e) => {
    const val = (e.target as HTMLInputElement).value;
    if (qualityVal) qualityVal.textContent = `${val}%`;
  });

  targetW?.addEventListener('change', renderToCanvas);
  targetH?.addEventListener('change', renderToCanvas);

  downloadBtn?.addEventListener('click', () => {
    if (!canvas) return;
    const quality = (parseInt(qualitySlider?.value || '95') / 100);
    const dataUrl = canvas.toDataURL(selectedFormat, quality);
    const ext = selectedFormat === 'image/png' ? 'png' : selectedFormat === 'image/webp' ? 'webp' : 'jpg';

    const link = document.createElement('a');
    link.download = `lumina-wallpaper-${targetW?.value || '4k'}x${targetH?.value || '2k'}.${ext}`;
    link.href = dataUrl;
    link.click();
  });
</script>
