---
export const prerender = true;
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<Layout
  title="Terms of Service & Licensing"
  description="Terms of service, wallpaper licensing, and usage guidelines for WALPIX Wallpapers."
>
  <Header />

  <main class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="glass-panel rounded-3xl p-8 sm:p-12 border border-white/10 space-y-6 prose prose-invert max-w-none">
      <div class="border-b border-white/10 pb-4">
        <h1 class="text-3xl font-display font-black text-white">Terms of Service</h1>
        <p class="text-xs text-gray-500 mt-1">Last Updated: October 4, 2026</p>
      </div>

      <section class="space-y-4 text-sm text-gray-300 leading-relaxed">
        <h2 class="text-lg font-bold text-white">1. Acceptance of Terms</h2>
        <p>
          By accessing and using WALPIX Wallpapers, you accept and agree to be bound by the terms and provisions of this agreement.
        </p>

        <h2 class="text-lg font-bold text-white">2. Permitted Wallpaper Usage & Licensing</h2>
        <p>
          All wallpapers available on WALPIX Wallpapers are provided free of charge for <strong>personal, non-commercial use only</strong> as computer desktop backgrounds, phone lockscreens, and tablet wallpapers.
        </p>
        <p>
          You may not resell, redistribute as commercial stock packages, or exploit any artwork without explicit authorization from original creators.
        </p>

        <h2 class="text-lg font-bold text-white">3. Disclaimer of Warranties</h2>
        <p>
          The materials on WALPIX Wallpapers are provided on an 'as is' basis without warranties of any kind.
        </p>
      </section>
    </div>
  </main>

  <Footer />
</Layout>
