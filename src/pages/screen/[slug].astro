---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import AdSenseLeaderboard from '../../components/AdSenseLeaderboard.astro';
import RelatedSearchWidget from '../../components/RelatedSearchWidget.astro';
import ColorPaletteFilter from '../../components/ColorPaletteFilter.astro';
import WallpaperGrid from '../../components/WallpaperGrid.astro';
import Footer from '../../components/Footer.astro';
import { SCREEN_TYPES, getWallpapersByScreen, wallpapers, type ScreenTypeHub, type Wallpaper } from '../../data/wallpapers';
import { getOptimizedThumbUrl } from '../../utils/imageOptimizer';

import OrientationToggle from '../../components/OrientationToggle.astro';

export async function getStaticPaths() {
  return SCREEN_TYPES.map((screen) => {
    const matchingWallpapers = getWallpapersByScreen(screen.slug);
    return {
      params: { slug: screen.slug },
      props: {
        screenInfo: screen,
        wallpapersList: matchingWallpapers.length > 0 ? matchingWallpapers : wallpapers.slice(0, 12),
        allScreens: SCREEN_TYPES,
      },
    };
  });
}

interface Props {
  screenInfo: ScreenTypeHub;
  wallpapersList: Wallpaper[];
  allScreens: ScreenTypeHub[];
}

const { slug } = Astro.params;
const allScreens = (Astro.props as any).allScreens || SCREEN_TYPES;
const screenInfo = (Astro.props as any).screenInfo || allScreens.find((s: any) => s.slug === slug) || allScreens[0];
const wallpapersList = (Astro.props as any).wallpapersList || (getWallpapersByScreen(screenInfo.slug).length > 0 ? getWallpapersByScreen(screenInfo.slug) : wallpapers.slice(0, 12));

const screenGridMode: 'all' | 'desktop' | 'phone' | 'dual' = screenInfo.slug === 'phone-wallpapers'
  ? 'phone'
  : screenInfo.slug === 'dual-screen-wallpapers' || screenInfo.slug === 'ultrawide-wallpapers'
    ? 'dual'
    : 'desktop';

const heroImage = wallpapersList[0]?.sourceCdn || '/images/hero-astronaut-master.png';

const schema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: screenInfo.title,
  description: screenInfo.description,
  url: `https://walpix.site/screen/${screenInfo.slug}`,
  mainEntity: {
    '@type': 'ItemList',
    itemListElement: wallpapersList.slice(0, 12).map((wp, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      item: {
        '@type': 'ImageObject',
        name: wp.title,
        contentUrl: wp.sourceCdn,
        url: `https://walpix.site/wallpapers/${wp.slug}`,
      },
    })),
  },
};
---

<Layout
  title={`${screenInfo.title} - WALPIX 4K`}
  description={screenInfo.description}
  image={heroImage}
  schema={schema}
>
  <!-- Global Header Navigation -->
  <Header />

  <main class="min-h-screen bg-[#020406] text-left">
    
    <!-- Screen Type Hero Banner -->
    <section class="relative w-full overflow-hidden bg-[#030508] border-b border-white/[0.08] pt-6 pb-8">
      
      <!-- Backdrop Preview Glow -->
      <div class="absolute inset-0 z-0">
        <img
          src={getOptimizedThumbUrl(heroImage, 400, 70)}
          alt={`${screenInfo.name} Backdrop Preview`}
          class="w-full h-full object-cover object-center opacity-25 filter blur-[3px] scale-105"
        />
        <div class="absolute inset-0 bg-gradient-to-r from-[#020406] via-[#020406]/90 to-[#020406]/75"></div>
        <div class="absolute inset-0 bg-gradient-to-t from-[#020406] via-transparent to-transparent"></div>
      </div>

      <!-- Edge-to-Edge Container -->
      <div class="relative z-10 w-full px-4 sm:px-8 lg:px-12 text-left">
        
        <!-- Breadcrumbs -->
        <nav class="flex items-center gap-2 text-xs text-[#8E949E] font-mono mb-4 text-left">
          <a href="/" class="hover:text-white transition-colors">Home</a>
          <span>/</span>
          <a href="/categories" class="hover:text-white transition-colors">Display Formats</a>
          <span>/</span>
          <span class="text-white/40">Screens</span>
          <span>/</span>
          <span class="text-walpix-lime font-bold">{screenInfo.name}</span>
        </nav>

        <!-- Heading & Details -->
        <div class="max-w-4xl space-y-3 text-left">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-walpix-lime/10 border border-walpix-lime/30 text-xs font-mono font-bold text-walpix-lime uppercase tracking-wider">
            <span class="w-1.5 h-1.5 rounded-full bg-walpix-lime animate-pulse"></span>
            <span>{screenInfo.badge} • Optimized Aspect Ratio</span>
          </div>

          <h1 class="text-3xl sm:text-4xl lg:text-5xl font-black text-white tracking-tight leading-tight text-left">
            {screenInfo.name.toUpperCase()}
          </h1>

          <p class="text-sm sm:text-base text-gray-300 max-w-2xl leading-relaxed text-left">
            {screenInfo.headline}. {screenInfo.description}
          </p>

          <!-- Key Metrics Pills -->
          <div class="flex flex-wrap items-center gap-3 pt-2 text-left">
            <div class="px-3.5 py-1.5 rounded-xl bg-white/[0.05] border border-white/10 text-xs font-mono text-white flex items-center gap-2">
              <span class="text-walpix-lime font-bold">{wallpapersList.length}</span>
              <span class="text-[#8E949E]">Curated Wallpapers</span>
            </div>
            <div class="px-3.5 py-1.5 rounded-xl bg-white/[0.05] border border-white/10 text-xs font-mono text-white flex items-center gap-2">
              <span class="text-walpix-lime font-bold">{screenInfo.targetRes}</span>
              <span class="text-[#8E949E]">Native Resolution</span>
            </div>
            <div class="px-3.5 py-1.5 rounded-xl bg-white/[0.05] border border-white/10 text-xs font-mono text-white flex items-center gap-2">
              <span class="text-walpix-lime font-bold">{screenInfo.aspectRatio}</span>
              <span class="text-[#8E949E]">Aspect Ratio</span>
            </div>
          </div>
        </div>

        <!-- Screen / Device Switching Tabs -->
        <div class="mt-6 pt-5 border-t border-white/[0.06] text-left">
          <div class="flex items-center gap-2 mb-2 text-xs font-mono text-[#8E949E] uppercase tracking-wider">
            <svg class="w-3.5 h-3.5 text-walpix-lime" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
            </svg>
            <span>Browse By Device & Display Hub:</span>
          </div>

          <div class="flex flex-wrap items-center gap-2.5">
            {allScreens.map((s) => {
              const isActive = s.slug === screenInfo.slug;
              return (
                <a
                  href={`/screen/${s.slug}`}
                  class={`px-4 py-2 rounded-xl text-xs font-semibold transition-all flex items-center gap-2 border ${
                    isActive
                      ? 'bg-walpix-lime text-black border-walpix-lime shadow-[0_0_15px_rgba(194,246,0,0.3)] font-bold'
                      : 'bg-white/[0.04] text-gray-300 hover:text-white border-white/[0.08] hover:border-white/20'
                  }`}
                >
                  <span>{s.name}</span>
                  <span class={`text-[10px] font-mono px-1.5 py-0.5 rounded-md ${
                    isActive ? 'bg-black/20 text-black' : 'bg-white/10 text-gray-400'
                  }`}>
                    {s.targetRes}
                  </span>
                </a>
              );
            })}
          </div>
        </div>

      </div>
    </section>

    <!-- Top High-RPM AdSense Placement with 30px Safe Margin -->
    <div class="w-full px-4 sm:px-8 lg:px-12 my-6">
      <AdSenseLeaderboard slotId="screen-top-leaderboard" />
    </div>

    <!-- Screen Format Switcher -->
    <div class="w-full px-4 sm:px-8 lg:px-12 pt-2 pb-2">
      <OrientationToggle activeFormat={screenGridMode} />
    </div>

    <!-- Main Wallpaper Gallery Grid -->
    <section class="w-full px-4 sm:px-8 lg:px-12 pb-16">
      <div class="flex items-center justify-between mb-6 pb-3 border-b border-white/[0.06]">
        <h2 class="text-xl font-bold text-white flex items-center gap-2.5">
          <span>Wallpapers for</span>
          <span class="text-walpix-lime">{screenInfo.name}</span>
        </h2>
        <span class="text-xs font-mono text-[#8E949E]">
          {wallpapersList.length} items formatted for {screenInfo.targetRes}
        </span>
      </div>

      <WallpaperGrid wallpapers={wallpapersList} gridMode={screenGridMode} />
    </section>

    <!-- Mid/Bottom AdSense Placement with 30px Safe Margin -->
    <div class="w-full px-4 sm:px-8 lg:px-12 my-6">
      <AdSenseLeaderboard slotId="screen-bottom-leaderboard" />
    </div>

    <!-- Related Search Intent High-CTR Widget -->
    <div class="w-full px-4 sm:px-8 lg:px-12 mb-12">
      <RelatedSearchWidget />
    </div>

    <!-- Aesthetic Color Explorer Panel -->
    <div class="w-full px-4 sm:px-8 lg:px-12 mb-16">
      <ColorPaletteFilter />
    </div>

  </main>

  <!-- Global Footer -->
  <Footer />
</Layout>
