---
export const prerender = true;
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<Layout
  title="DMCA Copyright Policy & Takedown"
  description="DMCA Copyright policy and takedown request form for WALPIX Wallpapers."
>
  <Header />

  <main class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="glass-panel rounded-3xl p-8 sm:p-12 border border-white/10 space-y-6 prose prose-invert max-w-none">
      <div class="border-b border-white/10 pb-4">
        <h1 class="text-3xl font-display font-black text-white">DMCA Copyright Policy</h1>
        <p class="text-xs text-gray-500 mt-1">Digital Millennium Copyright Act Compliance</p>
      </div>

      <section class="space-y-4 text-sm text-gray-300 leading-relaxed">
        <p>
          WALPIX Wallpapers respects the intellectual property rights of creators and artists. We comply with the Digital Millennium Copyright Act (17 U.S.C. § 512).
        </p>

        <h2 class="text-lg font-bold text-white">Filing a DMCA Takedown Notice</h2>
        <p>
          If you believe your copyrighted work is available on our website without authorization, please send a written notification including:
        </p>
        <ul class="list-disc pl-5 space-y-1 text-gray-400">
          <li>A physical or electronic signature of the authorized copyright owner.</li>
          <li>Identification of the copyrighted work claimed to have been infringed.</li>
          <li>Exact URL(s) on our website where the material is located.</li>
          <li>Your contact details including full name, mailing address, and email address.</li>
          <li>A statement made in good faith that the disputed use is unauthorized.</li>
          <li>A statement under penalty of perjury that the information provided is accurate.</li>
        </ul>

        <div class="p-4 rounded-xl bg-obsidian-950 border border-white/10 mt-6">
          <h3 class="text-xs font-bold text-white uppercase tracking-wider mb-1">Designated DMCA Agent Contact</h3>
          <p class="text-xs text-gray-400 font-mono">Email: dmca-takedown@walpix.site</p>
          <p class="text-xs text-gray-400">Response time: Within 24-48 business hours.</p>
        </div>
      </section>
    </div>
  </main>

  <Footer />
</Layout>
