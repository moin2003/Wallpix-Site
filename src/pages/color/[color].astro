---
export const prerender = true;
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import ColorPaletteFilter from '../../components/ColorPaletteFilter.astro';
import WallpaperGrid from '../../components/WallpaperGrid.astro';
import Footer from '../../components/Footer.astro';
import { LUXURY_COLORS, getWallpapersByColor, type Wallpaper } from '../../data/wallpapers';

export async function getStaticPaths() {
  return LUXURY_COLORS.map((c) => ({
    params: { color: c.slug },
    props: { colorInfo: c },
  }));
}

interface Props {
  colorInfo: typeof LUXURY_COLORS[0];
}

const { color: colorSlug } = Astro.params;
const colorInfo = (Astro.props as any).colorInfo || LUXURY_COLORS.find(c => c.slug === colorSlug) || LUXURY_COLORS[0];

const displayWallpapers = getWallpapersByColor(colorInfo.slug);

const schema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: `${colorInfo.name} 4K Wallpapers`,
  description: `Browse curated ${colorInfo.name} (${colorInfo.hexAccent}) wallpapers in 4K UHD, AMOLED and mobile resolution.`,
  url: `https://www.walpix.site/color/${colorInfo.slug}`,
};
---

<Layout
  title={`${colorInfo.name} Aesthetic Wallpapers (4K UHD Free Download) - WALPIX 4K`}
  description={`Browse curated ${colorInfo.name} (${colorInfo.hexAccent}) aesthetic wallpapers in 4K UHD, AMOLED true black, and mobile portrait resolutions.`}
  schema={schema}
>
  <Header />

  <main class="min-h-screen bg-[#020406] pb-20 text-left">
    <!-- Ambient Background Glow matching the active palette -->
    <div class="fixed inset-0 pointer-events-none z-0 overflow-hidden">
      <div
        class="absolute -top-32 right-10 w-[600px] h-[600px] rounded-full blur-[160px] opacity-20"
        style={`background-color: ${colorInfo.hexAccent};`}
      ></div>
      <div
        class="absolute top-1/3 -left-32 w-[650px] h-[650px] rounded-full blur-[180px] opacity-15"
        style={`background-color: ${colorInfo.hexPrimary};`}
      ></div>
    </div>

    <!-- Full-Width Header Bar -->
    <div class="relative z-10 w-full px-4 sm:px-8 lg:px-12 pt-6 pb-4">
      <!-- Breadcrumbs -->
      <nav class="flex items-center gap-2 text-xs text-[#8E949E] font-mono mb-4 text-left">
        <a href="/" class="hover:text-white transition-colors">Home</a>
        <span>/</span>
        <a href="/#color-explorer" class="hover:text-white transition-colors">Colors</a>
        <span>/</span>
        <span class="text-walpix-lime font-bold">{colorInfo.name}</span>
      </nav>

      <!-- Header Content & Dual Tone Swatch -->
      <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 pb-6 border-b border-white/[0.08]">
        <div class="space-y-2.5 max-w-3xl text-left">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-white/[0.04] border border-white/10 text-xs font-mono">
            <span class="w-2.5 h-2.5 rounded-full shadow-[0_0_8px_rgba(255,255,255,0.4)]" style={`background-color: ${colorInfo.hexAccent};`}></span>
            <span class="text-white font-bold">{colorInfo.hexAccent}</span>
            <span class="text-gray-500">•</span>
            <span class="text-gray-400 font-medium">{colorInfo.hexPrimary}</span>
          </div>
          <h1 class="text-3xl sm:text-4xl lg:text-5xl font-black text-white tracking-tight leading-none text-left">
            {colorInfo.name.toUpperCase()} <span class="text-walpix-lime">WALLPAPERS</span>
          </h1>
          <p class="text-sm text-[#8E949E] leading-relaxed text-left max-w-2xl">
            Explore hand-curated ultra-HD wallpapers in {colorInfo.name} aesthetic tones for desktop and mobile screens.
          </p>
        </div>

        <!-- Visual Color Badge Swatches -->
        <div class="flex items-center gap-3 p-3.5 rounded-2xl bg-[#060a0f] border border-white/10 shrink-0 shadow-xl">
          <div class="flex flex-col items-center">
            <div class="w-10 h-10 rounded-xl shadow-lg border border-white/15" style={`background-color: ${colorInfo.hexPrimary};`}></div>
            <span class="text-[9px] font-mono text-gray-400 mt-1 uppercase">Primary</span>
          </div>
          <span class="text-gray-600 font-bold">+</span>
          <div class="flex flex-col items-center">
            <div class="w-10 h-10 rounded-xl shadow-lg border border-white/15" style={`background-color: ${colorInfo.hexAccent};`}></div>
            <span class="text-[9px] font-mono text-walpix-lime mt-1 uppercase">Accent</span>
          </div>
        </div>
      </div>
    </div>

    <!-- Interactive Palette Selector Strip -->
    <ColorPaletteFilter activeColor={colorInfo.slug} className="pt-2 pb-6" />

    <!-- Wallpapers Grid with Full Responsive Controls -->
    <div class="relative z-10 w-full px-4 sm:px-8 lg:px-12 pt-2">
      <WallpaperGrid wallpapers={displayWallpapers} title={`${colorInfo.name} Collection`} />
    </div>
  </main>

  <Footer />
</Layout>

