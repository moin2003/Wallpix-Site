      'https://images.unsplash.com/photo-1617814076367-b759c7d7e738?w=800&q=80',
      'https://wallpapercat.com/w/full/5/d/f/2614-3840x2160-desktop-4k-cyberpunk-2077-wallpaper-photo.jpg'
    ]
  },
  {
    title: 'Pitch Black & OLED Void',
    category: 'AMOLED',
    count: 280,
    href: '/collections/amoled-dark-void-pack',
    images: [
      'https://wallpapercat.com/w/full/7/1/4/218040-3840x2160-desktop-4k-porsche-911-992-background.jpg',
      'https://images.unsplash.com/photo-1518709268805-4e9042af9f23?w=800&q=80',
      'https://wallpapercat.com/w/full/f/9/6/1302353-3840x2160-desktop-4k-anime-background-image.jpg'
    ]
  }
];

export async function getStaticPaths() {
  return wallpapers.map((wp) => ({
    params: { slug: wp.slug },
    props: { wallpaper: wp },
  }));
}

interface Props {
  wallpaper: Wallpaper;
}

const { slug } = Astro.params;
const wallpaper = (Astro.props as any).wallpaper || wallpapers.find((w) => w.slug === slug);
if (!wallpaper) {
  return Astro.redirect('/404');
}

// Calculate Previous and Next Wallpaper Slugs for navigation
const currentIndex = wallpapers.findIndex((w) => w.slug === wallpaper.slug);
const prevWallpaper = wallpapers[(currentIndex - 1 + wallpapers.length) % wallpapers.length];
const nextWallpaper = wallpapers[(currentIndex + 1) % wallpapers.length];

// Harmonic Dominant Palette Generator based on true wallpaper aesthetics
function getHarmonicPalette(baseHex: string, category: string): { hex: string; label: string; name: string }[] {
  const catLower = (category || '').toLowerCase();
  if (catLower.includes('cyberpunk') || catLower.includes('neon')) {
    return [
      { hex: baseHex || '#00F0FF', label: baseHex || '#00F0FF', name: 'Cyan Neon' },
      { hex: '#FF0055', label: '#FF0055', name: 'Magenta Pink' },
      { hex: '#8A2BE2', label: '#8A2BE2', name: 'Electric Purple' },
      { hex: '#1A1A2E', label: '#1A1A2E', name: 'Obsidian Night' },
      { hex: '#C2FF06', label: '#C2FF06', name: 'Acid Lime' },
    ];
  } else if (catLower.includes('nature')) {
    return [
      { hex: baseHex || '#2A9D8F', label: baseHex || '#2A9D8F', name: 'Alpine Forest' },
      { hex: '#E76F51', label: '#E76F51', name: 'Sunset Amber' },
      { hex: '#457B9D', label: '#457B9D', name: 'Glacial Blue' },
      { hex: '#1D3557', label: '#1D3557', name: 'Deep Lake' },
      { hex: '#E9C46A', label: '#E9C46A', name: 'Golden Hour' },
    ];
  } else if (catLower.includes('amoled') || catLower.includes('dark')) {
    return [
      { hex: '#000000', label: '#000000', name: 'Pitch OLED Void' },
      { hex: baseHex || '#E71D36', label: baseHex || '#E71D36', name: 'Vibrant Accent' },
      { hex: '#16191E', label: '#16191E', name: 'Dark Slate' },
      { hex: '#00F0FF', label: '#00F0FF', name: 'Luminous Cyan' },
      { hex: '#C2FF06', label: '#C2FF06', name: 'HDR Lime' },
    ];
  } else if (catLower.includes('cars') || catLower.includes('supercar')) {
    return [
      { hex: baseHex || '#E71D36', label: baseHex || '#E71D36', name: 'Racing Rosso' },
      { hex: '#12151A', label: '#12151A', name: 'Matte Carbon' },
      { hex: '#FFB703', label: '#FFB703', name: 'GT Amber' },
      { hex: '#00F0FF', label: '#00F0FF', name: 'Xenon Blue' },
      { hex: '#8E949E', label: '#8E949E', name: 'Titanium Grey' },
    ];
  } else if (catLower.includes('space') || catLower.includes('cosmic')) {
    return [
      { hex: baseHex || '#4B0082', label: baseHex || '#4B0082', name: 'Cosmic Violet' },
      { hex: '#0B0D17', label: '#0B0D17', name: 'Interstellar Void' },
      { hex: '#00E5FF', label: '#00E5FF', name: 'Nebula Cyan' },
      { hex: '#FF2E88', label: '#FF2E88', name: 'Stellar Pink' },
      { hex: '#FFD166', label: '#FFD166', name: 'Supernova Gold' },
    ];
  }
  return [
    { hex: baseHex || '#C2FF06', label: baseHex || '#C2FF06', name: 'Primary Glow' },
    { hex: '#00F0FF', label: '#00F0FF', name: 'Secondary Cyan' },
    { hex: '#8A2BE2', label: '#8A2BE2', name: 'Deep Purple' },
    { hex: '#0E1117', label: '#0E1117', name: 'Obsidian' },
    { hex: '#FF385C', label: '#FF385C', name: 'Vibrant Coral' },
  ];
}

const dominantPalette = getHarmonicPalette(wallpaper.colorHex || '#FF0055', wallpaper.category || '');

const tagsList = wallpaper.tags && wallpaper.tags.length > 0 
  ? wallpaper.tags 
  : [
      wallpaper.category || 'Cyberpunk',
      'City',
      'Neon',
      'Night',
      '4K UHD',
      'Futuristic',
      'AMOLED',
    ];

const currentScreenTypes = wallpaper.screenTypes || ['desktop-4k', 'phone-iphone'];
const supportedScreens = SCREEN_TYPES.filter((s) => currentScreenTypes.includes(s.key));

// Parent Category & Sub-Topic Silo Resolution
const parentCategory = MAIN_CATEGORIES.find((c) =>
  (wallpaper.category || '').toLowerCase().includes(c.id.toLowerCase()) ||
  (wallpaper.category || '').toLowerCase().includes(c.name.toLowerCase()) ||
  (c.subTopics || []).some((s) => (wallpaper.tags || []).some((t) => slugifyTag(t) === s.slug))
);
const categoryHubInfo = parentCategory || null;

// Stop-words & System tokens to exclude from similarity matching
const SIMILARITY_STOP_TAGS = new Set([
  'desktop', 'phone', 'mobile', '4k', '8k', 'hd', 'uhd', 'ultra-hd', 'ultra',
  '1080p', 'wallpaper', 'wallpapers', 'background', 'backgrounds',
  'free', 'download', 'curated', 'lossless', 'vertical', 'horizontal', 'amoled',
  'minimal', 'wallpapercat', 'aesthetic', 'and', 'the', 'photo', 'image', 'cool'
]);

const currentSpecificTags = (wallpaper.tags || [])
  .map((t) => slugifyTag(t))
  .filter((t) => !SIMILARITY_STOP_TAGS.has(t));

const wpCatLower = (wallpaper.category || '').toLowerCase();
const parentCatId = (parentCategory?.id || '').toLowerCase();
const parentCatName = (parentCategory?.name || '').toLowerCase();

// Strict Category Pool (Guarantees zero cross-category pollution)
const strictCategoryPool = wallpapers.filter((w) => {
  if (w.slug === wallpaper.slug) return false;
  const wCat = (w.category || '').toLowerCase();
  const matchCategory =
    (parentCatId && (wCat.includes(parentCatId) || parentCatId.includes(wCat))) ||
    (parentCatName && (wCat.includes(parentCatName) || parentCatName.includes(wCat))) ||
    (wpCatLower && (wCat.includes(wpCatLower) || wpCatLower.includes(wCat)));
  return matchCategory;
});

// 1. Same-franchise / specific tag matches inside same universe
const franchiseMatches = strictCategoryPool.filter((w) => {
  const wTags = (w.tags || []).map((t) => slugifyTag(t));
  return currentSpecificTags.some((t) => wTags.includes(t));
});

// 2. Remaining wallpapers from the exact same category
const remainingSameCategory = strictCategoryPool.filter((w) => !franchiseMatches.includes(w));

const candidatePool = [
  ...franchiseMatches,
  ...remainingSameCategory
];

const seenSlugs = new Set<string>();
const seenImages = new Set<string>();
const displaySimilar: Wallpaper[] = [];

for (const wp of candidatePool) {
  if (displaySimilar.length >= 8) break;
  if (!seenSlugs.has(wp.slug) && !seenImages.has(wp.sourceCdn)) {
    seenSlugs.add(wp.slug);
    seenImages.add(wp.sourceCdn);
    displaySimilar.push(wp);
  }
}

// Fallback only if candidate pool < 8
if (displaySimilar.length < 8) {
  for (const wp of wallpapers) {
    if (displaySimilar.length >= 8) break;
    if (wp.slug !== wallpaper.slug && !seenSlugs.has(wp.slug) && !seenImages.has(wp.sourceCdn)) {
      const wCat = (wp.category || '').toLowerCase();
      if (wCat.includes(wpCatLower) || wpCatLower.includes(wCat)) {
        seenSlugs.add(wp.slug);
        seenImages.add(wp.sourceCdn);
        displaySimilar.push(wp);
      }
    }
  }
}


const schema = {
  '@context': 'https://schema.org',
  '@type': 'ImageObject',
  name: wallpaper.title,
  caption: `${wallpaper.title} in 4K Ultra HD resolution`,
  contentUrl: wallpaper.sourceCdn,
  thumbnailUrl: wallpaper.sourceCdn,
  encodingFormat: 'image/jpeg',
  width: '3840',
  height: '2160',
  license: 'https://www.walpix.site/terms',
  acquireLicensePage: 'https://www.walpix.site/terms',
  author: {
    '@type': 'Organization',
    name: 'Walpix Studio',
  },
};
---

<Layout
  title={`${wallpaper.title} (4K UHD Wallpaper)`}
  description={`Download ${wallpaper.title} 4K Ultra HD wallpaper. High-resolution background for desktop, iPhone, Android, and ultrawide monitors.`}
  image={wallpaper.sourceCdn}
  preloadImage={wallpaper.sourceCdn}
  schema={schema}
>
  <!-- Global Header (Desktop Only on Detail Page) -->
  <div class="hidden lg:block">
    <Header currentCategory="wallpapers" />
  </div>

  <!-- Isolated Wallpaper Detail Page Wrapper -->
  <main class="wallpaper-detail-page min-h-screen bg-[#020406] text-[#F8FAFC] relative overflow-hidden">
    
    <!-- Ambient Animated Floating Lime/Green Glow Drifting in Background -->
    <div class="fixed inset-0 pointer-events-none z-0 overflow-hidden">
      <div class="ambient-drift-1 absolute -top-28 right-[8%] w-[680px] h-[680px] bg-walpix-lime/[0.045] rounded-full blur-[160px]"></div>
      <div class="ambient-drift-2 absolute top-1/3 -left-20 w-[720px] h-[720px] bg-walpix-lime/[0.038] rounded-full blur-[180px]"></div>
      <div class="ambient-drift-3 absolute bottom-20 right-[15%] w-[650px] h-[650px] bg-walpix-lime/[0.042] rounded-full blur-[160px]"></div>
    </div>

    <!-- ========================================================
         DESKTOP-ONLY 2-COLUMN DETAIL LAYOUT (100% UNTOUCHED FOR PC)
         ======================================================== -->
    <div class="hidden lg:block relative z-10 w-full max-w-[1480px] xl:max-w-[1520px] mx-auto px-4 sm:px-6 lg:px-8 py-6 lg:py-8">
      
      <!-- MAIN 2-COLUMN DETAIL LAYOUT -->
      <div class="detail-grid-wrapper grid grid-cols-1 lg:grid-cols-[minmax(0,1.75fr)_460px] xl:grid-cols-[minmax(0,1.8fr)_480px] gap-6 lg:gap-8 items-start">
        
        <!-- ========================================================
             LEFT COLUMN: MAIN VIEWER & DIRECTLY UNDERNEATH LIVE SIMULATION
             ======================================================== -->
        <section class="space-y-5 sm:space-y-6 detail-left-column">
          
          <!-- 1. Main Wallpaper Viewer Container -->
          <div id="detail-viewer-container" class="detail-viewer group relative w-full aspect-[16/10] sm:aspect-[16/9] lg:aspect-[16/10] bg-[#05080a] shadow-2xl rounded-2xl overflow-hidden border border-white/[0.08] transition-all duration-500">
            <!-- Hero Wallpaper Image -->
            <img
              id="detail-main-img"
              src={wallpaper.sourceCdn}
              alt={wallpaper.title}
              referrerpolicy="no-referrer"
              class="w-full h-full object-cover select-none transition-transform duration-700 ease-out group-hover:scale-[1.02]"
              onerror="this.src='https://images.unsplash.com/photo-1518709268805-4e9042af9f23?w=1600&q=80'"
            />

            <!-- Top Left: 4K UHD Badge (Minimal Frosted Glass) -->
            <div class="absolute top-2.5 sm:top-4 left-2.5 sm:left-4 z-20 pointer-events-none">
              <span class="viewer-badge inline-flex items-center justify-center font-mono font-bold text-xs uppercase tracking-wider">
                4K UHD
              </span>
            </div>

            <!-- Mobile Aspect Ratio Toggle (Phone 9:16 vs Wide 16:9) - Mobile only -->
            <div class="mobile-aspect-switcher lg:hidden absolute top-2.5 left-1/2 -translate-x-1/2 z-20 flex items-center bg-black/65 backdrop-blur-md border border-white/20 rounded-full p-0.5 shadow-xl">
              <button
                id="aspect-phone-btn"
                type="button"
                class="aspect-toggle-btn px-2.5 py-1 rounded-full text-[11px] font-semibold text-white/70 hover:text-white transition-all flex items-center gap-1 cursor-pointer"
                title="View in 9:16 Phone Ratio"
              >
                <svg class="w-3 h-3 text-walpix-lime" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z"/></svg>
                <span>9:16 Phone</span>
              </button>
              <button
                id="aspect-wide-btn"
                type="button"
                class="aspect-toggle-btn is-active px-2.5 py-1 rounded-full text-[11px] font-semibold text-white transition-all flex items-center gap-1 bg-white/20 cursor-pointer"
                title="View in 16:9 Landscape Ratio"
              >
                <svg class="w-3 h-3 text-white/90" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
                <span>16:9 Wide</span>
              </button>
            </div>

            <!-- Top Right: Desktop Aspect Badge -->
            <div class="hidden lg:block absolute top-3 sm:top-4 right-16 sm:right-20 z-20 pointer-events-none">
              <span class="viewer-badge-aspect inline-flex items-center justify-center font-mono font-semibold text-xs px-2.5 py-1 rounded-full bg-black/45 border border-white/20 text-white/90 backdrop-blur-md">
                16:9
              </span>
            </div>

            <!-- Favorite Counter Pill (Top-Right) -->
            <div class="absolute top-2.5 sm:top-4 right-2.5 sm:right-4 z-20">
              <button
                id="detail-fav-btn"
                class="favorite-pill h-8 sm:h-9 px-3 sm:px-4 rounded-full flex items-center gap-1.5 transition-all duration-300 cursor-pointer hover:scale-105 active:scale-95"
                aria-label="Add to favorites"
              >
                <svg class="w-3.5 h-3.5 sm:w-4 sm:h-4 text-white transition-colors duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z" />
                </svg>
                <span class="text-xs font-semibold text-white">12.4K</span>
              </button>
            </div>

            <!-- Image Navigation Arrows (Left & Right) - Sleek & compact on mobile -->
            <a
              href={`/wallpapers/${prevWallpaper.slug}`}
              class="viewer-control absolute left-2 sm:left-4 top-1/2 -translate-y-1/2 w-8 h-8 sm:w-11 sm:h-11 rounded-full flex items-center justify-center text-white z-20 transition-all duration-300 hover:scale-110 active:scale-95 shadow-lg"
              aria-label="Previous wallpaper"
            >
              <svg class="w-4 h-4 sm:w-5 sm:h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M15 19l-7-7 7-7" />
              </svg>
            </a>

            <a
              href={`/wallpapers/${nextWallpaper.slug}`}
              class="viewer-control absolute right-2 sm:right-4 top-1/2 -translate-y-1/2 w-8 h-8 sm:w-11 sm:h-11 rounded-full flex items-center justify-center text-white z-20 transition-all duration-300 hover:scale-110 active:scale-95 shadow-lg"
              aria-label="Next wallpaper"
            >
              <svg class="w-4 h-4 sm:w-5 sm:h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7" />
              </svg>
            </a>

            <!-- Fullscreen / Expand Button on Viewer (Dual Diagonal Arrows) -->
            <button
              id="open-fullscreen-preview-btn"
              type="button"
              class="absolute bottom-2.5 sm:bottom-3 right-2.5 sm:right-3 z-20 h-7 sm:h-8 px-2.5 sm:px-3 rounded-full bg-black/65 backdrop-blur-md border border-white/20 text-white flex items-center gap-1.5 text-[11px] sm:text-xs font-semibold shadow-lg hover:border-walpix-lime hover:text-walpix-lime transition-all active:scale-95 cursor-pointer"
              title="Expand Fullscreen Phone Preview"
            >
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.2" d="M4 8V4m0 0h4M4 4l5 5m11-1V4m0 0h-4m4 0l-5 5M4 16v4m0 0h4m-4 0l5-5m11 5l-5-5m5 5v-4m0 4h-4" />
              </svg>
              <span>Expand</span>
            </button>
          </div>

          <!-- 2. Live Screen Simulation (Interactive Multi-Device Simulation Engine) -->
          <div class="simulation detail-sim-container p-6 sm:p-7 rounded-[18px] space-y-6">
            
            <!-- Simulation Header & Device Selector Tabs -->
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-4 border-b border-white/10">
              <div class="flex items-center gap-3">
                <div class="w-9 h-9 rounded-xl bg-[#C2FF06]/10 border border-[#C2FF06]/40 flex items-center justify-center text-[#C2FF06] shadow-[0_0_12px_rgba(194,255,6,0.2)]">
                  <svg class="w-5 h-5 text-[#C2FF06]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                  </svg>
                </div>
                <div>
                  <h3 class="text-base sm:text-lg font-display font-bold text-white leading-tight">
                    Live Screen Simulation
                  </h3>
                  <p class="text-xs text-[#8E969F]">
                    See how this wallpaper looks on different devices
                  </p>
                </div>
              </div>

              <!-- Device Selector Buttons (All 5 Target Screen Types) -->
              <div class="flex items-center gap-2 overflow-x-auto no-scrollbar scroll-smooth touch-pan-x overscroll-x-contain py-1">
                <button data-device="macbook" class="device-option is-active px-3.5 py-1.5 rounded-full text-xs font-semibold cursor-pointer transition-all whitespace-nowrap shrink-0 flex items-center gap-1.5">
                  <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
                  <span>MacBook</span>
                </button>
                <button data-device="iphone" class="device-option px-3.5 py-1.5 rounded-full text-xs font-semibold cursor-pointer transition-all whitespace-nowrap shrink-0 flex items-center gap-1.5">
                  <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z"/></svg>
                  <span>iPhone</span>
                </button>
                <button data-device="desktop" class="device-option px-3.5 py-1.5 rounded-full text-xs font-semibold cursor-pointer transition-all whitespace-nowrap shrink-0 flex items-center gap-1.5">
                  <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
                  <span>Desktop 4K</span>
                </button>
                <button data-device="tablet" class="device-option px-3.5 py-1.5 rounded-full text-xs font-semibold cursor-pointer transition-all whitespace-nowrap shrink-0 flex items-center gap-1.5">
                  <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 18h.01M7 21h10a2 2 0 002-2V5a2 2 0 00-2-2H7a2 2 0 00-2 2v14a2 2 0 002 2z"/></svg>
                  <span>Tablet (iPad)</span>
                </button>
