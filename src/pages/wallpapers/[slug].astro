  const btnSub = document.getElementById('btn-download-subtitle');
  const btnBadge = document.getElementById('btn-download-badge');
  const activeResLabel = document.getElementById('active-res-label');

  // Toggle Dropdown
  resTrigger?.addEventListener('click', (e) => {
    e.stopPropagation();
    resMenu?.classList.toggle('hidden');
    resChevron?.classList.toggle('rotate-180');
  });

  // Close on outside click
  document.addEventListener('click', (e) => {
    if (!resMenu?.contains(e.target as Node) && !resTrigger?.contains(e.target as Node)) {
      resMenu?.classList.add('hidden');
      resChevron?.classList.remove('rotate-180');
    }
  });

  // Handle Preset Select
  const resButtons = document.querySelectorAll('.res-select-btn');
