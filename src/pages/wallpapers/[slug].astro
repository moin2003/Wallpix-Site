---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { wallpapers, type Wallpaper } from '../../data/wallpapers';

export async function getStaticPaths() {
  return wallpapers.map((wp) => ({
    params: { slug: wp.slug },
    props: { wallpaper: wp },
  }));
}

interface Props {
  wallpaper: Wallpaper;
}

const { wallpaper } = Astro.props;

// Dominant colors from the mockup
const dominantPalette = [
  { hex: '#FF0055', label: '#FF0055' },
  { hex: '#8A2BE2', label: '#8A2BE2' },
  { hex: '#00E5FF', label: '#00E5FF' },
  { hex: '#1A1A2E', label: '#1A1A2E' },
  { hex: '#FF77AA', label: '#FF77AA' },
];

const tagsList = [
  'Cyberpunk',
  'City',
  'Neon',
  'Night',
  '4K',
  'Anime Style',
  'Futuristic',
];

const schema = {
  '@context': 'https://schema.org',
  '@type': 'ImageObject',
  name: wallpaper.title,
  caption: `${wallpaper.title} in 4K Ultra HD resolution`,
  contentUrl: wallpaper.sourceCdn,
  thumbnailUrl: wallpaper.sourceCdn,
  encodingFormat: 'image/jpeg',
  width: '3840',
  height: '2160',
  license: 'https://lumina-wallpapers.com/terms',
  acquireLicensePage: 'https://lumina-wallpapers.com/terms',
  author: {
    '@type': 'Organization',
    name: 'Lumina Studio',
  },
};
---

<Layout
  title={`${wallpaper.title} (4K UHD Wallpaper)`}
  description={`Download ${wallpaper.title} 4K Ultra HD wallpaper. High-resolution background for desktop, iPhone, Android, and ultrawide monitors.`}
  image={wallpaper.sourceCdn}
  schema={schema}
>
  <!-- Floating Header -->
  <Header currentCategory="wallpapers" />

  <main class="w-full max-w-[1550px] mx-auto px-4 sm:px-6 lg:px-[38px] pt-3 pb-12 min-h-screen">
    
    <!-- 2-Column Media-Detail Workspace -->
    <div class="grid grid-cols-1 xl:grid-cols-[minmax(0,2.15fr)_480px] gap-7 items-start">
      
      <!-- ========================================================
           LEFT COLUMN: Wide ~2.4:1 Hero Preview & Live Simulation
           ======================================================== -->
      <section class="space-y-4">
        
        <!-- Large Wide ~2.4:1 Wallpaper Hero Preview Container -->
        <div class="lumina-detail-hero group bg-[#05080A]">
          <!-- Wallpaper Image (object-cover) -->
          <img
            id="detail-main-img"
            src={wallpaper.sourceCdn}
            alt={wallpaper.title}
            referrerpolicy="no-referrer"
            class="w-full h-full object-cover select-none transition-transform duration-500 ease-out group-hover:scale-[1.02]"
            onerror="this.src='https://images.unsplash.com/photo-1518709268805-4e9042af9f23?w=1600&q=80'"
          />

          <!-- Top-Left: 4K UHD Pill Badge -->
          <div class="absolute top-4 left-4 z-20 pointer-events-none">
            <span class="lumina-4k-pill">
              4K UHD
            </span>
          </div>

          <!-- Top-Right: Favorite Pill Counter -->
          <div class="absolute top-4 right-4 z-20">
            <button
              id="fav-btn"
              class="h-9 px-3.5 rounded-full bg-[#05080A]/70 hover:bg-[#05080A]/90 border border-white/15 text-white text-xs font-semibold flex items-center gap-1.5 backdrop-blur-md transition-all shadow-sm"
            >
              <svg class="w-4 h-4 text-lumina-pink" fill="currentColor" viewBox="0 0 24 24">
                <path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z" />
              </svg>
              <span>12.4K</span>
            </button>
          </div>

          <!-- Left Navigation Circle Arrow -->
          <button
            id="prev-wp-btn"
            aria-label="Previous wallpaper"
            class="absolute left-4 top-1/2 -translate-y-1/2 w-11 h-11 rounded-full bg-[#030608]/75 hover:bg-[#030608]/90 border border-white/30 hover:border-lumina-lime text-white flex items-center justify-center backdrop-blur-md transition-all shadow-lg hover:shadow-[0_0_12px_rgba(194,255,0,0.30)] z-20"
          >
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M15 19l-7-7 7-7" />
            </svg>
          </button>

          <!-- Right Navigation Circle Arrow -->
          <button
            id="next-wp-btn"
            aria-label="Next wallpaper"
            class="absolute right-4 top-1/2 -translate-y-1/2 w-11 h-11 rounded-full bg-[#030608]/75 hover:bg-[#030608]/90 border border-white/30 hover:border-lumina-lime text-white flex items-center justify-center backdrop-blur-md transition-all shadow-lg hover:shadow-[0_0_12px_rgba(194,255,0,0.30)] z-20"
          >
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7" />
            </svg>
          </button>
        </div>

        <!-- ========================================================
             Live Screen Simulation (MacBook Pro 16" & iPhone 16 Pro)
             ======================================================== -->
        <div class="lumina-simulation p-5 sm:p-6 border border-white/16 space-y-6">
          
          <!-- Simulation Header -->
          <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
            <div class="flex items-center gap-3">
              <div class="w-9 h-9 rounded-xl bg-lumina-lime/10 border border-lumina-lime/30 flex items-center justify-center text-lumina-lime">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                </svg>
              </div>
              <div>
                <h3 class="text-base sm:text-[17px] font-display font-bold text-white leading-tight">
                  Live Screen Simulation
                </h3>
                <p class="text-xs text-[#8F979F]">
                  See how this wallpaper looks on different devices
                </p>
              </div>
            </div>

            <!-- Device Tabs -->
            <div class="flex items-center gap-1.5 overflow-x-auto no-scrollbar">
              <button class="lumina-device-tab active">MacBook</button>
              <button class="lumina-device-tab">iPhone</button>
              <button class="lumina-device-tab">Desktop</button>
              <button class="lumina-device-tab">Tablet</button>
            </div>
          </div>

          <!-- Studio Simulation Stage -->
          <div class="relative w-full rounded-2xl bg-black/40 border border-white/[0.06] p-6 sm:p-8 flex flex-col md:flex-row items-center justify-center gap-8 sm:gap-12 min-h-[360px]">
            
            <!-- 💻 MacBook Pro 16" Frame -->
            <div class="flex flex-col items-center space-y-2">
              <div class="w-full max-w-[420px] bg-[#16181b] rounded-t-xl p-2 pb-1 border-t border-x border-white/20 shadow-2xl">
                <!-- Laptop Screen -->
                <div class="relative aspect-[16/10] rounded-lg overflow-hidden bg-black shadow-inner border border-black">
                  <img
                    src={wallpaper.sourceCdn}
                    alt={`${wallpaper.title} on MacBook`}
                    referrerpolicy="no-referrer"
                    class="w-full h-full object-cover"
                  />
                  <!-- Dock Mockup -->
                  <div class="absolute bottom-1.5 left-1/2 -translate-x-1/2 px-2.5 py-0.5 rounded-lg bg-white/10 backdrop-blur-md border border-white/10 flex items-center gap-1.5">
                    <span class="w-2.5 h-2.5 rounded bg-blue-500/80"></span>
                    <span class="w-2.5 h-2.5 rounded bg-purple-500/80"></span>
                    <span class="w-2.5 h-2.5 rounded bg-emerald-500/80"></span>
                    <span class="w-2.5 h-2.5 rounded bg-amber-500/80"></span>
                  </div>
                </div>
              </div>
              <!-- Laptop Base -->
              <div class="w-[450px] max-w-full h-2.5 bg-[#25282e] rounded-b-lg border-b border-x border-white/20 flex items-center justify-center shadow-md">
                <div class="w-14 h-1 bg-[#121316] rounded-full"></div>
              </div>
              <!-- Label -->
              <span class="text-[11px] font-medium text-gray-400 flex items-center gap-1 pt-1">
                 MacBook Pro 16"
              </span>
            </div>

            <!-- 📱 iPhone 16 Pro Frame -->
            <div class="flex flex-col items-center space-y-2">
              <div class="relative w-[150px] aspect-[9/19.5] rounded-[34px] p-2 bg-[#1b1d22] border-[3px] border-[#383b45] shadow-2xl">
                <!-- Dynamic Island -->
                <div class="absolute top-3.5 left-1/2 -translate-x-1/2 w-12 h-3.5 bg-black rounded-full z-30 flex items-center justify-end pr-1">
                  <span class="w-1.5 h-1.5 rounded-full bg-blue-500/50"></span>
                </div>
                <!-- Phone Screen -->
                <div class="relative w-full h-full rounded-[26px] overflow-hidden bg-black shadow-inner">
                  <img
                    src={wallpaper.sourceCdn}
                    alt={`${wallpaper.title} on iPhone`}
                    referrerpolicy="no-referrer"
                    class="w-full h-full object-cover"
                  />
                  <!-- Lockscreen Clock -->
                  <div class="absolute top-8 inset-x-0 text-center text-white drop-shadow-md">
                    <span class="text-[9px] font-medium tracking-wide">Monday, September 9</span>
                    <h4 class="text-2xl font-black font-display leading-tight">9:41</h4>
                  </div>
                </div>
              </div>
              <!-- Label -->
              <span class="text-[11px] font-medium text-gray-400 flex items-center gap-1 pt-1">
                 iPhone 16 Pro
              </span>
            </div>

          </div>

        </div>

      </section>

      <!-- ========================================================
           RIGHT COLUMN: Metadata, Download CTA, Specs & Ad
           ======================================================== -->
      <aside class="space-y-4">
        
        <!-- Breadcrumb Navigation -->
        <nav class="flex items-center gap-2 text-[11px] text-[#737A82]" aria-label="Breadcrumb">
          <a href="/" class="hover:text-white transition">Home</a>
          <span>›</span>
          <a href="/category/cyberpunk-neon" class="hover:text-white transition">Cyberpunk</a>
          <span>›</span>
          <span class="text-[#D8DCE0] truncate max-w-[200px]">{wallpaper.title}</span>
        </nav>

        <!-- Title -->
        <h1 class="text-2xl sm:text-[28px] font-display font-bold text-[#F8FAFC] leading-[1.1] tracking-tight">
          {wallpaper.title}
        </h1>

        <!-- Author Row & Stats -->
        <div class="flex items-center gap-2 text-xs text-[#9AA1A8] flex-wrap">
          <div class="flex items-center gap-1.5 text-[#E7E9EB] font-semibold">
            <div class="w-5 h-5 rounded-full bg-lumina-lime/20 border border-lumina-lime/40 flex items-center justify-center text-[10px] text-lumina-lime font-bold">
              L
            </div>
            <span>By Lumina Studio</span>
            <svg class="w-3.5 h-3.5 text-[#3B82F6]" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M6.267 3.455a3.066 3.066 0 001.745-.723 3.066 3.066 0 013.976 0 3.066 3.066 0 001.745.723 3.066 3.066 0 012.812 2.812c.051.643.304 1.254.723 1.745a3.066 3.066 0 010 3.976 3.066 3.066 0 00-.723 1.745 3.066 3.066 0 01-2.812 2.812 3.066 3.066 0 00-1.745.723 3.066 3.066 0 01-3.976 0 3.066 3.066 0 00-1.745-.723 3.066 3.066 0 01-2.812-2.812 3.066 3.066 0 00-.723-1.745 3.066 3.066 0 010-3.976 3.066 3.066 0 00.723-1.745 3.066 3.066 0 012.812-2.812zm7.44 5.252a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
            </svg>
          </div>
          <span>•</span>
          <span>{wallpaper.views?.toLocaleString() || '248.7K'} views</span>
          <span>•</span>
          <span class="text-[#858C94]">3 days ago</span>
        </div>

        <!-- Description -->
        <p class="text-[13px] text-[#B2B7BE] leading-relaxed">
          A breathtaking cyberpunk city skyline with neon lights, futuristic skyscrapers and a dreamy sunset atmosphere. Perfect for your desktop or mobile screen.
        </p>

        <!-- Resolution Card -->
        <div class="p-3.5 rounded-[18px] bg-[rgba(9,13,16,0.72)] border border-white/17 flex items-center justify-between">
          <div class="flex items-center gap-2">
            <span class="font-mono font-bold text-sm sm:text-base text-white tracking-wide">
              3840 × 2160 (4K UHD)
            </span>
          </div>
          <span class="px-2.5 py-1 rounded-full bg-[rgba(194,255,0,0.06)] border border-[#C2FF00] text-[#C2FF00] text-[10px] font-bold tracking-wider uppercase flex items-center gap-1 shadow-[0_0_8px_rgba(194,255,0,0.20)]">
            <span>Original Resolution</span>
            <span>👑</span>
          </span>
        </div>

        <!-- Primary Action: 58px High Solid Electric Lime Download Button -->
        <button
          id="main-download-4k-btn"
          data-url={wallpaper.sourceCdn}
          data-filename={`${wallpaper.slug}-4k.jpg`}
          class="lumina-download-primary w-full px-6 flex items-center justify-between gap-3 group cursor-pointer"
        >
          <div class="flex items-center gap-3 text-left">
            <svg class="w-6 h-6 text-[#050700]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
            </svg>
            <div>
              <div class="font-display font-bold text-base text-[#050700] leading-tight">
                Download Original 4K
              </div>
              <div class="text-[10px] font-semibold text-[#050700]/75 tracking-tight">
                3840 × 2160 • High Quality • No Watermark
              </div>
            </div>
          </div>
          <svg class="w-5 h-5 text-[#050700] transform group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3" />
          </svg>
        </button>

        <!-- Secondary Action: Custom Crop & Resize for Phone -->
        <a
          href={`/tool/cropper?url=${encodeURIComponent(wallpaper.sourceCdn)}`}
          class="lumina-secondary-button w-full px-5 flex items-center justify-between gap-3 group cursor-pointer"
        >
          <div class="flex items-center gap-3 text-left">
            <span class="text-lg">✂️</span>
            <div>
              <div class="font-semibold text-sm text-[#F0F2F4] leading-tight">
                Custom Crop & Resize for Phone
              </div>
              <div class="text-[10px] text-[#8E969F]">
                Create wallpaper for any device size
              </div>
            </div>
          </div>
          <svg class="w-4 h-4 text-gray-400 group-hover:text-white transform group-hover:translate-x-1 transition-all" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
          </svg>
        </a>

        <!-- Other Resolutions Selector (4 Equal Columns) -->
        <div class="space-y-2 pt-1">
          <h4 class="text-xs font-semibold text-[#DDE0E3]">Other Resolutions</h4>
          <div class="grid grid-cols-4 gap-2">
            <button data-w="3840" data-h="2160" class="res-card-btn active p-2 rounded-[13px] bg-[rgba(194,255,0,0.045)] border border-[#C2FF00] shadow-[0_0_10px_rgba(194,255,0,0.15)] text-left flex flex-col justify-between h-[50px] transition">
              <span class="text-[11px] font-bold text-white leading-none">🖥 4K UHD</span>
              <span class="text-[9px] font-mono text-[#C2FF00]">3840 × 2160</span>
            </button>
            <button data-w="2560" data-h="1440" class="res-card-btn p-2 rounded-[13px] bg-[rgba(14,18,22,0.80)] border border-white/18 hover:border-white/30 text-left flex flex-col justify-between h-[50px] transition">
              <span class="text-[11px] font-medium text-gray-200 leading-none">🖥 2K QHD</span>
              <span class="text-[9px] font-mono text-gray-400">2560 × 1440</span>
            </button>
            <button data-w="1920" data-h="1080" class="res-card-btn p-2 rounded-[13px] bg-[rgba(14,18,22,0.80)] border border-white/18 hover:border-white/30 text-left flex flex-col justify-between h-[50px] transition">
              <span class="text-[11px] font-medium text-gray-200 leading-none">🖥 1080p</span>
              <span class="text-[9px] font-mono text-gray-400">1920 × 1080</span>
            </button>
            <button data-w="1080" data-h="2400" class="res-card-btn p-2 rounded-[13px] bg-[rgba(14,18,22,0.80)] border border-white/18 hover:border-white/30 text-left flex flex-col justify-between h-[50px] transition">
              <span class="text-[11px] font-medium text-gray-200 leading-none">📱 Mobile</span>
              <span class="text-[9px] font-mono text-gray-400">1080 × 2400</span>
            </button>
          </div>
        </div>

        <!-- Dominant Colors Palette -->
        <div class="space-y-2 pt-1">
          <div class="flex items-center justify-between">
            <h4 class="text-xs font-semibold text-[#DDE0E3]">Dominant Colors</h4>
            <button id="copy-palette-btn" class="text-[11px] text-gray-400 hover:text-white flex items-center gap-1 transition" title="Copy Palette">
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" />
              </svg>
            </button>
          </div>
          <div class="flex items-center justify-between gap-2">
            {dominantPalette.map((c) => (
              <div class="flex flex-col items-center gap-1">
                <span
                  class="w-9 h-9 rounded-full border border-white/15 shadow-sm transition-transform hover:scale-110 cursor-pointer"
                  style={`background-color: ${c.hex};`}
                  title={c.label}
                ></span>
                <span class="text-[9px] font-mono text-[#A4AAB1] uppercase">{c.label}</span>
              </div>
            ))}
          </div>
        </div>

        <!-- Tags -->
        <div class="space-y-2 pt-1">
          <h4 class="text-xs font-semibold text-[#DDE0E3]">Tags</h4>
          <div class="flex flex-wrap gap-1.5">
            {tagsList.map((tag) => (
              <a
                href={`/category/all?q=${tag.toLowerCase()}`}
                class="lumina-tag hover:border-lumina-lime/40 hover:text-white transition"
              >
                {tag}
              </a>
            ))}
          </div>
        </div>

        <!-- Statistics & Share Bar -->
        <div class="pt-4 border-t border-white/12 flex items-center justify-between text-xs text-[#9AA1A8]">
          <div class="flex items-center gap-1 text-gray-200">
            <span>👁</span>
            <span class="font-bold text-white">248.7K</span>
            <span class="text-[11px] text-gray-400">Views</span>
          </div>
          <div class="flex items-center gap-1 text-gray-200">
            <span class="text-lumina-pink">♡</span>
            <span class="font-bold text-white">12.4K</span>
            <span class="text-[11px] text-gray-400">Likes</span>
          </div>
          <div class="flex items-center gap-1 text-gray-200">
            <span>↓</span>
            <span class="font-bold text-white">3.1K</span>
            <span class="text-[11px] text-gray-400">Downloads</span>
          </div>
          <button
            id="share-btn"
            class="h-[34px] px-3.5 rounded-[12px] bg-[rgba(20,25,30,0.80)] border border-white/20 hover:border-white/35 text-white text-xs font-semibold flex items-center gap-1.5 transition"
          >
            <svg class="w-3.5 h-3.5 text-lumina-lime" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.684 13.342C8.886 12.938 9 12.482 9 12c0-.482-.114-.938-.316-1.342m0 2.684a3 3 0 110-2.684m0 2.684l6.632 3.316m-6.632-6l6.632-3.316m0 0a3 3 0 105.367-2.684 3 3 0 00-5.367 2.684zm0 9.316a3 3 0 105.368 2.684 3 3 0 00-5.368-2.684z" />
            </svg>
            <span>Share</span>
          </button>
        </div>

        <!-- ========================================================
             Advertisement Card (Magenta / LG UltraGear)
             ======================================================== -->
        <div class="lumina-ad-magenta p-3.5 space-y-2 mt-4">
          <div class="flex items-center justify-between text-[10px] uppercase font-mono tracking-wider">
            <span class="px-2 py-0.5 rounded-full bg-white/[0.08] text-gray-300 font-bold">
              ADVERTISEMENT
            </span>
            <span class="text-gray-400 text-[10px]">ⓘ</span>
          </div>

          <div class="flex items-center justify-between gap-3">
            <div class="space-y-1">
              <div class="flex items-center gap-1.5">
                <span class="w-4 h-4 rounded bg-[#E5004F] flex items-center justify-center text-[8px] font-bold text-white">LG</span>
                <span class="text-xs font-bold text-white">UltraGear™</span>
              </div>
              <h4 class="text-xs sm:text-[13px] font-bold text-white leading-tight">
                Level Up Your Visual World
              </h4>
              <p class="text-[10px] text-gray-400">4K OLED | 240Hz | 0.03ms</p>
            </div>

            <!-- Monitor Visual Thumbnail -->
            <div class="w-24 aspect-[16/10] rounded-lg overflow-hidden bg-black/80 border border-white/10 shrink-0">
              <img
                src="https://images.unsplash.com/photo-1527443224154-c4a3942d3acf?w=200&q=80"
                alt="LG UltraGear"
                class="w-full h-full object-cover"
              />
            </div>
          </div>

          <a
            href="https://www.google.com/search?q=LG+UltraGear+4K+OLED"
            target="_blank"
            rel="noopener noreferrer"
            class="w-full py-2 rounded-xl bg-white/[0.08] hover:bg-white/15 border border-white/15 text-white text-xs font-bold text-center block transition"
          >
            Learn More →
          </a>
        </div>

      </aside>

    </div>

  </main>

  <Footer />
</Layout>

<script>
  // Direct Download Trigger
  const downloadBtn = document.getElementById('main-download-4k-btn');
  if (downloadBtn) {
    downloadBtn.addEventListener('click', async () => {
      const url = downloadBtn.getAttribute('data-url');
      const filename = downloadBtn.getAttribute('data-filename') || 'wallpaper-4k.jpg';
      if (!url) return;

      downloadBtn.classList.add('opacity-80');
      try {
        const res = await fetch(url, { referrerPolicy: 'no-referrer' });
        const blob = await res.blob();
        const blobUrl = window.URL.createObjectURL(blob);
        const a = document.createElement('a');
        a.href = blobUrl;
        a.download = filename;
        document.body.appendChild(a);
        a.click();
        document.body.removeChild(a);
        window.URL.revokeObjectURL(blobUrl);
      } catch (err) {
        window.open(url, '_blank');
      } finally {
        downloadBtn.classList.remove('opacity-80');
      }
    });
  }

  // Other Resolutions selection
  const resCards = document.querySelectorAll('.res-card-btn');
  resCards.forEach((btn) => {
    btn.addEventListener('click', () => {
      resCards.forEach((b) => {
        b.className = 'res-card-btn p-2 rounded-[13px] bg-[rgba(14,18,22,0.80)] border border-white/18 hover:border-white/30 text-left flex flex-col justify-between h-[50px] transition';
        b.querySelector('span:last-child')?.classList.remove('text-[#C2FF00]');
        b.querySelector('span:last-child')?.classList.add('text-gray-400');
      });
      btn.className = 'res-card-btn active p-2 rounded-[13px] bg-[rgba(194,255,0,0.045)] border border-[#C2FF00] shadow-[0_0_10px_rgba(194,255,0,0.15)] text-left flex flex-col justify-between h-[50px] transition';
      btn.querySelector('span:last-child')?.classList.remove('text-gray-400');
      btn.querySelector('span:last-child')?.classList.add('text-[#C2FF00]');
    });
  });

  // Share Button
  const shareBtn = document.getElementById('share-btn');
  shareBtn?.addEventListener('click', () => {
    if (navigator.share) {
      navigator.share({ title: document.title, url: window.location.href });
    } else {
      navigator.clipboard.writeText(window.location.href);
      alert('Wallpaper link copied to clipboard!');
    }
  });
</script>
