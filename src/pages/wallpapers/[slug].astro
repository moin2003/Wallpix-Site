          const currentFilename = mobileDownloadBtn.getAttribute('data-filename') || 'wallpaper.jpg';
          const baseName = currentFilename.replace(/-[a-z0-9]+\.jpg$/, '');
          mobileDownloadBtn.setAttribute('data-filename', `${baseName}-${suffix}.jpg`);
        }
      }
      if (mobileDownloadTitle && name) {
        mobileDownloadTitle.textContent = `Download ${name}`;
      }
      if (mobileDownloadSub && sub) {
        mobileDownloadSub.textContent = sub;
      }
    });
  });

  // Mobile Hero Favorite Button
  const mobileFavBtn = document.getElementById('mobile-hero-fav-btn');
  if (mobileFavBtn) {
    let isMobileLiked = false;
    mobileFavBtn.addEventListener('click', () => {
      isMobileLiked = !isMobileLiked;
      const svg = mobileFavBtn.querySelector('svg');
      if (svg) {
        if (isMobileLiked) {
          svg.setAttribute('fill', '#FF77AA');
          svg.classList.add('text-[#FF77AA]');
          mobileFavBtn.classList.add('border-[#FF77AA]/50');
        } else {
          svg.setAttribute('fill', 'none');
          svg.classList.remove('text-[#FF77AA]');
          mobileFavBtn.classList.remove('border-[#FF77AA]/50');
        }
      }
    });
  }

  // Mobile Hero Share Button
  const mobileShareBtn = document.getElementById('mobile-hero-share-btn');
  if (mobileShareBtn) {
    mobileShareBtn.addEventListener('click', () => {
      if (navigator.share) {
        navigator.share({ title: document.title, url: window.location.href });
      } else {
        navigator.clipboard.writeText(window.location.href).then(() => {
          alert('Wallpaper link copied to clipboard!');
        });
      }
    });
  }

  // Mobile Copy Palette
  const mobileCopyPaletteBtn = document.getElementById('mobile-copy-palette-btn');
  const mobileCopyPaletteText = document.getElementById('mobile-copy-palette-text');
  const mobileColorDots = document.querySelectorAll('.mobile-color-dot');

  if (mobileCopyPaletteBtn && mobileCopyPaletteText) {
    mobileCopyPaletteBtn.addEventListener('click', () => {
      const hexList: string[] = [];
      mobileColorDots.forEach((dot) => {
        const hex = dot.getAttribute('data-hex');
        if (hex) hexList.push(hex);
      });
      const textToCopy = hexList.length > 0 ? hexList.join(', ') : '#FF0055, #8A2BE2, #00E5FF, #1A1A2E, #C2FF06';
      navigator.clipboard.writeText(textToCopy).then(() => {
        mobileCopyPaletteText.textContent = 'Copied!';
        setTimeout(() => {
          mobileCopyPaletteText.textContent = 'Copy Palette';
        }, 2000);
      });
    });
  }

  // Individual Mobile Color Dot Click
  mobileColorDots.forEach((dot) => {
    dot.addEventListener('click', () => {
      const hex = dot.getAttribute('data-hex');
      if (hex) {
        navigator.clipboard.writeText(hex);
        if (mobileCopyPaletteText) {
          mobileCopyPaletteText.textContent = `${hex} Copied!`;
          setTimeout(() => {
            mobileCopyPaletteText.textContent = 'Copy Palette';
          }, 1500);
        }
      }
    });
  });
</script>

