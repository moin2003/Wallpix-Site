        const originalFilename = downloadBtn.getAttribute('data-filename') || 'walpix-wallpaper.jpg';
        const baseName = originalFilename.replace(/-(4k|2k|1080p|iphone|samsung)\.jpg$/, '');
        downloadBtn.setAttribute('data-filename', `${baseName}-${suffix}.jpg`);

        if (btnTitle) btnTitle.textContent = `Download ${name}`;
        if (btnSub && sub) btnSub.textContent = sub;
        if (btnBadge && badge) btnBadge.textContent = badge;
        if (activeResLabel) activeResLabel.textContent = `${w} × ${h} (${name})`;
      }

      resMenu?.classList.add('hidden');
      resChevron?.classList.remove('rotate-180');
    });
  });

  // Client-Side Canvas Crop & Download Trigger
  if (downloadBtn) {
    downloadBtn.addEventListener('click', async () => {
      const url = downloadBtn.getAttribute('data-url');
      const filename = downloadBtn.getAttribute('data-filename') || 'walpix-wallpaper-4k.jpg';
      const targetW = parseInt(downloadBtn.getAttribute('data-width') || '3840');
      const targetH = parseInt(downloadBtn.getAttribute('data-height') || '2160');

      if (!url) return;

      const proxyUrl = `/api/download?url=${encodeURIComponent(url)}&filename=${encodeURIComponent(filename)}`;

      downloadBtn.classList.add('opacity-75');
