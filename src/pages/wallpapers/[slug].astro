            if (blob) {
              const blobUrl = URL.createObjectURL(blob);
              const a = document.createElement('a');
              a.href = blobUrl;
              a.download = filename;
              document.body.appendChild(a);
              a.click();
              document.body.removeChild(a);
              URL.revokeObjectURL(blobUrl);
            } else {
              const a = document.createElement('a');
              a.href = proxyUrl;
              a.download = filename;
              document.body.appendChild(a);
              a.click();
              document.body.removeChild(a);
            }
          }, 'image/jpeg', 0.95);
        } else {
          // Direct native proxy download fallback (never navigates away from walpix.site)
          const a = document.createElement('a');
          a.href = proxyUrl;
          a.download = filename;
          document.body.appendChild(a);
          a.click();
          document.body.removeChild(a);
        }
