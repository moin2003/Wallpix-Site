---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import GalleryFilterToolbar from '../../components/GalleryFilterToolbar.astro';
import TopicStrip from '../../components/TopicStrip.astro';
import OrientationToggle from '../../components/OrientationToggle.astro';
import CategoryFolderView from '../../components/CategoryFolderView.astro';
import GalleryGrid from '../../components/GalleryGrid.astro';
import Footer from '../../components/Footer.astro';
import { wallpapers } from '../../data/wallpapers';

const schema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'WALPIX 4K Wallpaper Discovery Gallery',
  url: 'https://walpix.site/wallpapers',
};

const lcpImage = wallpapers && wallpapers.length > 0 ? wallpapers[0].sourceCdn : undefined;
---

<Layout
  title="4K Wallpapers Discovery Gallery | WALPIX 4K"
  description="Browse 50,000+ 4K Ultra HD wallpapers in 16:9 widescreen format. Free instant download with zero watermarks."
  preloadImage={lcpImage}
  schema={schema}
>
  <!-- Floating Header with Wallpapers link active -->
  <Header currentCategory="wallpapers" />

  <main class="relative min-h-screen bg-[#020406] overflow-hidden">
    
    <!-- Subtle Ambient Green Glow Zones (Selective illumination across gallery) -->
    <div class="fixed inset-0 pointer-events-none z-0 overflow-hidden">
      <!-- Top Right Lime Glow -->
      <div class="absolute -top-32 right-10 w-[600px] h-[600px] bg-walpix-lime/[0.045] rounded-full blur-[140px]"></div>
      <!-- Mid Left Cyan/Lime Glow -->
      <div class="absolute top-1/3 -left-32 w-[650px] h-[650px] bg-walpix-lime/[0.035] rounded-full blur-[160px]"></div>
      <!-- Bottom Center Ambient Glow -->
      <div class="absolute bottom-20 right-1/4 w-[700px] h-[700px] bg-walpix-lime/[0.04] rounded-full blur-[180px]"></div>
      
      <!-- Subtle Matrix Dot Grid (Subtly visible, shining near ambient glow points) -->
      <div class="absolute inset-0 bg-matrix-dots opacity-40"></div>
    </div>

    <div class="relative z-10">
      <!-- Category Filter Toolbar (Zero Emojis + Vector SVGs + Fixed Z-50 Sort) -->
      <GalleryFilterToolbar activeCategory="all" />

      <!-- Horizontal Quick Topic Switcher Strip (Clean, Original Topic Strip) -->
      <div class="w-full px-4 sm:px-8 lg:px-12 py-2">
        <TopicStrip />
      </div>

      <!-- Aspect Ratio & Orientation Toggle (All Formats, Horizontal, Vertical, Dual Screen) -->
      <div id="gallery-orientation-wrapper">
        <OrientationToggle />
      </div>

      <!-- Category Sub-Folder & Franchise Card Grids (Appears when any Category is selected) -->
      <CategoryFolderView />

      <!-- 4-Column 16:9 Gallery Grid for All Wallpapers with Strategic In-Feed Ads -->
      <GalleryGrid wallpapers={wallpapers} />
    </div>
  </main>

  <Footer />
</Layout>

<style>
  /* Subtle Neon Dotted Matrix Pattern with Clean Linear Falloff */
  .bg-matrix-dots {
    background-image: radial-gradient(rgba(194, 255, 6, 0.22) 1px, transparent 1px);
    background-size: 28px 28px;
    mask-image: linear-gradient(to bottom, black 0%, black 85%, transparent 100%);
    -webkit-mask-image: linear-gradient(to bottom, black 0%, black 85%, transparent 100%);
  }
</style>
