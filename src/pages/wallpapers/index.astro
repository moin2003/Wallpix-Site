---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import GalleryFilterToolbar from '../../components/GalleryFilterToolbar.astro';
import TopicStrip from '../../components/TopicStrip.astro';
import OrientationToggle from '../../components/OrientationToggle.astro';
import GalleryGrid from '../../components/GalleryGrid.astro';
import Footer from '../../components/Footer.astro';
import { wallpapers, type Wallpaper } from '../../data/wallpapers';

// High-speed, payload-safe multi-format discovery dataset
// Ensures all formats (16:9 Desktop, 9:16 Mobile, 32:9 Dual Screen) and all 23 categories have rich coverage
// Keeps total HTML under 150 KB, preventing Vercel 413: CONTENT_TOO_LARGE error
function getDiverseWallpapers(items: Wallpaper[], maxTotal: number): Wallpaper[] {
  const byCategory: Record<string, Wallpaper[]> = {};
  for (const item of items) {
    const cat = item.category || 'other';
    if (!byCategory[cat]) byCategory[cat] = [];
    byCategory[cat].push(item);
  }
  const result: Wallpaper[] = [];
  const categories = Object.keys(byCategory);
  let index = 0;
  while (result.length < maxTotal) {
    let addedAny = false;
    for (const cat of categories) {
      if (byCategory[cat][index]) {
        result.push(byCategory[cat][index]);
        addedAny = true;
        if (result.length >= maxTotal) break;
      }
    }
    if (!addedAny) break;
    index++;
  }
  return result;
}

// Filter out low-effort generic single-word titles
function isQuality(w: Wallpaper): boolean {
  const t = (w.title || '').trim().toLowerCase();
  const banned = new Set(['anime', 'iphone', 'cool', 'onyx', 'car', 'nature', 'phone', 'goth', 'sand', 'gradient', 'island', 'logo']);
  if (banned.has(t)) return false;
  if (t.length < 3) return false;
  return true;
}

function scorePhone(w: Wallpaper): number {
  let s = (w.views || 0) * 0.1 + (w.downloads || 0) * 0.2;
  const res = w.resolution || '';
  if (res.includes('3840') || res.includes('4K') || res.includes('2160')) s += 50000;
  if (res.includes('2560') || res.includes('1440') || res.includes('2880') || res.includes('3120')) s += 25000;
  const t = (w.title || '').toLowerCase();
  if (/spider[-\s]?man|miles morales|peter parker|iron spider|spiderverse|spider-verse/i.test(t)) s += 40000;
  if (/naruto|sasuke|gojo|luffy|zoro|demon slayer|eren|titan|goku|jujutsu|tanjiro|tokyo ghoul|bleach|one punch/i.test(t)) s += 35000;
  if (/porsche|lamborghini|ferrari|mclaren|bugatti|supercar/i.test(t)) s += 30000;
  if (/amoled|pitch black|black diamond/i.test(t)) s += 25000;
  if (/nebula|galaxy|astronaut|cosmos|guardians of the galaxy/i.test(t)) s += 25000;
  return s;
}

const desktopPool = wallpapers.filter(w => w.aspectRatio === '16:9' && isQuality(w));
const desktopWallpapers = getDiverseWallpapers(desktopPool, 96);

const allMobilePool = wallpapers
  .filter(w => (w.aspectRatio === '9:16' || w.aspectRatio === 'vertical') && isQuality(w))
  .sort((a, b) => scorePhone(b) - scorePhone(a));
const mobileWallpapers = getDiverseWallpapers(allMobilePool, 96);

const dualWallpapers = wallpapers.filter(w => 
  (w.aspectRatio || '').includes('32:9') || 
  (w.screenTypes || []).includes('dual-monitor') ||
  (w.screenTypes || []).includes('ultrawide')
).slice(0, 36);

const urlFormat = (Astro.url.searchParams.get('format') || '').toLowerCase().trim();
const userAgent = Astro.request.headers.get('user-agent') || '';
const isMobileUA = /mobile|iphone|ipod|android|blackberry|opera mini|iemobile|wpdesktop/i.test(userAgent);

const isPhoneFormat = urlFormat === 'phone' || urlFormat === 'mobile' || (!urlFormat && isMobileUA);
const isDualFormat = urlFormat === 'dual';
const isDesktopFormat = urlFormat === 'desktop';

const discoveryWallpapers = isPhoneFormat
  ? [...mobileWallpapers, ...desktopWallpapers, ...dualWallpapers]
  : isDualFormat
  ? [...dualWallpapers, ...desktopWallpapers, ...mobileWallpapers]
  : [...desktopWallpapers, ...mobileWallpapers, ...dualWallpapers];

const initialGridMode: 'all' | 'desktop' | 'phone' | 'dual' = isPhoneFormat
  ? 'phone'
  : isDualFormat
  ? 'dual'
  : isDesktopFormat
  ? 'desktop'
  : 'all';

const schema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'WALPIX 4K Wallpaper Discovery Gallery',
  url: 'https://www.walpix.site/wallpapers',
};

const lcpImage = discoveryWallpapers && discoveryWallpapers.length > 0 ? discoveryWallpapers[0].sourceCdn : undefined;
---

<Layout
  title="4K Wallpapers Discovery Gallery | WALPIX 4K"
  description="Browse 50,000+ 4K Ultra HD wallpapers in 16:9 widescreen format. Free instant download with zero watermarks."
  preloadImage={lcpImage}
  schema={schema}
>
  <!-- Floating Header with Wallpapers link active -->
  <Header currentCategory="wallpapers" />

  <main class="relative min-h-screen bg-[#020406] overflow-hidden">
    
    <!-- Subtle Ambient Green Glow Zones (Selective illumination across gallery) -->
    <div class="fixed inset-0 pointer-events-none z-0 overflow-hidden">
      <!-- Top Right Lime Glow -->
      <div class="absolute -top-32 right-10 w-[600px] h-[600px] bg-walpix-lime/[0.045] rounded-full blur-[140px]"></div>
      <!-- Mid Left Cyan/Lime Glow -->
      <div class="absolute top-1/3 -left-32 w-[650px] h-[650px] bg-walpix-lime/[0.035] rounded-full blur-[160px]"></div>
      <!-- Bottom Center Ambient Glow -->
      <div class="absolute bottom-20 right-1/4 w-[700px] h-[700px] bg-walpix-lime/[0.04] rounded-full blur-[180px]"></div>
      
      <!-- Subtle Matrix Dot Grid (Subtly visible, shining near ambient glow points) -->
      <div class="absolute inset-0 bg-matrix-dots opacity-40"></div>
    </div>

    <div class="relative z-10">
      <!-- Category Filter Toolbar (Zero Emojis + Vector SVGs + Fixed Z-50 Sort) -->
      <GalleryFilterToolbar activeCategory="all" />

      <!-- Horizontal Quick Topic Switcher Strip (Clean, Original Topic Strip) -->
      <div class="w-full px-4 sm:px-8 lg:px-12 py-2">
        <TopicStrip />
      </div>

      <!-- Aspect Ratio & Orientation Toggle (All Formats, Horizontal, Vertical, Dual Screen) -->
      <div id="gallery-orientation-wrapper">
        <OrientationToggle activeFormat={initialGridMode} />
      </div>

      <!-- 4-Column 16:9 Gallery Grid for All Wallpapers with Strategic In-Feed Ads -->
      <GalleryGrid wallpapers={discoveryWallpapers} gridMode={initialGridMode} maxCards={96} />
    </div>
  </main>

  <Footer />
</Layout>

<style>
  /* Subtle Neon Dotted Matrix Pattern with Clean Linear Falloff */
  .bg-matrix-dots {
    background-image: radial-gradient(rgba(194, 255, 6, 0.22) 1px, transparent 1px);
    background-size: 28px 28px;
    mask-image: linear-gradient(to bottom, black 0%, black 85%, transparent 100%);
    -webkit-mask-image: linear-gradient(to bottom, black 0%, black 85%, transparent 100%);
  }
</style>
